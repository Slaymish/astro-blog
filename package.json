{
  "name": "hamish-blog",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "1.0.0",
  "description": "Hamish's personal blog built with Astro and Sanity",
  "scripts": {
    "dev": "astro dev --config astro.config.dev.ts",
    "start": "astro dev",
    "build": "astro check && astro build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "astro preview",
    "astro": "astro",
    "studio:dev": "npm --prefix studio-production run dev",
    "studio:build": "npm --prefix studio-production run build",
    "seed:copy": "tsx --env-file=.env scripts/seed-page-copy.ts",
    "seed:books": "tsx --env-file=.env scripts/seed-book-notes.ts",
    "convert:webp": "node scripts/convert-png-to-webp.js",
    "update:references": "node scripts/update-references.js",
    "convert:all": "npm run convert:webp && npm run update:references"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/react": "^6.0.5",
    "@netlify/blobs": "^10.7.9",
    "@netlify/functions": "^5.3.0",
    "@portabletext/to-html": "^5.0.1",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^2.0.3",
    "@tailwindcss/vite": "^4.0.1",
    "astro": "^7.3.1",
    "fontaine": "^0.8.0",
    "github-slugger": "^2.0.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanity": "^5.6.0",
    "sharp": "^0.32.6",
    "typescript": "^5.6.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "knip": "^6.0.2",
    "tailwindcss": "^4.0.1",
    "tsx": "^4.20.3",
    "vite": "^8.2.2"
  }
}
