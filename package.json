{
  "name": "hamishburke-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.12",
      "dompurify": "^3.4.17",
      "adm-zip": "^0.6.1",
      "js-yaml@^3": "^3.15.2",
      "smol-toml": "^1.7.1",
      "source-map-js": "^1.2.2",
      "undici": "^7.30.1"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && tsx scripts/build-markdown.ts",
    "preview": "tsx scripts/serve-dist.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "astro check && pnpm exec knip",
    "studio:dev": "pnpm --filter hamishburke-studio dev",
    "studio:build": "pnpm --filter hamishburke-studio build",
    "studio:deploy": "pnpm --filter hamishburke-studio deploy",
    "icons": "tsx scripts/generate-icons.mjs",
    "migrate": "tsx --env-file=.env scripts/migrate-2026-09.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@astrojs/netlify": "^8.2.10",
    "@netlify/blobs": "^10.7.13",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.4.4",
    "pdfjs-dist": "^6.5.438",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@netlify/edge-functions": "^4.0.3",
    "@netlify/functions": "^6.0.3",
    "knip": "^6.44.1",
    "node-html-parser": "^7.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "sanity": "^6.21.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
