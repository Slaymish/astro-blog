# Public. Validated at config load, so a missing value fails before Astro starts.
SANITY_PROJECT_ID=qnuj1c4o
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# Only for `pnpm run migrate`. Needs write access to the dataset; mint one in
# Sanity Manage under API > Tokens. Not needed to build or run the site.
# SANITY_API_TOKEN=

# Set in Netlify, not here. Listed so it is obvious what the site reads.
# INSIGHTS_TOKEN=
# CAL_WEBHOOK_SECRET=
# RATE_LIMIT_SALT=
# ANTHROPIC_API_KEY=
