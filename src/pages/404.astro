---
import Layout from '../components/layout/Layout.astro';
import { getNotFoundPage } from '../lib/pageContent';

const copy = await getNotFoundPage();
---

<Layout title={copy.seo.title} description={copy.seo.description}>
  <div class="min-h-[50vh] flex flex-col items-center justify-center text-center px-4">
    <h1 class="font-serif text-[8rem] sm:text-[10rem] font-bold leading-none text-[var(--accent)] mb-2 tracking-tight">
      {copy.code}
    </h1>

    <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-4 text-[var(--text)] tracking-tight">
      {copy.heading}
    </h2>

    <p class="text-lg mb-8 max-w-md text-[var(--text-muted)] leading-relaxed">
      {copy.body}
    </p>

    <div class="flex flex-col sm:flex-row gap-3">
      <a
        href="/"
        class="cta-primary inline-flex items-center justify-center gap-2 px-6 py-3 text-[var(--accent)] border border-[var(--accent)] rounded-[var(--radius-md)] no-underline font-medium transition-colors"
      >
        {copy.homeLabel}
      </a>
      <button
        type="button"
        id="go-back-button"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 text-[var(--text)] border border-[var(--border)] rounded-[var(--radius-md)] font-medium transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] bg-transparent cursor-pointer"
      >
        {copy.backLabel}
      </button>
    </div>

    <div class="mt-16 pt-8 border-t border-[var(--border)] w-full max-w-md">
      <p class="text-sm font-medium text-[var(--text-muted)] mb-4">{copy.suggestionsLabel}</p>
      <div class="flex flex-wrap justify-center gap-4 text-sm">
        {copy.suggestions.map((link) => (
          <a href={link.href} class="text-[var(--text-muted)] no-underline border-b-0 hover:text-[var(--accent)] transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  function initGoBack() {
    const goBackButton = document.getElementById('go-back-button');
    goBackButton?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
        return;
      }
      window.location.href = '/';
    });
  }

  initGoBack();
</script>
