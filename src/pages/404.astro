---
import Layout from '../components/layout/Layout.astro';
import IconText from '../components/ui/IconText.astro';
import { getNotFoundPage } from '../lib/pageContent';

const copy = await getNotFoundPage();
---

<Layout title={copy.seo.title} description={copy.seo.description}>
  <div class="not-found">
    <p class="not-found__code">{copy.code}</p>
    <h1>{copy.heading}</h1>
    <p class="not-found__body">{copy.body}</p>

    <div class="not-found__actions">
      <a href="/"><IconText>{copy.homeLabel}</IconText></a>
      <button type="button" id="go-back-button">
        <IconText icon="arrow-left" position="start">{copy.backLabel}</IconText>
      </button>
    </div>

    <div class="not-found__suggestions">
      <p>{copy.suggestionsLabel}</p>
      <nav aria-label="Suggested pages">
        {copy.suggestions.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </div>
</Layout>

<script>
  function initGoBack() {
    const goBackButton = document.getElementById('go-back-button');
    goBackButton?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
        return;
      }
      window.location.href = '/';
    });
  }

  initGoBack();
  document.addEventListener('astro:page-load', initGoBack);
</script>

<style>
  .not-found { padding-block: var(--hero-top-space) var(--section-space); }
  .not-found__code { color: var(--color-action); font-family: var(--font-mono); font-size: var(--type-label); letter-spacing: .1em; margin: 0 0 var(--spacing-5); }
  .not-found h1 { font-size: var(--type-display); letter-spacing: var(--tracking-display); line-height: .88; margin: 0; max-width: 12ch; }
  .not-found__body { color: var(--color-text-secondary); font-size: clamp(1.1rem, 2vw, 1.45rem); line-height: 1.5; margin: var(--spacing-8) 0 0; max-width: 36rem; }

  .not-found__actions { display: flex; flex-wrap: wrap; gap: var(--spacing-4) var(--spacing-6); margin-top: var(--spacing-10); }
  .not-found__actions a,
  .not-found__actions button { align-items: center; background: none; border: 0; color: var(--color-text-primary); cursor: pointer; display: inline-flex; font: inherit; font-size: var(--type-body-small); font-weight: 700; min-height: 2.75rem; padding: 0; }
  .not-found__actions a:hover,
  .not-found__actions button:hover { color: var(--color-action); }

  .not-found__suggestions { border-top: 1px solid var(--color-stroke-subtle); margin-top: clamp(3rem, 8vw, 6rem); padding-top: var(--spacing-6); }
  .not-found__suggestions p { color: var(--color-action); font-size: var(--type-label); font-weight: 700; letter-spacing: .1em; margin: 0 0 var(--spacing-4); text-transform: uppercase; }
  .not-found__suggestions nav { display: flex; flex-wrap: wrap; gap: var(--spacing-3) var(--spacing-6); }
  .not-found__suggestions nav a { align-items: center; color: var(--color-text-secondary); display: inline-flex; font-size: var(--type-body-small); min-height: 2.75rem; }
  .not-found__suggestions nav a:hover { color: var(--color-action); }
</style>
