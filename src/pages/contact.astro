---
import { NEW_TAB_NOTE_ID } from '../site/config';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { getContactPage, getSiteSettings } from '../content/queries';

const [copy, { contactBand }] = await Promise.all([getContactPage(), getSiteSettings()]);
const { hero } = copy;
---

<Base
  pageType="ContactPage"
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: 'Contact', path: '/contact' }]}
>
  <PageHeader
    headline={hero.headlineLines}
    intro={hero.intro}
    measure="narrow"
  />

  <section class="contact__channels">
    <ul>
      {copy.channels.map((channel) => (
        <li>
          <a
            href={channel.link.href}
            target={channel.link.external ? '_blank' : undefined}
            aria-describedby={channel.link.external ? NEW_TAB_NOTE_ID : undefined}
            rel={channel.link.external ? 'noopener noreferrer' : undefined}
            aria-label={channel.link.ariaLabel}
          >
            <span class="contact__label">{channel.label}</span>
            <span class="contact__value">
              {channel.link.label}
              <Icon name={channel.link.external ? 'arrow-up-right' : 'arrow-right'} />
            </span>
            <span class="contact__note">{channel.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <p class="contact__availability">{copy.availabilityNote}</p>
  {contactBand.form && <div class="contact__form"><ContactForm copy={contactBand.form} /></div>}
</Base>

<style>
  .contact__channels ul { border-top: 1px solid var(--color-stroke-subtle); list-style: none; margin: 0; padding: 0; }
  .contact__channels li { border-bottom: 1px solid var(--color-stroke-subtle); }
  .contact__channels a { align-items: baseline; color: var(--color-text-primary); display: grid; gap: var(--spacing-2) var(--spacing-8); padding-block: clamp(1.5rem, 3.5vw, 2.25rem); text-decoration: none; }
  .contact__channels a:hover .contact__value { color: var(--color-action); }
  .contact__label { color: var(--color-text-secondary); font-family: var(--font-body); font-size: var(--type-label); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  .contact__value { align-items: baseline; display: inline-flex; font-size: var(--type-heading-3); gap: var(--icon-gap); letter-spacing: var(--tracking-heading); text-decoration: underline; text-underline-offset: .18em; }
  .contact__note { color: var(--color-text-secondary); font-size: var(--type-body-small); line-height: 1.6; max-width: 44rem; }

  .contact__form { margin-block: var(--spacing-8); max-width: 32rem; }

  .contact__availability { color: var(--color-text-secondary); font-size: var(--type-body); line-height: 1.7; margin: clamp(3rem, 8vw, 6rem) 0 0; max-width: 44rem; }

  @media (min-width: 48rem) {
    .contact__channels a { grid-template-columns: 9rem minmax(0, 1fr); }
    .contact__label { grid-row: span 2; }
  }
</style>
