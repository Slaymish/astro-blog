---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorkCard from '../../components/WorkCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getWorkIndexPage, getWorkStories } from '../../content/queries';

const [copy, allStories] = await Promise.all([getWorkIndexPage(), getWorkStories()]);
const stories = [...allStories].sort((a, b) => b.date.localeCompare(a.date));
const { hero } = copy;
---

<Base
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: 'Work', path: '/work' }]}
>
  <PageHeader eyebrow={hero.eyebrow} headline={hero.headlineLines} intro={hero.intro} />
  <section aria-label="All work, newest first">
    {stories.map((story) => <WorkCard story={story} />)}
  </section>
  <ContactBand booking />
</Base>
