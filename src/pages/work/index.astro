---
import Layout from '../../components/layout/Layout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import WorkCard from '../../components/work/WorkCard.astro';
import { getWorkStories } from '../../lib/workData';
const stories = (await getWorkStories()).sort((a, b) => b.date.localeCompare(a.date));
---
<Layout title="Work" description="Client websites, independent software, and research by Hamish Burke.">
  <PageHeader eyebrow="Work" headline="Things I’ve made." intro="Client websites, independent software, and research. Each started with a different question; these are the decisions and results along the way." />
  <section aria-label="All work, newest first">
    {stories.map(story => <WorkCard story={story} />)}
  </section>
</Layout>
