---
import Base from '../../layouts/Base.astro';
import FeedIndex from '../../components/FeedIndex.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getFeed, getFeedIndexCopy } from '../../content/feed';

const [copy, entries] = await Promise.all([getFeedIndexCopy(), getFeed()]);
---

<Base
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: copy.navigationLabel, path: '/work' }]}
>
  <FeedIndex entries={entries} copy={copy} />
  <ContactBand booking />
</Base>
