---
import { feedMetadataEntries } from '../../content/metadata';
import Base from '../../layouts/Base.astro';
import FeedIndex from '../../components/FeedIndex.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getFeed, getFeedIndexCopy, resolveFeatured } from '../../content/feed';
import { getWorkIndexPage, getWorkStories } from '../../content/queries';

const [copy, entries, workIndex, stories] = await Promise.all([
  getFeedIndexCopy(),
  getFeed(),
  getWorkIndexPage(),
  getWorkStories(),
]);

const featured = resolveFeatured(stories, workIndex.featured);
---

<Base pageType="CollectionPage"
  collections={[{ id: 'entries', name: copy.navigationLabel, entries: feedMetadataEntries(entries) }]}
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: copy.navigationLabel, path: '/work' }]}
>
  <FeedIndex entries={entries} copy={copy} featured={featured} featuredLabel={workIndex.featuredLabel} />
  <ContactBand booking />
</Base>
