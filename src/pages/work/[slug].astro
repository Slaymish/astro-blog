---
import Layout from '../../components/layout/Layout.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import { introduction } from '../../lib/workEditorial';
import { portableTextToHtml } from '../../lib/portableText';
import IconText from '../../components/ui/IconText.astro';
import MediaFrame from '../../components/ui/MediaFrame.astro';
import ContactBand from '../../components/work/ContactBand.astro';
import WorkGraphic from '../../components/work/WorkGraphic.astro';
import { SITE_URL, absoluteUrl } from '../../lib/site';
import { artifactHref, type WorkArtifact } from '../../lib/work';
import { getWorkStories, getWorkStory } from '../../lib/workData';

export async function getStaticPaths() {
  const stories = await getWorkStories();
  return stories.map((story) => ({ params: { slug: story.slug } }));
}

const slug = Astro.params.slug as string;
const story = await getWorkStory(slug);

if (!story) {
  return new Response('Work story not found', { status: 404 });
}

const artifacts = [story.primaryArtifact, ...story.supportingArtifacts].filter((artifact): artifact is WorkArtifact => Boolean(artifact));
const links = artifacts.flatMap(artifact => {
  const destinations = [];
  if (artifact.liveUrl) destinations.push({ href: artifact.liveUrl, label: story.slug === 'you-inc' ? 'Try demo' : 'Visit site' });
  if (artifact.githubUrl) destinations.push({ href: artifact.githubUrl, label: 'Source code' });
  if (artifact.type !== 'project') destinations.push({ href: artifactHref(artifact), label: artifact.title });
  return destinations;
});
const youIncSections = [
  ['A ledger before a dashboard', 'I wanted a coherent view of what I own, owe, earn and spend. That needed a real accounting model underneath. Synced transactions enter a double-entry ledger where every posting must balance; cashflow, net worth and runway are different views of the same data.'],
  ['Make uncertainty visible', 'Rules route known transactions. Anything uncertain stays in suspense for review instead of quietly disappearing or being treated as a confident classification. Akahu bank sync feeds the ledger, with credentials encrypted in Supabase Vault and kept out of the browser.'],
  ['Taking the SaaS layer out', 'The first version had accounts, paid plans and billing. But holding other people’s bank credentials brought an obligation that went well beyond building a useful finance tool. I removed the commercial layer and made You Inc self-hosted and MIT licensed. The person running it supplies their own database and Akahu credentials.'],
  ['What I would build first next time', story.differently || 'I would settle the ledger schema before building the dashboard.']
];
const narrativeHtml = portableTextToHtml(story.narrative?.length ? story.narrative : story.body);
---

<Layout
  title={`${story.title} · ${story.descriptor}`}
  description={introduction(story)}
  canonicalURL={absoluteUrl(`/work/${story.slug}`, SITE_URL)}
  article
  publishedTime={`${story.date}T00:00:00.000Z`}
>
  <article class="case-study">
    <header class="case-study__hero">
      <p class="case-study__eyebrow">{story.descriptor} · {story.timeframe ?? new Date(story.date).getFullYear()}</p>
      <h1>{story.title}</h1>
      <p class="case-study__summary">{introduction(story)}</p>
      <div class="case-study__links">
        {links.map((link, index) => <ButtonLink href={link.href} external={link.href.startsWith('http')} variant={index === 0 ? 'primary' : 'secondary'}>{link.label}</ButtonLink>)}
      </div>
      <p class="case-study__role">{story.role}</p>
    </header>

    <div class="case-study__graphic">
      <WorkGraphic kind={story.graphic.kind} alt={story.graphic.alt} priority />
      {story.graphic.kind === 'you-inc' && (
        <p class="case-study__graphic-caption">
          Working YouInc demo dashboard, shown with sample financial data. No user financial data is exposed.
        </p>
      )}
    </div>

    <div class="case-narrative">
      {story.slug === 'you-inc' && !story.narrative?.length ? youIncSections.map(([heading, body], index) => <section>
        <h2>{heading}</h2><p>{body}</p>
        {index === 1 && <div class="ledger-note"><span>Bank transaction</span><b aria-hidden="true">→</b><span>Rule or suspense review</span><b aria-hidden="true">→</b><span>Balanced ledger</span></div>}
      </section>) : narrativeHtml ? <div set:html={narrativeHtml} /> : <section><h2>Starting point</h2><p>{story.problem}</p><h2>Decisions along the way</h2><ul>{story.interventions.map(item => <li>{item}</li>)}</ul></section>}
      <section class="case-outcome"><h2>{story.slug === 'you-inc' ? 'Where it stands' : 'Outcome'}</h2><p>{story.result}</p></section>
    </div>

    {story.graphic.kind === 'sprint-coach' && (
      <section class="case-study__evidence" aria-labelledby="enquiry-flow-heading">
        <div class="case-study__evidence-heading">
          <p class="case-study__section-label">Enquiry flow</p>
          <h2 id="enquiry-flow-heading">The one moving part on a static site</h2>
        </div>
        <MediaFrame
          src="/images/work/sprint-coach-contact.webp"
          alt="The Sprint Coach enquiry form, with name, email, enquiry type, and message fields beside the coach’s contact details."
          width={2400}
          height={1250}
          caption="Every page is prerendered. The enquiry form is the only route that reaches a server, sending notification and confirmation email over authenticated SMTP."
          ratio="natural"
        />
      </section>
    )}

    {story.graphic.kind === 'brontehf' && (
      <section class="case-study__evidence" aria-labelledby="publishing-workflow-heading">
        <div class="case-study__evidence-heading">
          <p class="case-study__section-label">Publishing workflow</p>
          <h2 id="publishing-workflow-heading">Edit and preview in one place</h2>
        </div>
        <MediaFrame
          src="/images/work/bronte-cms.webp"
          alt="The BrontëHF project editor beside a live preview of the Tei project page."
          width={2541}
          height={1231}
          caption="Project content can be edited while checking the published result in the same workspace."
          ratio="natural"
        />
      </section>
    )}

    <a class="case-study__back" href="/work"><IconText icon="arrow-left" position="start">All work</IconText></a>
  </article>

  {story.kind === 'professional' && <ContactBand heading="Have a website in mind?" booking />}
</Layout>

<style>
  .case-study__hero { padding-block: var(--hero-top-space) var(--hero-bottom-space); }
  .case-study__eyebrow,
  .case-study__section-label { color: var(--color-action); font-size: var(--type-label); font-weight: 700; letter-spacing: .1em; margin: 0 0 var(--spacing-5); text-transform: uppercase; }
  .case-study__hero h1 { font-size: var(--type-display); letter-spacing: var(--tracking-display); line-height: 1.05; margin: 0; max-width: 16ch; }
  .case-study__summary { color: var(--color-text-secondary); font-size: clamp(1.2rem, 2.5vw, 1.7rem); line-height: 1.4; margin: var(--spacing-8) 0 0; max-width: 34rem; }
  .case-study__links { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin-top: var(--spacing-8); }
  .case-study__graphic :global(.work-graphic) { margin-inline: auto; max-width: 54rem; }
  .case-study__graphic :global(.work-graphic--brontehf) { aspect-ratio: 2550 / 1231; max-height: none; }
  .case-study__graphic :global(.work-graphic--sprint-coach) { aspect-ratio: 2400 / 1250; max-height: none; }
  .case-study__graphic-caption { color: var(--color-text-secondary); font-size: var(--type-body-small); margin: var(--spacing-3) auto 0; max-width: 54rem; }
  .case-study__role { color: var(--color-text-secondary); font-size: .875rem; max-width: 65ch; margin-top: 1.5rem; }
  .case-narrative { max-width: 66ch; margin: 4rem auto; font-size: 1.125rem; line-height: 1.75; }
  .case-narrative :global(h2) { font-size: clamp(1.65rem, 3vw, 2.1rem); line-height: 1.2; letter-spacing: -.025em; margin: 3rem 0 1rem; }
  .case-narrative :global(p) { color: var(--color-text-secondary); }
  .case-outcome { border-top: 1px solid var(--color-stroke-subtle); margin-top: 3rem; }
  .ledger-note { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; border-block: 1px solid var(--color-stroke-subtle); padding: 1.5rem 0; font-size: .875rem; } .ledger-note b { color: var(--color-action); }
  .case-study__evidence { margin-block: 4rem; } .case-study__evidence h2 { font-size: 2rem; margin: 0 0 1.5rem; }
  .case-study__back { display: inline-block; margin-block: 2rem; color: var(--color-action); }
</style>
