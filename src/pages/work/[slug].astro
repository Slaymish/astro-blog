---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ContactBand from '../../components/ContactBand.astro';
import Evidence from '../../components/Evidence.astro';
import IconText from '../../components/IconText.astro';
import RelatedList from '../../components/RelatedList.astro';
import WorkCover from '../../components/WorkCover.astro';
import { portableTextToHtml } from '../../content/portableText';
import { getWorkStories } from '../../content/queries';
import { getRelated } from '../../content/related';
import { sanitySrcSet } from '../../content/images';
import { artifactHref } from '../../content/work';
import type { WorkStory } from '../../content/types';

export async function getStaticPaths() {
  const stories = await getWorkStories();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

interface Props {
  story: WorkStory;
}

const { story } = Astro.props;

const narrative = portableTextToHtml(story.body);
const related = await getRelated({ type: 'workStory', slug: story.slug, related: story.related });
const eyebrow = [story.descriptor, story.timeframe ?? new Date(story.date).getFullYear()].join(' · ');
const coverImage =
  story.cover.kind === 'image' ? sanitySrcSet(story.cover.image, [1200]).src : undefined;
---

<Base
  title={`${story.title} · ${story.descriptor}`}
  description={story.introduction}
  image={coverImage}
  article={{ kind: 'work', publishedAt: `${story.date}T00:00:00.000Z` }}
  breadcrumbs={[
    { name: 'Work', path: '/work' },
    { name: story.title, path: `/work/${story.slug}` },
  ]}
>
  <article class="case-study">
    <header class="case-study__hero">
      <p class="case-study__eyebrow">{eyebrow}</p>
      <h1>{story.title}</h1>
      <p class="case-study__summary">{story.introduction}</p>
      {
        story.links.length > 0 && (
          <div class="case-study__links">
            {story.links.map((link, index) => (
              <Button
                href={link.href}
                external={link.external}
                variant={index === 0 ? 'primary' : 'secondary'}
              >
                {link.label}
              </Button>
            ))}
          </div>
        )
      }
      <p class="case-study__role">{story.role}</p>
    </header>

    <div class="case-study__cover">
      <WorkCover cover={story.cover} priority />
    </div>

    <div class="case-narrative">
      <Fragment set:html={narrative} />
      <section class="case-outcome">
        <h2>{story.resultHeading ?? 'Outcome'}</h2>
        <p>{story.result}</p>
      </section>
    </div>

    {story.evidence.map((item) => <Evidence item={item} />)}

    {
      story.artifacts.length > 0 && (
        <section class="case-artifacts" aria-labelledby="artifacts-heading">
          <h2 id="artifacts-heading">From this project</h2>
          <ul>
            {story.artifacts.map((artifact) => (
              <li>
                <a href={artifactHref(artifact._type, artifact.slug)}>{artifact.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedList entries={related} />

    <a class="case-study__back" href="/work">
      <IconText icon="arrow-left" position="start">All work</IconText>
    </a>
  </article>

  {story.kind === 'professional' && <ContactBand heading="Have a website in mind?" booking />}
</Base>

<style>
  .case-study__hero {
    padding-block: var(--hero-top-space) var(--hero-bottom-space);
  }

  .case-study__eyebrow {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0 0 var(--spacing-5);
    text-transform: uppercase;
  }

  .case-study__hero h1 {
    font-size: var(--type-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    margin: 0;
    max-width: 16ch;
  }

  .case-study__summary {
    color: var(--color-text-secondary);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    line-height: 1.4;
    margin: var(--spacing-8) 0 0;
    max-width: 34rem;
  }

  .case-study__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    margin-top: var(--spacing-8);
  }

  .case-study__role {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-6);
    max-width: 65ch;
  }

  .case-study__cover {
    margin-inline: auto;
    max-width: 54rem;
  }

  .case-narrative {
    font-size: 1.125rem;
    line-height: 1.75;
    margin: var(--spacing-16) auto;
    max-width: 66ch;
  }

  .case-narrative :global(h2) {
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    margin: var(--spacing-12) 0 var(--spacing-4);
  }

  .case-narrative :global(p) {
    color: var(--color-text-secondary);
  }

  .case-outcome {
    border-top: 1px solid var(--color-stroke-subtle);
    margin-top: var(--spacing-12);
  }

  .case-artifacts {
    border-top: 1px solid var(--color-stroke-subtle);
    margin-top: var(--section-space);
    padding-top: var(--spacing-8);
  }

  .case-artifacts h2 {
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0 0 var(--spacing-5);
    text-transform: uppercase;
  }

  .case-artifacts ul {
    display: grid;
    gap: var(--spacing-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .case-artifacts a {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: var(--tracking-heading);
    text-decoration: none;
  }

  .case-study__back {
    --icon-gap: var(--spacing-2);
    color: var(--color-action);
    display: inline-block;
    margin-block: var(--spacing-8);
    text-decoration: none;
  }
</style>
