---
import Base from '../../layouts/Base.astro';
import CodexUsageCalculator from '../../components/CodexUsageCalculator.astro';
import CodexReportPreview from '../../components/CodexReportPreview.astro';
import { getCodexUsagePage, getWorkIndexPage, getSiteSettings } from '../../content/queries';
const [copy, work, settings] = await Promise.all([getCodexUsagePage(), getWorkIndexPage(), getSiteSettings()]);
const title = copy?.page.title ?? work.seo.title;
const description = copy?.page.description ?? work.seo.description;
---
<Base title={title} description={description} robots={copy ? undefined : 'noindex, follow'}>
  <main class="codex-page">
    <a href="/work">{copy?.page.back ?? settings.workCtaLabel}</a>
    {!copy && <header><h1>{work.hero.headlineLines.join(' ')}</h1><p>{work.hero.intro}</p></header>}
    {copy && <>
      <header><h1>{copy.page.title}</h1><p>{copy.page.intro}</p></header>
      <CodexUsageCalculator copy={copy.calculator} />
      <section class="codex-page__contribute">
        <h2>{copy.page.contributeHeading}</h2>
        <p>{copy.page.contributeIntro}</p>
        <CodexReportPreview copy={copy} />
        <div class="codex-page__people" data-contributors>
          <h3>{copy.page.peopleHeading}</h3>
          <p data-contributors-empty>{copy.page.peopleEmpty}</p>
          <ul class="codex-page__profiles" data-contributors-list></ul>
        </div>
        <p><a href="https://github.com/Slaymish/codex-usage-benchmark">{copy.page.source}</a></p>
      </section>
    </>}
  </main>
</Base>
<style>
  .codex-page { padding-block: var(--hero-top-space) var(--section-space); }
  .codex-page > a { color: var(--color-action); }
  .codex-page header { max-width: 42rem; margin-top: var(--spacing-8); }
  .codex-page h1 { font-size: var(--type-display); letter-spacing: var(--tracking-display); line-height: 1.05; }
  .codex-page header p { color: var(--color-text-secondary); font-size: var(--type-lead); }
  .codex-page__contribute { max-width: 46rem; margin-block: var(--spacing-12); }
  .codex-page__contribute p { color: var(--color-text-secondary); }
  .codex-page__people { margin-block: var(--spacing-10); }
  .codex-page__profiles { display: flex; flex-wrap: wrap; gap: var(--spacing-4); list-style: none; padding: 0; }
  .codex-page__profiles :global(a) { display: inline-flex; align-items: center; gap: var(--spacing-3); overflow-wrap: anywhere; }
  .codex-page__profiles :global(img) { border-radius: 50%; }
</style>
