---
import Base from '../../layouts/Base.astro';
import CodexUsageCalculator from '../../components/CodexUsageCalculator.astro';
import CodexReportPreview from '../../components/CodexReportPreview.astro';
---
<Base title="Codex usage optimiser" description="Estimate the cheapest Codex subscription combination for continuous coding, in New Zealand dollars." breadcrumbs={[{ name: 'Work', path: '/work' }, { name: 'Codex usage optimiser', path: '/work/codex-usage' }]}>
  <main class="codex-page">
    <a href="/work">← Work</a>
    <header>
      <h1>Codex usage optimiser</h1>
      <p>How much would it cost to keep Codex coding? Explore subscription combinations and extra credits in New Zealand dollars.</p>
    </header>
    <CodexUsageCalculator />
    <section class="codex-page__contribute">
      <h2>Help improve the estimates</h2>
      <p>Generate a usage report, check what it contains, then decide whether to share it. Nothing leaves your device here.</p>
      <CodexReportPreview />
      <div class="codex-page__people">
        <h3>People behind the project</h3>
        <a class="codex-page__person" href="https://github.com/Slaymish" rel="noopener noreferrer">
          <img src="https://github.com/Slaymish.png?size=96" width="48" height="48" alt="Slaymish's GitHub profile picture" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
          <span><strong>Slaymish</strong><small>Project maintainer</small></span>
        </a>
        <p>Contributor profiles will appear here only when people explicitly opt in. No usage reports have been published yet.</p>
      </div>
      <p><a href="https://github.com/Slaymish/codex-usage-benchmark">Source code and methodology on GitHub</a></p>
    </section>
  </main>
</Base>
<style>
  .codex-page { padding-block: var(--hero-top-space) var(--section-space); }
  .codex-page > a { color: var(--color-action); }
  .codex-page header { max-width: 42rem; margin-top: var(--spacing-8); }
  .codex-page h1 { font-size: var(--type-display); letter-spacing: var(--tracking-display); line-height: 1.05; }
  .codex-page header p { color: var(--color-text-secondary); font-size: var(--type-lead); }
  .codex-page__contribute { max-width: 46rem; margin-block: var(--spacing-12); }
  .codex-page__contribute p { color: var(--color-text-secondary); }
  .codex-page__people { margin-block: var(--spacing-10); }
  .codex-page__person { display: inline-flex; align-items: center; gap: var(--spacing-3); color: inherit; text-decoration: none; }
  .codex-page__person img { border-radius: 50%; }
  .codex-page__person span { display: grid; }
  .codex-page__person small { color: var(--color-text-secondary); }
  .codex-page__people > p { font-size: var(--type-body-small); }
</style>
