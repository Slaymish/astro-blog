---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import SanityImage from '../../components/SanityImage.astro';
import { getBooks, getReadingPage } from '../../content/queries';
import { MAX_RECOMMENDATION_LENGTH } from '../../server/recommendations';
import type { Book } from '../../content/types';

const [books, copy] = await Promise.all([getBooks(), getReadingPage()]);

/** One rendered card: a single book, or several that share a note. */
interface ReadingCard {
  books: Book[];
  note?: string;
}

/**
 * Books that share a `sharedNote` key (within one status) collapse into one
 * card, covers and titles stacked, with the first book's note beneath them.
 */
const toCards = (items: Book[]): ReadingCard[] => {
  const cards: ReadingCard[] = [];
  const shared = new Map<string, ReadingCard>();
  for (const item of items) {
    const key = item.sharedNote?.trim();
    if (!key) {
      cards.push({ books: [item], note: item.note });
      continue;
    }
    const existing = shared.get(key);
    if (existing) {
      existing.books.push(item);
      existing.note ||= item.note;
    } else {
      const card: ReadingCard = { books: [item], note: item.note };
      shared.set(key, card);
      cards.push(card);
    }
  }
  return cards;
};

const ordered = [...books].sort(
  (a, b) => (a.order ?? 1000) - (b.order ?? 1000) || a.title.localeCompare(b.title),
);

/** Currently reading first, then the queue, then the archive. */
const groups = [
  { status: 'reading' as const, heading: copy.groups.reading },
  { status: 'to-read' as const, heading: copy.groups.toRead },
  { status: 'read' as const, heading: copy.groups.read },
];

const grouped = groups
  .map((group) => ({
    ...group,
    cards: toCards(ordered.filter((item) => item.status === group.status)),
  }))
  .filter((group) => group.cards.length > 0);
---

<Base
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: 'Reading', path: '/reading' }]}
>
  <PageHeader headline={copy.headline} measure="narrow">
    <blockquote class="reading__quote">
      <p>{copy.quote.text}</p>
      <footer>{copy.quote.attribution}</footer>
    </blockquote>
  </PageHeader>

  {
    grouped.map((group) => (
      <section
        class="reading__group"
        aria-labelledby={`reading-${group.status}`}
        data-count={Math.min(group.cards.length, 2)}
      >
        <h2 id={`reading-${group.status}`}>{group.heading}</h2>
        <ul>
          {group.cards.map((card) => (
            <li class="reading__item">
              <div class="reading__covers">
                {card.books.map((item) =>
                  item.coverImage ? (
                    <SanityImage
                      image={item.coverImage}
                      alt={`Cover of ${item.title}`}
                      widths={[144, 288]}
                      sizes="4.5rem"
                      aspect={2 / 3}
                    />
                  ) : (
                    <div class="reading__cover-placeholder" aria-hidden="true" />
                  ),
                )}
              </div>
              <div class="reading__text">
                {card.books.map((item) => (
                  <div class="reading__book">
                    <h3>
                      {item.link ? (
                        <a href={item.link} target="_blank" rel="noopener noreferrer">
                          {item.title}
                          <Icon name="arrow-up-right" class="icon--sm" />
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                    <p>{item.author}</p>
                  </div>
                ))}
                {card.note && <p class="reading__note">{card.note}</p>}
              </div>
            </li>
          ))}
        </ul>

        {
          group.status === 'to-read' && (
            <form class="recommend" id="recommend" method="post" action="/api/recommend" data-state="idle">
              <p class="recommend__lead">{copy.recommend.lead}</p>
              <div class="recommend__row">
                <label class="sr-only" for="recommend-title">Book title</label>
                <input
                  id="recommend-title"
                  class="input"
                  name="title"
                  type="text"
                  autocomplete="off"
                  required
                  maxlength={MAX_RECOMMENDATION_LENGTH}
                  placeholder={copy.recommend.placeholder}
                  aria-describedby="recommend-status"
                />
                <Button type="submit" id="recommend-submit">{copy.recommend.button}</Button>
              </div>
              <p class="field__message recommend__status" id="recommend-status" role="status" aria-live="polite">
                <span data-for="empty">{copy.recommend.empty}</span>
                <span data-for="sending">{copy.recommend.sending}</span>
                <span data-for="error">{copy.recommend.error}</span>
                <span data-for="limited">{copy.recommend.limited}</span>
                <span data-for="success">{copy.recommend.success}</span>
              </p>
            </form>
          )
        }
      </section>
    ))
  }
</Base>

<style>
  /* The quote stands where the intro would. Both marks are oversized and hang
     outside the text block: the opening one in the left margin, the closing one
     past the last word, so the sentence itself stays flush with the headline. */
  .reading__quote {
    color: var(--color-text-secondary);
    margin: var(--spacing-8) 0 0;
    max-width: 38rem;
    position: relative;
  }

  .reading__quote p {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.45;
    margin: 0;
  }

  .reading__quote p::before,
  .reading__quote p::after {
    color: var(--color-action);
    font-family: var(--font-serif);
    font-size: 4.5em;
    line-height: 0;
    position: absolute;
  }

  .reading__quote p::before {
    content: '\201C';
    left: -0.6em;
    top: 0.62em;
  }

  .reading__quote p::after {
    content: '\201D';
    /* A fixed advance, because this mark is the one in normal flow and the
       fallback serif's quote glyph is ~40% wider. Without it the line reflows
       when Instrument Serif swaps in. The glyph paints past the box. */
    display: inline-block;
    inline-size: 0.25em;
    margin-left: 0.05em;
    position: relative;
    top: 0.44em;
  }

  /* Hanging into the margin needs about 3rem of it, which the 70rem column only
     has above 76rem. Under that the marks sit inside the column instead. */
  @media (max-width: 76rem) {
    .reading__quote p {
      padding-inline-start: 1.5rem;
    }

    .reading__quote p::before,
    .reading__quote p::after {
      font-size: 3.5em;
    }

    .reading__quote p::before {
      left: -0.05em;
      top: 0.55em;
    }

    .reading__quote p::after {
      top: 0.36em;
    }
  }

  .reading__quote footer {
    font-size: var(--font-size-sm);
    letter-spacing: 0.04em;
    margin-top: var(--spacing-4);
    text-transform: uppercase;
  }

  .reading__quote footer::before {
    background: currentColor;
    content: '';
    display: inline-block;
    height: 1px;
    margin-right: var(--spacing-3);
    vertical-align: middle;
    width: 1.5rem;
  }

  .reading__group {
    border-top: 1px solid var(--color-stroke-subtle);
    padding-block: var(--spacing-8) var(--spacing-6);
  }

  .reading__group h2 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-6);
  }

  .reading__group ul {
    display: grid;
    gap: var(--spacing-10) var(--spacing-12);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Covers in a narrow column, everything textual in the other, so the note
     follows the author line directly whatever height the covers are. */
  .reading__item {
    align-items: start;
    display: grid;
    gap: var(--spacing-4);
    grid-template-columns: 4.5rem minmax(0, 1fr);
    max-width: 40rem;
  }

  .reading__covers {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding-top: 0.25rem;
  }

  .reading__covers :global(img),
  .reading__cover-placeholder {
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  /* Stand-in for books with no cover art. Built from stroke tokens so it reads
     against the canvas in both themes. */
  .reading__cover-placeholder {
    background: linear-gradient(135deg, var(--color-stroke-subtle), var(--color-stroke-strong));
  }

  .reading__book + .reading__book {
    margin-top: var(--spacing-3);
  }

  .reading__book h3 {
    font-size: var(--type-body);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    margin: 0;
  }

  .reading__book h3 a {
    color: inherit;
    text-decoration: none;
  }

  .reading__book h3 a:hover {
    color: var(--color-action);
  }

  .reading__book h3 a :global(svg) {
    margin-left: 0.2em;
    vertical-align: -0.05em;
  }

  .reading__book p {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    line-height: 1.4;
    margin: var(--spacing-1) 0 0;
  }

  .reading__note {
    color: var(--color-text-primary);
    font-size: var(--type-body-small);
    line-height: 1.6;
    margin: var(--spacing-3) 0 0;
  }

  /* The recommendation box closes the queue. Every message is pre-rendered and
     shown by `data-state`, so the server sends the copy and the script only
     flips a flag. Without the script the browser posts the form and follows
     the 303 to /reading/sent. */
  .recommend {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-stroke-subtle);
    border-radius: var(--radius-lg);
    margin-top: var(--spacing-10);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .recommend__lead {
    color: var(--color-text-primary);
    font-size: var(--type-body);
    font-weight: var(--font-weight-semibold);
    margin: 0 0 var(--spacing-4);
  }

  .recommend__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
  }

  .recommend__row .input {
    flex: 1 1 16rem;
    inline-size: auto;
  }

  .recommend[data-state='success'] .recommend__row {
    display: none;
  }

  .recommend__status span {
    display: none;
  }

  .recommend[data-state='empty'] [data-for='empty'],
  .recommend[data-state='sending'] [data-for='sending'],
  .recommend[data-state='error'] [data-for='error'],
  .recommend[data-state='limited'] [data-for='limited'],
  .recommend[data-state='success'] [data-for='success'] {
    display: block;
    margin-top: var(--spacing-3);
  }

  .recommend[data-state='empty'] .recommend__status,
  .recommend[data-state='error'] .recommend__status,
  .recommend[data-state='limited'] .recommend__status {
    color: var(--color-action);
  }

  .recommend[data-state='success'] .recommend__status {
    color: var(--color-text-primary);
    font-size: var(--type-body);
  }

  @media (min-width: 48rem) {
    .reading__group:not([data-count='1']) ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
