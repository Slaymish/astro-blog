---
import Layout from '../../components/layout/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { fetchSanity, urlFor } from '../../lib/sanity';
import { SITE_URL, absoluteUrl } from '../../lib/site';

type ReadingStatus = 'reading' | 'read' | 'to-read';

type ReadingItem = {
  title: string;
  author: string;
  status: ReadingStatus;
  coverImage?: unknown;
  link?: string;
  note?: string;
  sharedNote?: string;
};

/** One rendered card: a single book, or several that share a note. */
type ReadingCard = { books: ReadingItem[]; note?: string };

const readingItems = await fetchSanity<ReadingItem[]>(`
  *[_type == "book"] | order(coalesce(order, 1000) asc, title asc){
    title,
    author,
    status,
    coverImage,
    note,
    link,
    sharedNote
  }
`);

/**
 * Books that share a `sharedNote` key (within one status) collapse into one
 * card, covers and titles stacked, with the first book's note beneath them.
 */
const toCards = (items: ReadingItem[]): ReadingCard[] => {
  const cards: ReadingCard[] = [];
  const shared = new Map<string, ReadingCard>();
  for (const item of items) {
    const key = item.sharedNote?.trim();
    if (!key) {
      cards.push({ books: [item], note: item.note });
      continue;
    }
    const existing = shared.get(key);
    if (existing) {
      existing.books.push(item);
      existing.note ||= item.note;
    } else {
      const card = { books: [item], note: item.note };
      shared.set(key, card);
      cards.push(card);
    }
  }
  return cards;
};

/** Currently reading first, then the queue, then the archive. */
const groups: { status: ReadingStatus; heading: string }[] = [
  { status: 'reading', heading: 'Reading now' },
  { status: 'to-read', heading: 'Next' },
  { status: 'read', heading: 'Read' }
];

const grouped = groups
  .map((group) => ({ ...group, cards: toCards(readingItems.filter((item) => item.status === group.status)) }))
  .filter((group) => group.cards.length > 0);
---

<Layout
  title="Reading"
  description="What Hamish Burke is reading, has read, and hopes to read next."
  canonicalURL={absoluteUrl('/reading', SITE_URL)}
>
  <PageHeader
    eyebrow="Reading"
    headline="Books, mostly."
    intro="What I'm reading now, what's queued up next and what I've finished, with the note I wrote for each one as I went. Always keen to hear a recommendation."
    headlineMeasure="14ch"
    introMeasure="38rem"
  />

  {grouped.map((group) => (
    <section class="reading__group" aria-labelledby={`reading-${group.status}`} data-count={Math.min(group.cards.length, 2)}>
      <h2 id={`reading-${group.status}`}>{group.heading}</h2>
      <ul>
        {group.cards.map((card) => (
          <li class="reading__item">
            <div class="reading__covers">
              {card.books.map((item) =>
                item.coverImage ? (
                  <img
                    src={urlFor(item.coverImage).width(144).height(216).fit('crop').url()}
                    alt={`Cover of ${item.title}`}
                    width="72"
                    height="108"
                    loading="lazy"
                  />
                ) : (
                  <div class="reading__cover-placeholder" aria-hidden="true" />
                )
              )}
            </div>
            <div class="reading__text">
            {card.books.map((item) => (
              <div class="reading__book">
                <h3>
                  {item.link ? (
                    <a href={item.link} target="_blank" rel="noopener noreferrer">
                      {item.title}
                      <Icon name="arrow-up-right" size="0.8em" />
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>
                <p>{item.author}</p>
              </div>
            ))}
            {card.note && <p class="reading__note">{card.note}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<style>
  .reading__group { border-top: 1px solid var(--color-stroke-subtle); padding-block: var(--spacing-8) var(--spacing-6); }
  .reading__group h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); letter-spacing: var(--tracking-heading); margin: 0 0 var(--spacing-6); }
  .reading__group ul { display: grid; gap: var(--spacing-10) var(--spacing-12); list-style: none; margin: 0; padding: 0; }

  /* Covers in a narrow column, everything textual in the other, so the note
     follows the author line directly whatever height the covers are. */
  .reading__item { align-items: start; display: grid; gap: var(--spacing-4); grid-template-columns: 4.5rem minmax(0, 1fr); max-width: 40rem; }
  .reading__covers { display: flex; flex-direction: column; gap: var(--spacing-2); padding-top: 0.25rem; }
  .reading__covers img,
  .reading__cover-placeholder { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  /* Stand-in for books with no cover art. Built from stroke tokens so it reads
     against the canvas in both themes. */
  .reading__cover-placeholder { background: linear-gradient(135deg, var(--color-stroke-subtle), var(--color-stroke-strong)); }

  .reading__book + .reading__book { margin-top: var(--spacing-3); }
  .reading__book h3 { font-size: var(--type-body); font-weight: 600; line-height: 1.3; margin: 0; }
  .reading__book h3 a { color: inherit; text-decoration: none; }
  .reading__book h3 a:hover { color: var(--color-action); }
  .reading__book h3 a :global(svg) { margin-left: 0.2em; vertical-align: -0.05em; }
  .reading__book p { color: var(--color-text-secondary); font-size: var(--type-body-small); line-height: 1.4; margin: var(--spacing-1) 0 0; }

  .reading__note { color: var(--color-text-primary); font-size: var(--type-body-small); line-height: 1.6; margin: var(--spacing-3) 0 0; }

  @media (min-width: 48rem) {
    .reading__group:not([data-count="1"]) ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
