---
import Layout from '../../components/layout/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import { fetchSanity, urlFor } from '../../lib/sanity';
import { SITE_URL, absoluteUrl } from '../../lib/site';

type ReadingStatus = 'reading' | 'read' | 'to-read';

type ReadingItem = {
  title: string;
  author: string;
  status: ReadingStatus;
  coverImage?: unknown;
  link?: string;
};

const readingItems = await fetchSanity<ReadingItem[]>(`
  *[_type == "book"] | order(title asc){
    title,
    author,
    status,
    coverImage,
    link
  }
`);

/** Currently reading first, then the queue, then the archive. */
const groups: { status: ReadingStatus; heading: string }[] = [
  { status: 'reading', heading: 'Reading now' },
  { status: 'to-read', heading: 'Next' },
  { status: 'read', heading: 'Read' }
];

const grouped = groups
  .map((group) => ({ ...group, items: readingItems.filter((item) => item.status === group.status) }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title="Reading"
  description="What Hamish Burke is reading, has read, and hopes to read next."
  canonicalURL={absoluteUrl('/reading', SITE_URL)}
>
  <header class="reading__header">
    <p class="reading__eyebrow">Reading</p>
    <h1 transition:name="page-heading">Books, mostly.</h1>
    <p class="reading__intro">
      What I am reading now, what is queued, and what I have finished. Recommendations are always welcome.
    </p>
  </header>

  {grouped.map((group) => (
    <section class="reading__group" aria-labelledby={`reading-${group.status}`}>
      <h2 id={`reading-${group.status}`}>{group.heading}</h2>
      <ul>
        {group.items.map((item) => (
          <li class="reading__item">
            <div class="reading__cover" aria-hidden={item.coverImage ? undefined : 'true'}>
              {item.coverImage ? (
                <img
                  src={urlFor(item.coverImage).width(160).height(240).fit('crop').url()}
                  alt={`Cover of ${item.title}`}
                  width="80"
                  height="120"
                  loading="lazy"
                />
              ) : (
                <div class="reading__cover-placeholder" />
              )}
            </div>
            <div class="reading__detail">
              <h3>{item.title}</h3>
              <p>{item.author}</p>
            </div>
            {item.link && (
              <a href={item.link} target="_blank" rel="noopener noreferrer" aria-label={`View ${item.title}`}>
                <Icon name="arrow-up-right" />
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<style>
  .reading__header { padding-block: var(--hero-top-space) var(--hero-bottom-space); }
  .reading__eyebrow { color: var(--color-action); font-size: var(--type-label); font-weight: 700; letter-spacing: .1em; margin: 0 0 var(--spacing-5); text-transform: uppercase; }
  .reading__header h1 { font-size: var(--type-display); letter-spacing: var(--tracking-display); line-height: .88; margin: 0; max-width: 14ch; }
  .reading__intro { color: var(--color-text-secondary); font-size: clamp(1.1rem, 2vw, 1.45rem); line-height: 1.45; margin: var(--spacing-8) 0 0; max-width: 38rem; }

  .reading__group { border-top: 1px solid var(--color-stroke-subtle); padding-block: var(--spacing-8) var(--spacing-4); }
  .reading__group h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); letter-spacing: var(--tracking-heading); margin: 0 0 var(--spacing-6); }
  .reading__group ul { display: grid; gap: var(--spacing-6) var(--spacing-8); list-style: none; margin: 0; padding: 0; }

  .reading__item { align-items: start; display: grid; gap: var(--spacing-4); grid-template-columns: 5rem minmax(0, 1fr) auto; }
  .reading__cover img,
  .reading__cover-placeholder { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  /* Stand-in for books with no cover art. Built from stroke tokens so it reads
     against the canvas in both themes. */
  .reading__cover-placeholder { background: linear-gradient(135deg, var(--color-stroke-subtle), var(--color-stroke-strong)); }
  .reading__detail h3 { font-size: var(--type-body); line-height: 1.4; margin: 0 0 var(--spacing-1); }
  .reading__detail p { color: var(--color-text-secondary); font-size: var(--type-body-small); margin: 0; }
  .reading__item > a { align-items: center; color: var(--color-text-secondary); display: inline-flex; min-height: 2.75rem; }
  .reading__item > a:hover { color: var(--color-action); }

  @media (min-width: 48rem) {
    .reading__group ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 75rem) {
    .reading__group ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
