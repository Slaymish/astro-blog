---
import { NEW_TAB_NOTE_ID } from '../../site/config';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import SanityImage from '../../components/SanityImage.astro';
import { getBooks, getReadingPage } from '../../content/queries';
import { MAX_RECOMMENDATION_LENGTH } from '../../server/recommendations';
import type { Book } from '../../content/types';

const [books, copy] = await Promise.all([getBooks(), getReadingPage()]);

/** One rendered card: a single book, or several that share a note. */
interface ReadingCard {
  books: Book[];
  note?: string;
}

/**
 * Books that share a `sharedNote` key (within one status) collapse into one
 * card, covers and titles stacked, with the first book's note beneath them.
 */
const toCards = (items: Book[]): ReadingCard[] => {
  const cards: ReadingCard[] = [];
  const shared = new Map<string, ReadingCard>();
  for (const item of items) {
    const key = item.sharedNote?.trim();
    if (!key) {
      cards.push({ books: [item], note: item.note });
      continue;
    }
    const existing = shared.get(key);
    if (existing) {
      existing.books.push(item);
      existing.note ||= item.note;
    } else {
      const card: ReadingCard = { books: [item], note: item.note };
      shared.set(key, card);
      cards.push(card);
    }
  }
  return cards;
};

const ordered = [...books].sort(
  (a, b) => (a.order ?? 1000) - (b.order ?? 1000) || a.title.localeCompare(b.title),
);

/** Currently reading first, then the queue, then the archive. */
const groups = [
  { status: 'reading' as const, heading: copy.groups.reading },
  { status: 'to-read' as const, heading: copy.groups.toRead },
  { status: 'read' as const, heading: copy.groups.read },
];

const grouped = groups
  .map((group) => ({
    ...group,
    cards: toCards(ordered.filter((item) => item.status === group.status)),
  }))
  .filter((group) => group.cards.length > 0);
---

<Base
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: 'Reading', path: '/reading' }]}
>
  <header class="reading__hero">
    <h1>{copy.headline}</h1>
    <blockquote class="reading__quote">
      <p>{copy.quote.text}</p>
      <footer>{copy.quote.attribution}</footer>
    </blockquote>
  </header>

  {
    grouped.map((group) => (
      <section
        class:list={["reading__group", `reading__group--${group.status}`]}
        aria-labelledby={`reading-${group.status}`}
      >
        <h2 id={`reading-${group.status}`}>{group.heading}</h2>
        <ul>
          {group.cards.map((card) => (
            <li class="reading__item">
              <div class="reading__covers">
                {card.books.map((item) =>
                  item.coverImage ? (
                    <SanityImage
                      image={item.coverImage}
                      alt={`Cover of ${item.title}`}
                      widths={[112, 224, 384]}
                      sizes={group.status === 'reading' ? '(min-width: 48rem) 12rem, 7rem' : '7rem'}
                      aspect={2 / 3}
                      loading={group.status === 'reading' ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <div class="reading__cover-placeholder" aria-hidden="true" />
                  ),
                )}
              </div>
              <div class="reading__text">
                {card.books.map((item) => (
                  <div class="reading__book">
                    <h3>
                      {item.link ? (
                        <a href={item.link} target="_blank" aria-describedby={NEW_TAB_NOTE_ID} rel="noopener noreferrer">
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                    <p>{item.author}</p>
                  </div>
                ))}
              </div>
              {card.note && <p class="reading__note">{card.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <form class="recommend" id="recommend" method="post" action="/api/recommend" data-state="idle">
    <label class="recommend__lead" for="recommend-title">{copy.recommend.lead}</label>
    <div class="recommend__row">
      <input
        id="recommend-title"
        class="input input--lg"
        name="title"
        type="text"
        autocomplete="off"
        required
        maxlength={MAX_RECOMMENDATION_LENGTH}
        placeholder={copy.recommend.placeholder}
        aria-describedby="recommend-status"
      />
      <Button size="lg" type="submit" id="recommend-submit">{copy.recommend.button}</Button>
    </div>
    {/* The visible messages switch on data-state. Screen readers hear them
        through the separate status below, which the script writes, because a
        live region does not reliably announce content revealed by CSS. */}
    <p class="field__message recommend__status" id="recommend-status">
      <span data-for="empty"><Icon name="alert" motion="none" />{copy.recommend.empty}</span>
      <span data-for="sending">{copy.recommend.sending}</span>
      <span data-for="error"><Icon name="alert" motion="none" />{copy.recommend.error}</span>
      <span data-for="limited"><Icon name="alert" motion="none" />{copy.recommend.limited}</span>
      <span data-for="success">{copy.recommend.success}</span>
    </p>
    <p class="sr-only" role="status" data-recommend-announce></p>
  </form>
</Base>

<style>
  /* One surface treatment on this page: hairlines between groups and entries,
     and the inset panel for the two things a visitor acts on or should see
     first (the book in hand, and the recommendation form). No shadows. */
  .reading__hero {
    display: grid;
    gap: var(--spacing-12);
    align-items: end;
    padding-block: var(--hero-top-space) var(--spacing-16);
    grid-template-columns: minmax(0, 1fr) 26.25rem;
  }

  .reading__hero h1 {
    font-size: var(--type-heading-1);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin: 0;
  }

  .reading__quote {
    border-left: 2px solid var(--color-action);
    color: var(--color-text-secondary);
    margin: 0;
    padding-left: var(--spacing-7);
  }

  .reading__quote p {
    font-size: 1.5rem;
    letter-spacing: var(--tracking-heading);
    line-height: 1.3;
    margin: 0;
  }

  .reading__quote footer {
    font-size: var(--type-body-small);
    margin-top: var(--spacing-4);
  }

  .reading__group {
    border-top: 1px solid var(--color-stroke-strong);
    padding-block: var(--spacing-12);
  }

  .reading__group h2 {
    font-size: var(--type-heading-3);
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    margin: 0 0 var(--spacing-8);
  }

  .reading__group ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .reading__item {
    align-items: start;
    display: grid;
    gap: var(--spacing-6);
    grid-template-columns: 7rem minmax(0, 1fr);
    min-width: 0;
  }

  .reading__covers {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .reading__covers :global(img),
  .reading__cover-placeholder {
    aspect-ratio: 2 / 3;
    border: 1px solid var(--color-stroke-subtle);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .reading__cover-placeholder {
    background: var(--color-bg-inset);
  }

  .reading__book + .reading__book {
    margin-top: var(--spacing-6);
  }

  .reading__book h3 {
    font-size: 1.375rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    margin: 0;
  }

  .reading__book h3 a {
    color: inherit;
    text-decoration: none;
  }

  .reading__book h3 a:hover {
    color: var(--color-action);
  }

  .reading__book p {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    line-height: 1.4;
    margin: var(--spacing-2) 0 0;
  }

  .reading__note {
    font-size: 1rem;
    line-height: 1.65;
    grid-column: 1 / -1;
    margin: 0;
  }

  .reading__group--reading,
  .recommend {
    background: var(--color-bg-inset);
    border-top: 0;
    padding: var(--spacing-12);
  }

  .reading__group--reading ul {
    gap: var(--spacing-12);
  }

  .reading__group--reading .reading__item {
    grid-template-columns: 12rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: var(--spacing-5) var(--spacing-12);
  }

  .reading__group--reading .reading__covers {
    grid-row: span 2;
  }

  .reading__group--reading .reading__book h3 {
    font-size: var(--type-heading-3);
  }

  .reading__group--reading .reading__book p {
    font-size: 1rem;
  }

  .reading__group--reading .reading__note {
    grid-column: 2;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .reading__group--reading + .reading__group {
    margin-top: var(--spacing-12);
  }

  .reading__group--to-read ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--spacing-12);
  }

  .reading__group--to-read .reading__item,
  .reading__group--read .reading__item {
    border-top: 1px solid var(--color-stroke-subtle);
    padding-block: var(--spacing-8);
  }

  .reading__group--read .reading__item {
    grid-template-columns: 7rem 15rem minmax(0, 1fr);
    gap: var(--spacing-10);
  }

  .reading__group--read .reading__note {
    grid-column: 3;
  }

  .recommend {
    margin-bottom: var(--spacing-16);
  }

  .recommend__lead {
    display: block;
    font-size: var(--type-heading-3);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    margin: 0 0 var(--spacing-6);
  }

  .recommend__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }

  .recommend__row .input {
    flex: 1 1 16rem;
    inline-size: auto;
    min-width: 0;
  }

  .recommend__status span {
    display: none;
  }

  .recommend[data-state='empty'] [data-for='empty'],
  .recommend[data-state='sending'] [data-for='sending'],
  .recommend[data-state='error'] [data-for='error'],
  .recommend[data-state='limited'] [data-for='limited'],
  .recommend[data-state='success'] [data-for='success'] {
    align-items: baseline;
    display: flex;
    gap: var(--spacing-2);
    margin-top: var(--spacing-3);
  }

  /* Colour alone does not mark a problem: the messages that ask for another
     go carry the alert icon too. */
  .recommend__status :global(.icon) {
    align-self: center;
  }

  .recommend[data-state='empty'] .recommend__status,
  .recommend[data-state='error'] .recommend__status,
  .recommend[data-state='limited'] .recommend__status {
    color: var(--color-action);
  }

  .recommend[data-state='success'] .recommend__status {
    color: var(--color-text-primary);
    font-size: var(--type-body);
  }

  @media (max-width: 60rem) {
    .reading__hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .reading__group--to-read ul {
      grid-template-columns: 1fr;
    }

    .reading__group--read .reading__item {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--spacing-6);
    }

    .reading__group--read .reading__note {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 48rem) {
    .reading__hero {
      grid-template-columns: 1fr;
      gap: var(--spacing-8);
      padding-block: var(--spacing-12);
    }

    .reading__quote p {
      font-size: 1.25rem;
    }

    .reading__group {
      padding-block: var(--spacing-10);
    }

    .reading__group--reading,
    .recommend {
      padding: var(--spacing-6);
    }

    .reading__group--reading .reading__item {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--spacing-6);
    }

    .reading__group--reading .reading__covers {
      grid-row: auto;
    }

    .reading__group--reading .reading__book h3 {
      font-size: 1.5rem;
    }

    .reading__group--reading .reading__note {
      grid-column: 1 / -1;
      font-size: 1rem;
    }
  }

  @media (max-width: 30rem) {
    .reading__group--to-read .reading__item {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: var(--spacing-5);
    }

    .recommend__row {
      flex-direction: column;
    }

    .recommend__row .input {
      flex-basis: auto;
      inline-size: 100%;
    }
  }
</style>
