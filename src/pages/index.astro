---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import IconText from '../components/IconText.astro';
import VideoCover from '../components/VideoCover.astro';
import WorkCover from '../components/WorkCover.astro';
import { getHomePage, getWorkStories } from '../content/queries';
import { artifactHref } from '../content/work';
import { PAUSE_LABEL } from '../client/videoTeaser';
import youIncPoster from '../assets/images/youinc-teaser-poster.jpg';

/**
 * The one feature with a clip instead of a still. Matched on slug so that
 * reordering homePage.featured in Studio moves the card without the clip
 * following the wrong story.
 */
const TEASER = {
  slug: 'you-inc',
  src: '/media/youinc-teaser.mp4',
  poster: youIncPoster,
};

const DEFAULT_CTA = 'View case study';

const [copy, stories] = await Promise.all([getHomePage(), getWorkStories()]);

const featured = copy.featured
  .map((slug) => stories.find((story) => story.slug === slug))
  .filter((story): story is NonNullable<typeof story> => story !== undefined);

if (featured.length !== copy.featured.length) {
  const missing = copy.featured.filter((slug) => !stories.some((story) => story.slug === slug));
  throw new Error(`homePage.featured references missing work stories: ${missing.join(', ')}`);
}

const writingHref = artifactHref(copy.writingEntry._type, copy.writingEntry.slug);
---

<Base title={copy.seo.title} description={copy.seo.description}>
  <section class="opening" aria-labelledby="intro-heading">
    <div class="opening__inner">
      <h1 id="intro-heading">{copy.heading}</h1>
      <a class="text-link" href="/about"><IconText icon="arrow-up-right">{copy.aboutLabel}</IconText></a>
    </div>
  </section>

  <section class="features" aria-label="Featured work">
    {
      featured.map((story, index) => {
        const href = `/work/${story.slug}`;
        const teased = story.slug === TEASER.slug;
        return (
          <article class="feature">
            <div class="feature__media">
              <a class="visual-link" href={href} aria-label={`Explore ${story.title}`}>
                {teased ? (
                  <VideoCover src={TEASER.src} poster={TEASER.poster} alt={story.cover.alt} elevated />
                ) : (
                  <WorkCover cover={story.cover} priority={index === 0} elevated />
                )}
              </a>
              <div class="feature__actions">
                {teased && (
                  <Button class="feature__toggle" variant="secondary" size="sm" icon={false} data-teaser-toggle hidden>
                    {PAUSE_LABEL}
                  </Button>
                )}
                <Button class="feature__cta" href={href} size="sm">
                  {story.ctaLabel ?? DEFAULT_CTA}
                </Button>
              </div>
            </div>
            <div class="feature__text">
              <h2><a href={href}>{story.title}</a></h2>
              <p>{story.introduction}</p>
            </div>
          </article>
        );
      })
    }
  </section>

  <section class="selected" aria-labelledby="selected-heading">
    <div class="section-heading">
      <h2 id="selected-heading">{copy.moreWorkHeading}</h2>
      <a class="text-link" href="/work"><IconText>{copy.allWorkLabel}</IconText></a>
    </div>
  </section>

  <section class="notes" aria-label="Writing and reading">
    <div>
      <p class="label">{copy.writingLabel}</p>
      <h2><a href={writingHref}>{copy.writingEntry.title}</a></h2>
      <p>{copy.writingBlurb}</p>
      <a class="text-link" href={writingHref}><IconText>{copy.writingLinkLabel}</IconText></a>
      <a class="more-writing" href="/writing">{copy.allWritingLabel}</a>
    </div>
    <aside>
      <p class="label">{copy.readingLabel}</p>
      <p>{copy.readingText}</p>
      <a class="text-link" href="/reading"><IconText>{copy.readingLinkLabel}</IconText></a>
    </aside>
  </section>
</Base>

<script>
  import { initVideoTeaser } from '../client/videoTeaser';

  document.querySelectorAll<HTMLElement>('.feature').forEach((root) => {
    initVideoTeaser(root);
  });
</script>

<style>
  /* The home page runs narrower than the 70rem shell, so the feature rows read
     as one centred column rather than spanning the full container. */
  .opening,
  .features,
  .selected,
  .notes {
    margin-inline: auto;
    max-width: 54rem;
  }

  .opening {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(3.5rem, 9vw, 6.5rem);
    text-align: center;
  }

  /* Shrink-wraps the heading so the About link can sit on its trailing edge. */
  .opening__inner {
    display: inline-block;
    text-align: right;
  }

  h1 {
    font-size: var(--type-display);
    letter-spacing: -0.045em;
    line-height: 1.04;
    margin: 0;
  }

  p {
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: var(--spacing-4) 0;
  }

  .label {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    margin: 0 0 var(--spacing-2);
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    margin: 0;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-action);
  }

  .text-link {
    --icon-gap: var(--spacing-2);
    color: var(--color-action);
    display: inline-block;
    font-size: 0.95rem;
    font-weight: var(--font-weight-medium);
    padding-block: var(--spacing-2);
    text-decoration: none;
  }

  .visual-link {
    display: block;
  }

  .features {
    display: grid;
    gap: clamp(4rem, 9vw, 7.5rem);
  }

  .feature {
    display: grid;
    gap: var(--spacing-8);
  }

  /* Reserves the half of the controls that hangs below the cover. */
  .feature__media {
    min-width: 0;
    padding-block-end: calc(var(--control-height-sm) / 2);
    position: relative;
  }

  .feature__actions {
    --control-radius: var(--radius-full);
    align-items: center;
    display: flex;
    gap: var(--spacing-3);
    inset-block-end: calc(var(--control-height-sm) / 2);
    inset-inline-end: var(--spacing-6);
    position: absolute;
    transform: translateY(50%);
  }

  /* Opaque so the label stays legible over the clip it controls. */
  .feature__toggle {
    background: var(--color-bg-raised);
  }

  .feature__text {
    align-self: center;
  }

  .feature__text p {
    font-size: var(--type-body-small);
    margin-block-end: 0;
    max-width: 34ch;
  }

  .selected {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .section-heading {
    align-items: baseline;
    border-block-end: 1px solid var(--color-stroke-subtle);
    display: flex;
    gap: var(--spacing-4);
    justify-content: space-between;
    padding-block-end: var(--spacing-3);
  }

  .section-heading h2 {
    font-size: 1.25rem;
  }

  .notes {
    display: grid;
    gap: var(--spacing-12);
    padding-block: clamp(3rem, 7vw, 5rem) var(--spacing-16);
  }

  .notes h2 {
    max-width: 28ch;
  }

  .notes p {
    font-size: var(--type-body-small);
  }

  .more-writing {
    color: var(--color-text-secondary);
    display: block;
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-3);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .feature {
      align-items: center;
      gap: var(--spacing-10);
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }

    .notes {
      gap: 5rem;
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
