---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import IconText from '../components/IconText.astro';
import VideoCover from '../components/VideoCover.astro';
import WorkCover from '../components/WorkCover.astro';
import { getHomePage, getWorkStories } from '../content/queries';
import { categoryLabel } from '../content/work';
import { artifactHref } from '../content/work';
import { PAUSE_LABEL } from '../client/videoTeaser';
import youIncPoster from '../assets/images/youinc-teaser-poster.jpg';

/**
 * The one lead feature with a clip instead of a still. Matched on slug so that
 * reordering homePage.featured in Studio moves the card without the clip
 * following the wrong story.
 */
const TEASER = {
  slug: 'you-inc',
  src: '/media/youinc-teaser.mp4',
  poster: youIncPoster,
};

const [copy, stories] = await Promise.all([getHomePage(), getWorkStories()]);

const featured = copy.featured
  .map((slug) => stories.find((story) => story.slug === slug))
  .filter((story): story is NonNullable<typeof story> => story !== undefined);

if (featured.length !== copy.featured.length) {
  const missing = copy.featured.filter((slug) => !stories.some((story) => story.slug === slug));
  throw new Error(`homePage.featured references missing work stories: ${missing.join(', ')}`);
}

const [lead, ...secondary] = featured;
const writingHref = artifactHref(copy.writingEntry._type, copy.writingEntry.slug);
---

<Base title={copy.seo.title} description={copy.seo.description}>
  <section class="opening" aria-labelledby="intro-heading">
    <div class="introduction">
      <p class="label">{copy.eyebrow}</p>
      <h1 id="intro-heading">{copy.heading}</h1>
      <p>{copy.intro}</p>
      <a class="text-link" href="/about"><IconText icon="arrow-up-right">{copy.aboutLabel}</IconText></a>
    </div>
    {
      lead && (
        <article class="lead-feature">
          <a class="visual-link" href={`/work/${lead.slug}`} aria-label={`Explore ${lead.title}`}>
            {lead.slug === TEASER.slug ? (
              <VideoCover src={TEASER.src} poster={TEASER.poster} alt={lead.cover.alt} />
            ) : (
              <WorkCover cover={lead.cover} priority />
            )}
          </a>
          {lead.slug === TEASER.slug && (
            <Button class="teaser-toggle" variant="ghost" size="sm" icon={false} data-teaser-toggle hidden>
              {PAUSE_LABEL}
            </Button>
          )}
          <p class="label">Featured work · {categoryLabel(lead.kind)}</p>
          <h2><a href={`/work/${lead.slug}`}>{lead.title}</a></h2>
          <p>{lead.introduction}</p>
          <a class="text-link" href={`/work/${lead.slug}`}>
            <IconText>{copy.leadLinkLabel}</IconText>
          </a>
        </article>
      )
    }
  </section>

  <section class="selected" aria-labelledby="selected-heading">
    <div class="section-heading">
      <h2 id="selected-heading">{copy.moreWorkHeading}</h2>
      <a class="text-link" href="/work"><IconText>{copy.allWorkLabel}</IconText></a>
    </div>
    <div class="secondary-grid">
      {
        secondary.map((story) => (
          <article>
            <a class="visual-link" href={`/work/${story.slug}`} aria-label={`Explore ${story.title}`}>
              <WorkCover cover={story.cover} compact />
            </a>
            <p class="label">{categoryLabel(story.kind)} · {story.descriptor}</p>
            <h3><a href={`/work/${story.slug}`}>{story.title}</a></h3>
            <p>{story.introduction}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="notes" aria-label="Writing and reading">
    <div>
      <p class="label">{copy.writingLabel}</p>
      <h2><a href={writingHref}>{copy.writingEntry.title}</a></h2>
      <p>{copy.writingBlurb}</p>
      <a class="text-link" href={writingHref}><IconText>{copy.writingLinkLabel}</IconText></a>
      <a class="more-writing" href="/writing">{copy.allWritingLabel}</a>
    </div>
    <aside>
      <p class="label">{copy.readingLabel}</p>
      <p>{copy.readingText}</p>
      <a class="text-link" href="/reading"><IconText>{copy.readingLinkLabel}</IconText></a>
    </aside>
  </section>
</Base>

<script>
  import { initVideoTeaser } from '../client/videoTeaser';

  document.querySelectorAll<HTMLElement>('.lead-feature').forEach((root) => {
    initVideoTeaser(root);
  });
</script>

<style>
  .opening {
    display: grid;
    gap: var(--spacing-12);
    padding-block: var(--spacing-8) var(--spacing-16);
  }

  h1 {
    font-size: clamp(3rem, 5vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
    margin: var(--spacing-5) 0 var(--spacing-8);
  }

  p {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.65;
    margin: var(--spacing-4) 0;
  }

  .label {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    margin: var(--spacing-6) 0 var(--spacing-2);
    text-transform: uppercase;
  }

  .introduction .label {
    margin-top: 0;
  }

  h2,
  h3 {
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    margin: 0;
  }

  h2 a,
  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover,
  h3 a:hover {
    color: var(--color-action);
  }

  .text-link {
    --icon-gap: var(--spacing-2);
    color: var(--color-action);
    display: inline-block;
    font-size: 0.95rem;
    font-weight: var(--font-weight-medium);
    padding-block: var(--spacing-2);
    text-decoration: none;
  }

  .visual-link {
    display: block;
  }

  /* Sits between the clip and the label, outside the card's link. */
  .teaser-toggle {
    margin-top: var(--spacing-3);
  }

  .selected {
    border-top: 1px solid var(--color-stroke-subtle);
    padding-block: var(--spacing-8) var(--spacing-16);
  }

  .section-heading {
    align-items: baseline;
    display: flex;
    gap: var(--spacing-4);
    justify-content: space-between;
    margin-bottom: var(--spacing-8);
  }

  .section-heading h2 {
    font-size: 1.25rem;
  }

  .secondary-grid {
    display: grid;
    gap: var(--spacing-12);
  }

  .notes {
    border-top: 1px solid var(--color-stroke-subtle);
    display: grid;
    gap: var(--spacing-12);
    padding-block: var(--spacing-8) var(--spacing-12);
  }

  .notes h2 {
    max-width: 28ch;
  }

  .more-writing {
    color: var(--color-text-secondary);
    display: block;
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-3);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .opening {
      gap: 3.5rem;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      padding-block: var(--spacing-12) 5rem;
    }

    .secondary-grid {
      grid-template-columns: 1.15fr 1fr;
    }

    .notes {
      gap: 5rem;
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
