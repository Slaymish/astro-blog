---
import type { StructuredEntry } from '../site/seo';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import IconText from '../components/IconText.astro';
import IntroductionText from '../components/IntroductionText.astro';
import VideoCover from '../components/VideoCover.astro';
import WorkCover from '../components/WorkCover.astro';
import { getHomePage, getSiteSettings, getWorkStories } from '../content/queries';
import { artifactHref } from '../content/work';
import { PAUSE_LABEL } from '../client/videoTeaser';
import theCityPoster from '../assets/images/thecity-teaser-poster.jpg';
import youIncPoster from '../assets/images/youinc-teaser-poster.jpg';

/**
 * The features with a clip instead of a still. Keyed on slug so that
 * reordering homePage.featured in Studio moves the card without the clip
 * following the wrong story.
 */
const TEASERS: Record<string, { src: string; poster: ImageMetadata; width: number; height: number }> = {
  'the-city': { src: '/media/thecity-teaser.mp4', poster: theCityPoster, width: 1280, height: 800 },
  'you-inc': { src: '/media/youinc-teaser.mp4', poster: youIncPoster, width: 1280, height: 720 },
};

const [copy, stories, settings] = await Promise.all([getHomePage(), getWorkStories(), getSiteSettings()]);

const featured = copy.featured
  .map((slug) => stories.find((story) => story.slug === slug))
  .filter((story): story is NonNullable<typeof story> => story !== undefined);

if (featured.length !== copy.featured.length) {
  const missing = copy.featured.filter((slug) => !stories.some((story) => story.slug === slug));
  throw new Error(`homePage.featured references missing work stories: ${missing.join(', ')}`);
}

const writingHref = artifactHref(copy.writingEntry._type, copy.writingEntry.slug);
const featuredMetadata: StructuredEntry[] = featured.flatMap((story, index) => {
  const entries: StructuredEntry[] = [{
    type: 'CreativeWork', name: story.title, url: `/work/${story.slug}`,
    description: story.introduction, publishedAt: story.date,
  }];
  if (index === Math.min(1, featured.length - 1)) entries.push({
    type: copy.writingEntry._type === 'post' ? 'BlogPosting' : 'Report',
    name: copy.writingEntry.title, url: writingHref, description: copy.writingBlurb,
  });
  if (index === Math.min(3, featured.length - 1)) entries.push({
    type: 'WebPage', name: copy.readingLabel, url: '/reading', description: copy.readingText,
  });
  return entries;
});
---

<Base fluid pageType="CollectionPage" collections={[{ id: 'featured', name: copy.seo.title, entries: featuredMetadata }]} title={copy.seo.title} description={copy.seo.description}>
  <section class="opening" aria-labelledby="intro-heading" data-hero-reveal data-reveal="pending">
    <h1 id="intro-heading">
      <span class="sr-only">{copy.heading}</span>
      <span aria-hidden="true">{copy.heading.split(/(\s+)/).map((word) =>
        /\s/.test(word) ? word : (
          <span class="name-word">{Array.from(word).map((letter) => (
            <span class="name-letter"><span class="name-glyph">{letter}</span></span>
          ))}</span>
        )
      )}</span>
    </h1>
    <div class="opening__body">
      <p class="opening__intro">{copy.intro}</p>
      <a class="text-link" href="/about"><IconText>{copy.aboutLabel}</IconText></a>
    </div>
  </section>

  <div class="features">
    {
      featured.map((story, index) => {
        const href = `/work/${story.slug}`;
        const teaser = TEASERS[story.slug];
        return (
          <>
          <article class="feature">
            <div class="feature__media">
              {/* A mouse shortcut only: the title and the button already link here,
                  so the cover stays out of the tab order and the reading order. */}
              <a class="visual-link" href={href} tabindex="-1" aria-hidden="true">
                {teaser ? (
                  <VideoCover {...teaser} alt={story.cover.alt} elevated />
                ) : (
                  <WorkCover
                    cover={story.cover}
                    priority={index === 0}
                    elevated
                    sizes="(min-width: 118rem) 70rem, (min-width: 64rem) 60vw, 94vw"
                  />
                )}
              </a>
              <div class="feature__actions">
                {teaser && (
                  <Button
                    class="btn--surface feature__toggle"
                    variant="icon"
                    size="sm"
                    ariaLabel={PAUSE_LABEL}
                    data-teaser-toggle
                    hidden
                  >
                    <Icon name="pause" filled class="feature__glyph feature__glyph--pause" />
                    <Icon name="play" filled class="feature__glyph feature__glyph--play" />
                  </Button>
                )}
                <Button class="feature__cta" href={href} size="sm">
                  {story.ctaLabel ?? settings.workCtaLabel}
                </Button>
              </div>
            </div>
            <div class="feature__text">
              <h2><a href={href}>{story.title}</a></h2>
              <p><IntroductionText text={story.introduction} link={story.introductionLink} /></p>
            </div>
          </article>
          {index === Math.min(1, featured.length - 1) && (
            <section class="notes notes--writing" aria-labelledby="home-writing-heading">
              <p class="label">{copy.writingLabel}</p>
              <div class="notes__body">
                <h2 id="home-writing-heading"><a href={writingHref}>{copy.writingEntry.title}</a></h2>
                <p>{copy.writingBlurb}</p>
                <div class="notes__actions">
                  <Button variant="ghost" href={writingHref}>{copy.writingLinkLabel}</Button>
                  <Button variant="ghost" href="/work?type=writing">{copy.allWritingLabel}</Button>
                </div>
              </div>
            </section>
          )}
          {index === Math.min(3, featured.length - 1) && (
            <section class="notes notes--reading" aria-labelledby="home-reading-heading">
              <h2 class="label" id="home-reading-heading">{copy.readingLabel}</h2>
              <div class="notes__body">
                <p>{copy.readingText}</p>
                <Button variant="ghost" href="/reading">{copy.readingLinkLabel}</Button>
              </div>
            </section>
          )}
          </>
        );
      })
    }
  </div>

  <p class="all-work">
    <a class="text-link" href="/work?type=work"><IconText>{copy.allWorkLabel}</IconText></a>
  </p>
</Base>

<script>
  import { initHeroReveal } from '../client/heroReveal';
  import { initVideoTeaser } from '../client/videoTeaser';

  initHeroReveal();
  document.querySelectorAll<HTMLElement>('.feature').forEach((root) => {
    initVideoTeaser(root);
  });
</script>

<style>
  /* Visual rows use the shell; prose retains its own readable measure. */
  .opening {
    position: relative;
    overflow-anchor: none;
    align-content: center;
    display: grid;
    gap: var(--spacing-6);
    /* Mobile header is 4.25rem tall, plus its border. */
    min-height: calc(100svh - 4.25rem - 1px);
    padding-block: var(--hero-top-space) clamp(3rem, 7vw, 6rem);
    text-align: center;
  }

  .opening .opening__intro {
    color: var(--color-text-secondary);
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    margin: 0 auto var(--spacing-2);
    max-width: 36ch;
  }

  h1 {
    font-size: clamp(3.5rem, 8vw, 9rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
    margin: 0;
  }

  /* The existing hashed boot script enables this before first paint. Without
     JavaScript the normal, complete introduction remains visible. */
  :global(html[data-scripting='enabled']) .opening[data-reveal='pending'] h1 {
    grid-column: 1 / -1;
    justify-self: center;
  }

  :global(html[data-scripting='enabled']) .opening[data-reveal='pending'] .opening__body {
    position: absolute;
    visibility: hidden;
    clip-path: inset(0 100% 0 0);
    transform: translateY(0.5rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .opening[data-reveal='revealed'] .opening__body {
      animation: intro-reveal 600ms 160ms var(--easing-expressive) both;
    }
  }

  @keyframes intro-reveal {
    from {
      clip-path: inset(0 100% 0 0);
      transform: translateY(0.5rem);
    }
    to {
      clip-path: inset(0);
      transform: translateY(0);
    }
  }

  .name-word {
    display: inline-block;
    white-space: nowrap;
  }

  /* Fixed hit areas keep the pointer from chasing the moving glyphs. */
  .name-letter,
  .name-glyph {
    display: inline-block;
  }

  .name-glyph {
    pointer-events: none;
    transform-origin: center 80%;
  }

  @media (hover: hover) and (pointer: fine) {
    .name-glyph {
      transition:
        color var(--motion-duration-interaction) var(--easing-expressive),
        transform 240ms var(--easing-expressive);
    }

    .name-letter:hover .name-glyph {
      color: var(--color-action);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .name-letter:hover .name-glyph {
      transform: translateY(-0.06em) scale(1.08);
    }

    .name-letter:has(+ .name-letter:hover) .name-glyph,
    .name-letter:hover + .name-letter .name-glyph {
      transform: translateY(-0.025em) scale(1.03);
    }
  }

  p {
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: var(--spacing-4) 0;
  }

  .label {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    margin: 0 0 var(--spacing-2);
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    margin: 0;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-action);
  }

  .text-link {
    --icon-gap: var(--spacing-2);
    color: var(--color-action);
    display: inline-block;
    font-size: 0.95rem;
    font-weight: var(--font-weight-medium);
    padding-block: var(--spacing-2);
    text-decoration: none;
  }

  .visual-link {
    display: block;
    text-decoration: none;
  }

  /* Each story gets one whole row, so editorial inserts never strand a card. */
  .features {
    display: grid;
    gap: clamp(3.5rem, 7vw, 7rem);
  }

  .feature {
    align-items: center;
    min-width: 0;
    display: grid;
    gap: var(--spacing-6);
  }

  /* Reserves the half of the controls that hangs below the cover. */
  .feature__media {
    min-width: 0;
    padding-block-end: calc(var(--control-height-sm) / 2);
    position: relative;
  }

  .feature__actions {
    align-items: center;
    display: flex;
    gap: var(--spacing-3);
    inset-block-end: calc(var(--control-height-sm) / 2);
    inset-inline-end: var(--spacing-6);
    position: absolute;
    transform: translateY(50%);
  }

  /* One glyph shows at a time, chosen by what the button will do next. */
  .feature__toggle .feature__glyph--play,
  .feature__toggle[data-playing='false'] .feature__glyph--pause {
    display: none;
  }

  .feature__toggle[data-playing='false'] .feature__glyph--play {
    display: inline-block;
  }

  .feature__text p {
    font-size: var(--type-body);
    margin-block-end: 0;
    max-width: 44ch;
  }

  .all-work {
    border-block-end: 1px solid var(--color-stroke-subtle);
    margin-block: var(--spacing-12) 0;
    padding-block-end: var(--spacing-3);
    text-align: right;
  }

  .notes {
    border-block: 1px solid var(--color-stroke-subtle);
    display: grid;
    gap: var(--spacing-6);
    padding-block: var(--spacing-10);
    width: 100%;
  }

  .notes .label {
    line-height: 1.6;
    margin: 0;
  }

  .notes h2:not(.label) {
    max-width: 28ch;
  }

  .notes__body > p {
    font-size: var(--type-body-small);
    max-width: 52ch;
  }

  .notes--reading .notes__body > p {
    margin-top: 0;
  }

  .notes__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3) var(--spacing-8);
  }

  @media (min-width: 48rem) {
    .opening {
      min-height: calc(100svh - var(--site-header-height));
    }

    .notes {
      align-items: start;
      gap: var(--spacing-10);
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }

  @media (min-width: 64rem) {
    .opening,
    .feature {
      column-gap: clamp(2.5rem, 5vw, 6rem);
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .opening {
      align-items: center;
      text-align: left;
    }

    .opening .opening__intro {
      margin-inline: 0;
    }

    .feature h2 {
      font-size: clamp(1.9rem, 2.5vw, 2.75rem);
    }
  }
</style>
