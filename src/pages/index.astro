---
import Layout from '../components/layout/Layout.astro';
import WorkGraphic from '../components/work/WorkGraphic.astro';
import { getWorkStories } from '../lib/workData';
import { getWriting } from '../lib/writingData';
import { featuredSlugs, introduction, workCategory } from '../lib/workEditorial';
const [stories, writing] = await Promise.all([getWorkStories(), getWriting()]);
const featured = featuredSlugs.map(slug => stories.find(story => story.slug === slug)).filter(story => story !== undefined);
const [lead, ...secondary] = featured;
const article = writing.find(entry => entry.href === '/posts/building-a-private-ai-server-for-friends');
---
<Layout title="Hamish Burke" description="Software, small systems, and the decisions behind them. Selected work and writing by Hamish Burke in Wellington.">
  <section class="opening" aria-labelledby="intro-heading">
    <div class="introduction">
      <p class="label">Software developer · Wellington, NZ</p>
      <h1 id="intro-heading">Hamish Burke</h1>
      <p class="intro-copy">I build software, from a coach’s first website to tools I run on my own hardware.</p>
      <p>I’m interested in what makes a system useful, what it takes to keep it running, and when to make it smaller.</p>
      <a class="text-link" href="/about">A little about me <span aria-hidden="true">↗</span></a>
    </div>
    {lead && <article class="lead-feature">
      <a class="visual-link" href={`/work/${lead.slug}`} aria-label={`Explore ${lead.title}`}><img src="/images/work/youinc-demo-dashboard.png" alt="You Inc dashboard showing cashflow, expenses and income using sample data." width="2462" height="1420" fetchpriority="high" /></a>
      <p class="label">Featured work · {workCategory(lead)}</p>
      <h2><a href={`/work/${lead.slug}`}>{lead.title} <span aria-hidden="true">↗</span></a></h2>
      <p>{introduction(lead)}</p>
      <a class="text-link" href={`/work/${lead.slug}`}>Why I took the SaaS layer out <span aria-hidden="true">→</span></a>
    </article>}
  </section>
  <section class="selected" aria-labelledby="selected-heading">
    <div class="section-heading"><h2 id="selected-heading">Two more to explore</h2><a class="text-link" href="/work">All work <span aria-hidden="true">→</span></a></div>
    <div class="secondary-grid">{secondary.map(story => <article>
      <a class="visual-link" href={`/work/${story.slug}`} aria-label={`Explore ${story.title}`}><WorkGraphic kind={story.graphic.kind} alt={story.graphic.alt} /></a>
      <p class="label">{workCategory(story)} · {story.slug === 'home-lab' ? 'Systems & recovery' : 'Design & development'}</p>
      <h3><a href={`/work/${story.slug}`}>{story.title} <span aria-hidden="true">↗</span></a></h3>
      <p>{introduction(story)}</p>
    </article>)}</div>
  </section>
  <section class="notes" aria-label="Writing and life outside work">
    <div>
      <p class="label">From the notebook</p>
      {article ? <><h2><a href={article.href}>{article.title}</a></h2><p>A GPU for friends sounds simple. Here’s what happens when accounts, costs, and a machine that sometimes switches off enter the picture.</p><a class="text-link" href={article.href}>Read the story <span aria-hidden="true">→</span></a></> : <><h2>Notes from building things.</h2><p>Experiments, decisions, and things I’d change next time.</p></>}
      <a class="more-writing" href="/writing">All writing →</a>
    </div>
    <aside>
      <p class="label">Away from the keyboard</p>
      <h2>A little room for other things.</h2>
      <p>I’m trying to make more time for reading, the piano, and being away from a screen.</p>
      <a class="text-link" href="/reading">On my bookshelf <span aria-hidden="true">→</span></a>
    </aside>
  </section>
</Layout>
<style>
.opening { display: grid; gap: 3rem; padding-block: 2rem 4rem; }
h1 { font-size: clamp(3rem, 5vw, 4rem); line-height: 1.04; letter-spacing: -.045em; margin: 1.25rem 0 2rem; }
p { line-height: 1.65; color: var(--color-text-secondary); margin: 1rem 0; font-size: 1.125rem; }
.label { font-size: .75rem; letter-spacing: .06em; color: var(--color-action); margin: 1.5rem 0 .65rem; }
.introduction .label { margin-top: 0; }
.intro-copy { font-size: clamp(1.25rem, 2vw, 1.5rem); line-height: 1.5; color: var(--color-text-primary); }
h2, h3 { font-size: clamp(1.65rem, 3vw, 2.1rem); line-height: 1.2; letter-spacing: -.025em; margin: 0; }
h2 a, h3 a { color: inherit; text-decoration: none; } h2 a:hover, h3 a:hover { color: var(--color-action); }
h2 span, h3 span { color: var(--color-action); font-size: .7em; }
.text-link { font-size: .95rem; color: var(--color-action); font-weight: 550; display: inline-block; padding-block: .65rem; }
.visual-link { display: block; overflow: hidden; border: 1px solid var(--color-stroke-subtle); } .visual-link:hover { opacity: 1; }
.visual-link img { display: block; width: 100%; height: auto; }
.selected { border-top: 1px solid var(--color-stroke-subtle); padding-block: 2rem 4rem; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
.section-heading h2 { font-size: 1.25rem; }
.secondary-grid { display: grid; gap: 3rem; } .secondary-grid :global(.work-graphic) { aspect-ratio: 1.65; min-height: 0; width: 100%; }
.notes { border-top: 1px solid var(--color-stroke-subtle); display: grid; gap: 3rem; padding-block: 2rem 3rem; }
.notes h2 { max-width: 28ch; } .notes aside h2 { font-size: 1.5rem; } .more-writing { display: block; margin-top: .75rem; font-size: .875rem; color: var(--color-text-secondary); }
@media(min-width: 48rem) { .opening { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 3.5rem; padding-block: 3rem 5rem; } .secondary-grid { grid-template-columns: 1.15fr 1fr; } .notes { grid-template-columns: 1.4fr 1fr; gap: 5rem; } }
@media(max-width: 34rem) { .secondary-grid :global(.work-graphic--home-lab) { aspect-ratio: auto; } }
</style>
