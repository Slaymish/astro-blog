---
import Layout from '../components/layout/Layout.astro';
import IconText from '../components/ui/IconText.astro';
import ContactBand from '../components/work/ContactBand.astro';
import IndexRow from '../components/home/IndexRow.astro';
import { getWorkStories } from '../lib/workData';
import { getHomePage } from '../lib/pageContent';
import { getWriting } from '../lib/writingData';
import { buildHomeIndex, foldCount } from '../lib/homeIndex';

const [stories, writing, copy] = await Promise.all([
  getWorkStories(),
  getWriting(),
  getHomePage()
]);

const { fold, indexSection } = copy;
const years = buildHomeIndex(stories, writing);

const counted = foldCount(stories);

// The index bus taps the expanded rows only, so the node names are read back off the
// built rows rather than recomputing the expansion rule a second time.
const busNodes = new Set(
  years.flatMap((year) => year.rows).filter((row) => row.graphic).map((row) => row.key)
);
---

<Layout title={copy.seo.title} description={copy.seo.description}>
  <section class="fold" data-circuit="BUS_01">
    <h1 data-circuit-source>{fold.name}</h1>
    <!-- The annotations are the subtitle. They are nodes on the fold bus, so the
         leader lines the engine draws are what relates them to the name; without
         the pipework they would be three loose fragments. -->
    <ul class="fold__annotations">
      <li data-circuit-node="position" data-circuit-attach="text" data-circuit-flash="underline">
        {fold.position}
      </li>
      <li data-circuit-node="count" data-circuit-attach="text" data-circuit-flash="underline">
        {counted}
      </li>
      <li data-circuit-node="source" data-circuit-attach="text" data-circuit-flash="underline">
        <a
          href={fold.sourceLink.href}
          class="fold__link"
          aria-label={fold.sourceLink.ariaLabel}
          target={fold.sourceLink.external ? '_blank' : undefined}
          rel={fold.sourceLink.external ? 'noopener noreferrer' : undefined}
        >{fold.sourceLink.label}</a>
      </li>
    </ul>
  </section>

  {years.length > 0 && (
    <section class="index" aria-label="Everything, newest first" data-circuit="BUS_02">
      {years.map((year, yearIndex) => (
        <>
          <h2 class="index__year" data-circuit-source={yearIndex === 0 ? true : undefined}>
            {year.year}
          </h2>
          <ul class="index__rows">
            {year.rows.map((row) => (
              <IndexRow row={row} circuitNode={busNodes.has(row.key) ? row.key : undefined} />
            ))}
          </ul>
        </>
      ))}
      <nav class="index__tail" aria-label="Browse everything">
        <a href={indexSection.projectsLink.href}><IconText>{indexSection.projectsLink.label}</IconText></a>
        <a href={indexSection.writingLink.href}><IconText>{indexSection.writingLink.label}</IconText></a>
      </nav>
    </section>
  )}

  <ContactBand heading={copy.contactHeading} />
</Layout>

<style>
  /* The fold carries a name and three facts. Anything longer than a fragment
     belongs in the index below, where it can be dated and measured. */
  .fold {
    align-content: center;
    display: grid;
    gap: clamp(2.5rem, 7vw, 4.5rem);
    min-height: clamp(26rem, calc(70svh - 8rem), 34rem);
    padding-block: var(--hero-top-space) var(--spacing-8);
  }
  .fold h1 {
    font-size: clamp(3.25rem, 11vw, 9rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-display);
    line-height: 0.88;
    margin: 0;
    max-width: 8ch;
  }

  .fold__annotations {
    display: grid;
    gap: var(--spacing-4);
    justify-items: start;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fold__annotations li {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
  }
  /* The one element on the static page allowed the action colour. Everything else
     earns it on hover or focus. */
  .fold__link { color: var(--color-action); }
  .fold__link:hover { color: var(--color-text-primary); }

  .index { border-top: 1px solid var(--color-stroke-subtle); padding-block-start: var(--spacing-10); }
  .index__year {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-heading);
    margin: 0;
    padding-block-end: var(--spacing-4);
  }
  .index__year:not(:first-of-type) { padding-block-start: clamp(3rem, 7vw, 5rem); }
  .index__rows { list-style: none; margin: 0; padding: 0; }
  .index__rows :global(.index-row:last-child) { border-bottom: 1px solid var(--color-stroke-subtle); }

  .index__tail { display: flex; flex-wrap: wrap; gap: var(--spacing-4) var(--spacing-8); padding-block: clamp(2rem, 5vw, 3rem); }
  .index__tail a { color: var(--color-text-primary); font-size: var(--type-body-small); font-weight: var(--font-weight-bold); }
  .index__tail a:hover { color: var(--color-action); }

  @media (min-width: 48rem) {
    .fold { gap: clamp(3rem, 8vw, 6rem); }
    .fold__annotations { gap: var(--spacing-5); padding-inline-start: 4.5rem; }
  }
</style>
