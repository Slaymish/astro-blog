---
import Base from '../../layouts/Base.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import GpuCalculator from '../../components/GpuCalculator.astro';
import RelatedList from '../../components/RelatedList.astro';
import SanityImage from '../../components/SanityImage.astro';
import { sanitySrcSet } from '../../content/images';
import { markdownToHtml, markdownToPlainText, splitAtComponent } from '../../content/markdown';
import { getPosts } from '../../content/queries';
import { readingTime } from '../../content/readingTime';
import { getRelated } from '../../content/related';
import { formatFullDate } from '../../content/writing';
import type { Post } from '../../content/types';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

const html = markdownToHtml(post.markdownBody);
const split = splitAtComponent(html, 'gpu-calculator');
const { minutes } = readingTime(markdownToPlainText(post.markdownBody));
const related = await getRelated({ type: 'post', slug: post.slug, tags: post.tags, related: post.related });
const ogImage = post.coverImage ? sanitySrcSet(post.coverImage, [1200]).src : undefined;
---

<Base
  title={post.title}
  description={post.excerpt}
  image={ogImage}
  article={{ kind: 'post', publishedAt: post.publishedAt, updatedAt: post.updatedAt, tags: post.tags }}
  breadcrumbs={[
    { name: 'Writing', path: '/writing' },
    { name: post.title, path: `/posts/${post.slug}` },
  ]}
>
  <article class="article">
    <ArticleHeader
      eyebrow="Article"
      title={post.title}
      lede={post.excerpt}
      meta={[formatFullDate(post.publishedAt), `${minutes} min read`]}
      tags={post.tags}
      backHref="/writing"
      backLabel="All writing"
    />

    {
      post.coverImage && (
        <div class="article__cover">
          <SanityImage
            image={post.coverImage}
            alt={post.coverImage.alt ?? ''}
            widths={[720, 1200, 1800]}
            sizes="(min-width: 64rem) 60rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }

    {
      split ? (
        <div class="prose article__body">
          <Fragment set:html={split[0]} />
          <GpuCalculator />
          <Fragment set:html={split[1]} />
        </div>
      ) : (
        <div class="prose article__body" set:html={html} />
      )
    }

    <RelatedList entries={related} />
  </article>
</Base>

<style>
  .article {
    margin-inline: auto;
    max-width: var(--reading-width);
  }

  .article__cover {
    border: 1px solid var(--color-stroke-subtle);
    margin-top: var(--spacing-10);
    overflow: hidden;
  }

  .article__cover img {
    border-radius: 0;
    display: block;
    height: auto;
    width: 100%;
  }

  .article__body {
    margin-top: var(--spacing-10);
  }
</style>
