---
import Base from '../../layouts/Base.astro';
import FeedIndex from '../../components/FeedIndex.astro';
import { getFeed, getFeedIndexCopy } from '../../content/feed';

// Netlify owns the redirect. This canonicalised fallback also works locally.
const [entries, copy] = await Promise.all([getFeed(), getFeedIndexCopy()]);
---

<Base title={copy.seo.title} description={copy.seo.description}
  canonicalPath="/work" robots="noindex, follow"
  breadcrumbs={[{ name: copy.navigationLabel, path: '/work' }]}>
  <FeedIndex entries={entries} copy={copy} defaultType="writing" />
</Base>
