---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import EntryList from '../../components/EntryList.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getWritingIndexPage } from '../../content/queries';
import { filterableTags, getWriting, tagSlug } from '../../content/writing';

const [entries, copy] = await Promise.all([getWriting(), getWritingIndexPage()]);
const tags = filterableTags(entries);
const { hero } = copy;
---

<Base
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: 'Writing', path: '/writing' }]}
>
  <PageHeader eyebrow={hero.eyebrow} headline={hero.headlineLines} intro={hero.intro} measure="regular" />

  {
    tags.length > 0 && (
      <div class="writing-filter" id="writing-filter">
        <p id="writing-filter-label">{copy.filterLabel}</p>
        <div class="writing-filter__tags" role="group" aria-labelledby="writing-filter-label">
          <button type="button" class="chip" data-tag="all" aria-pressed="true">All</button>
          {tags.map((tag) => (
            <button type="button" class="chip" data-tag={tagSlug(tag)} aria-pressed="false">
              {tag}
            </button>
          ))}
        </div>
      </div>
    )
  }

  <EntryList entries={entries} />

  <p class="writing-empty" id="writing-empty" hidden={entries.length > 0}>{copy.emptyMessage}</p>

  <aside class="writing-reading">
    <p>
      I keep notes on the books I get through as well, how I came to each one and whatever thought was
      left over at the end, which is closer to thinking out loud than reviewing anything.
    </p>
    <Button href="/reading" variant="secondary">Read my book reflections</Button>
  </aside>
</Base>

<style>
  .writing-filter {
    border-top: 1px solid var(--color-stroke-subtle);
    padding-block: var(--spacing-6);
  }

  .writing-filter p {
    color: var(--color-text-secondary);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0 0 var(--spacing-4);
    text-transform: uppercase;
  }

  .writing-filter__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .writing-empty {
    color: var(--color-text-secondary);
    padding-block: var(--spacing-16);
    text-align: center;
  }

  /* Closing pointer to /reading. One line of copy and one button, sitting under
     the rule the last list item already draws, so it reads as the end of the
     page rather than a card. */
  .writing-reading {
    align-items: start;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding-block: var(--spacing-8);
  }

  .writing-reading p {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    line-height: 1.6;
    margin: 0;
    max-width: 42rem;
  }
</style>
