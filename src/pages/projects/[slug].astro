---
import Layout from "../../components/layout/Layout.astro";
import ParallaxHero from "../../components/features/ParallaxHero.astro";
import { fetchSanity } from "../../lib/sanity";
import { portableTextToHtml } from "../../lib/portableText";
import { legacyRoutePolicy } from "../../lib/legacyRoutes";
import Icon from "../../components/ui/Icon.astro";

type ProjectDoc = {
  title: string;
  description?: string;
  slug: string;
  date?: string;
  technologies?: string[];
  link?: string;
  github?: string;
  body?: any;
  relatedPostSlug?: string;
  relatedPostTitle?: string;
};

export async function getStaticPaths() {
  const slugs = await fetchSanity<string[]>(`*[_type == "project" && defined(slug.current)].slug.current`);
  // Retired slugs are served as 301s/410s from netlify.toml, so skip them here
  // rather than generating pages that are always shadowed by a redirect.
  return slugs
    .filter((slug) => {
      const policy = legacyRoutePolicy('project', slug);
      return policy?.action !== 'redirect' && policy?.action !== 'gone';
    })
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const routePolicy = legacyRoutePolicy('project', slug as string);
if (routePolicy?.action === 'redirect') {
  return Astro.redirect(routePolicy.destination, 301);
}
if (routePolicy?.action === 'gone') {
  return new Response('This project has been archived and is no longer published.', { status: 410 });
}
if (routePolicy?.action === 'unlisted') {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}

const project = await fetchSanity<ProjectDoc | null>(`
  *[_type == "project" && slug.current == $slug][0]{
    title,
    description,
    "slug": slug.current,
    date,
    technologies,
    link,
    github,
    body,
    "relatedPostSlug": relatedPost->slug.current,
    "relatedPostTitle": relatedPost->title
  }
`, { slug });

if (!project) {
  return Astro.redirect('/404');
}

const projectTitle = project.title;
const projectDescription = project.description;
const technologies = project.technologies || [];
const link = project.link;
const github = project.github;
const relatedPostSlug = project.relatedPostSlug;
const relatedPostTitle = project.relatedPostTitle;
const htmlContent = portableTextToHtml(project.body);
---

<Layout
  title={`${projectTitle} | Project`}
  description={projectDescription}
  fullWidth
>
  <ParallaxHero
    title={projectTitle}
    subtitle={projectDescription}
    label="Project"
    date={project.date}
    tags={technologies}
    titleTransitionName={`title-projects-${project.slug}`}
    backHref="/work"
    backLabel="Work"
  />

  <!-- Action bar -->
  <div class="proj-actions" data-reveal>
    <div class="proj-actions__inner">
      {relatedPostSlug && (
        <a href={`/posts/${relatedPostSlug}`} class="proj-btn proj-btn--primary">
          Read the write-up
          <Icon name="arrow-right" />
        </a>
      )}
      {link && (
        <a href={link} target="_blank" rel="noopener noreferrer" class="proj-btn">
          Live Demo
          <Icon name="arrow-up-right" />
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="proj-btn">
          GitHub
          <Icon name="arrow-up-right" />
        </a>
      )}
    </div>
  </div>

  <!-- Body content -->
  {htmlContent && (
    <article class="proj-body" data-reveal>
      <div class="prose" set:html={htmlContent}></div>
    </article>
  )}

  <!-- Related post callout -->
  {relatedPostSlug && (
    <div class="proj-related" data-reveal>
      <div class="proj-related__inner" data-icon-hover>
        <span class="proj-related__label">Related article</span>
        <h3 class="proj-related__title">
          <a href={`/posts/${relatedPostSlug}`}>{relatedPostTitle || 'Read the write-up'}</a>
        </h3>
        <Icon name="arrow-right" class="proj-related__arrow" />
      </div>
    </div>
  )}

  <!-- Footer nav -->
  <nav class="proj-footer" data-reveal aria-label="Project navigation">
    <a href="/work" class="proj-footer__link">
      <Icon name="arrow-left" />
      All work
    </a>
  </nav>
</Layout>

<style>
  /* ── Action bar ── */
  .proj-actions {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 0;
  }

  @media (min-width: 640px) {
    .proj-actions { padding: 3rem 2rem 0; }
  }

  .proj-actions__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .proj-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .proj-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .proj-btn::after {
    display: none !important;
  }

  .proj-btn--primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .proj-btn--primary:hover {
    opacity: 0.9;
    color: #fff;
  }

  /* ── Body ── */
  .proj-body {
    max-width: var(--reading-width, 65ch);
    margin: 3rem auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .proj-body {
      margin: 4rem auto;
      padding: 0 2rem;
    }
  }

  .proj-body .prose {
    max-width: none;
  }

  /* ── Related post ── */
  .proj-related {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .proj-related { padding: 0 2rem; }
  }

  .proj-related__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease;
  }

  .proj-related__inner:hover {
    border-color: var(--accent);
  }

  .proj-related__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    white-space: nowrap;
  }

  .proj-related__title {
    flex: 1;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text);
  }

  .proj-related__title a {
    color: inherit;
    text-decoration: none;
    border-bottom: none;
  }

  .proj-related__title a::after {
    display: none !important;
  }

  .proj-related__title a:hover {
    color: var(--accent);
  }

  .proj-related__arrow {
    color: var(--text-muted);
    font-size: 1.25rem;
  }

  .proj-related__inner:hover .proj-related__arrow {
    color: var(--accent);
  }

  /* ── Footer nav ── */
  .proj-footer {
    max-width: var(--content-max-width);
    margin: 3rem auto 0;
    padding: 2rem 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .proj-footer { padding: 3rem 2rem 0; }
  }

  .proj-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .proj-footer__link:hover {
    color: var(--accent);
  }

  .proj-footer__link::after {
    display: none !important;
  }

</style>
