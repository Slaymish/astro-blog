---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import IconText from '../components/IconText.astro';
import { getAboutPage } from '../content/queries';
import { portableTextToHtml } from '../content/portableText';
import headshot from '../assets/images/headshot.jpg';

const copy = await getAboutPage();
const { background } = copy;
const largeCopy = portableTextToHtml(copy.largeCopy);
---

<Base
  title={copy.seo.title}
  description={copy.seo.description}
  breadcrumbs={[{ name: 'About', path: '/about' }]}
>
  <article class="about">
    <section class="about__opening" aria-labelledby="about-heading">
      <div>
        <h1 id="about-heading">{copy.heading}</h1>
        <p>{copy.intro}</p>
        {largeCopy && <Fragment set:html={largeCopy} />}
      </div>
      <div class="about__portrait">
        <Image
          src={headshot}
          alt={copy.portraitAlt}
          widths={[400, 800, 1200]}
          sizes="(min-width: 48rem) 22rem, 100vw"
          loading="eager"
        />
      </div>
    </section>

    <section class="about__experiences" aria-label="Two projects">
      {
        copy.projects.map((project) => (
          <div>
            <h2>{project.heading}</h2>
            <p>{project.body}</p>
            <a
              href={project.link.href}
              target={project.link.external ? '_blank' : undefined}
              rel={project.link.external ? 'noopener noreferrer' : undefined}
            >
              <IconText icon={project.link.external ? 'arrow-up-right' : 'arrow-right'}>
                {project.link.label}
              </IconText>
            </a>
          </div>
        ))
      }
    </section>

    <section class="about__background" aria-labelledby="background-heading">
      <p class="about__label">{background.label}</p>
      <div>
        <h2 id="background-heading">{background.heading}</h2>
        {background.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <nav aria-label="About links">
          {
            background.links.map((link) => (
              <a
                href={link.href}
                aria-label={link.ariaLabel}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                <IconText icon={link.external ? 'arrow-up-right' : 'arrow-right'}>{link.label}</IconText>
              </a>
            ))
          }
        </nav>
      </div>
    </section>
  </article>
</Base>

<style>
  .about__opening {
    align-items: center;
    display: grid;
    gap: var(--spacing-8);
    padding-block: var(--hero-top-space) var(--spacing-16);
  }

  h1 {
    font-size: var(--type-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    margin: var(--spacing-4) 0 var(--spacing-8);
  }

  .about__label {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  p,
  .about__opening :global(p) {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 65ch;
  }

  .about__portrait {
    border: 1px solid var(--color-stroke-subtle);
    max-width: 22rem;
    overflow: hidden;
  }

  .about__portrait :global(img) {
    border-radius: 0;
    display: block;
    height: auto;
    width: 100%;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
    letter-spacing: var(--tracking-heading);
    line-height: 1.25;
  }

  a {
    --icon-gap: var(--spacing-2);
    color: var(--color-action);
    text-decoration: none;
  }

  .about__experiences {
    border-top: 1px solid var(--color-stroke-subtle);
    display: grid;
    gap: var(--spacing-8);
    padding-block: var(--spacing-8) var(--spacing-16);
  }

  .about__background {
    border-top: 1px solid var(--color-stroke-subtle);
    padding-block: var(--spacing-8);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-6);
    margin-top: var(--spacing-8);
  }

  @media (min-width: 48rem) {
    .about__opening {
      gap: 5rem;
      grid-template-columns: 1.5fr 1fr;
    }

    .about__experiences {
      gap: var(--spacing-16);
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
