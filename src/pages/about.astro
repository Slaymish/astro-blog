---
import Layout from '../components/layout/Layout.astro';
import MediaFrame from '../components/ui/MediaFrame.astro';
import { getAboutPage } from '../lib/pageContent';
import { portableTextToHtml } from '../lib/portableText';
import { SITE_URL, absoluteUrl } from '../lib/site';

const copy = await getAboutPage();
const { hero, portrait, background } = copy;
const largeCopyHtml = portableTextToHtml(portrait.largeCopy);
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  canonicalURL={absoluteUrl('/about', SITE_URL)}
>
  <article class="about">
    <section class="about__opening" aria-labelledby="about-heading">
      <div><p class="about__label">About</p><h1 id="about-heading">Hi, I’m Hamish.</h1><p>{hero.intro}</p><div set:html={largeCopyHtml} /></div>
      <MediaFrame src="/images/headshot.jpg" alt={portrait.imageAlt} width={3264} height={4896} ratio="portrait" position="center top" loading="eager" />
    </section>
    <section class="about__experiences" aria-label="Two projects">
      <div><h2>Taking the SaaS layer out of You Inc</h2><p>I built the accounts, plans and billing around You Inc, then took them back out. Running a finance service meant taking responsibility for other people’s bank credentials. A tool people could run themselves made more sense.</p><a href="/work/you-inc">The You Inc story →</a></div>
      <div><h2>Running a server at home</h2><p>A home server and a shared GPU keep giving me concrete questions to work through: how to recover a machine, who can reach it, and what happens when it switches off.</p><a href="/work/home-lab">Testing a full recovery →</a></div>
    </section>

    <section class="about__background" aria-labelledby="background-heading">
      <p class="about__label">{background.label}</p>
      <div>
        <h2 id="background-heading">{background.heading}</h2>
        {background.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <nav aria-label="About links">
          {background.links.filter(link => link.href !== '/projects').map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </section>
  </article>


  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': absoluteUrl('/#person', SITE_URL),
    name: 'Hamish Burke',
    url: absoluteUrl('/', SITE_URL),
    image: absoluteUrl('/images/headshot.jpg', SITE_URL),
    jobTitle: 'Web Developer',
    worksFor: { '@type': 'Organization', name: 'Alphero', url: 'https://www.alphero.com/' },
    alumniOf: { '@type': 'EducationalOrganization', name: 'Victoria University of Wellington', sameAs: 'https://www.wgtn.ac.nz' },
    knowsAbout: ['Software Engineering', 'Artificial Intelligence', 'Distributed Systems', 'System Architecture', 'Full-Stack Development'],
    sameAs: ['https://github.com/Slaymish', 'https://www.linkedin.com/in/hamish-burke-2301669a'],
    mainEntityOfPage: { '@type': 'ProfilePage', '@id': absoluteUrl('/about', SITE_URL) }
  })} />
</Layout>

<style>
.about__opening { display: grid; gap: 2rem; padding-block: 1.5rem 4rem; align-items: center; }
h1 { font-size: var(--type-display); letter-spacing: -.035em; line-height: 1.05; margin: 1rem 0 2rem; }
.about__label { font-size: .75rem; color: var(--color-text-secondary); }
p, .about__opening :global(p) { font-size: 1.125rem; line-height: 1.7; color: var(--color-text-secondary); max-width: 65ch; }
.about__opening :global(.media-frame) { max-width: 22rem; }
h2 { font-size: clamp(1.6rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -.025em; }
a { color: var(--color-action); }
.about__experiences { display: grid; gap: 2rem; border-top: 1px solid var(--color-stroke-subtle); padding-block: 2rem 4rem; }
.about__background { border-top: 1px solid var(--color-stroke-subtle); padding-block: 2rem; }
nav { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
@media(min-width: 48rem) { .about__opening { grid-template-columns: 1.5fr 1fr; gap: 5rem; } .about__experiences { grid-template-columns: 1fr 1fr; gap: 4rem; } }
</style>
