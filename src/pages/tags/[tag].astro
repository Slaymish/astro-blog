---
import { feedMetadataEntries } from '../../content/metadata';
import Base from '../../layouts/Base.astro';
import FeedList from '../../components/FeedList.astro';
import IconText from '../../components/IconText.astro';
import { feedTags, getFeed, getFeedIndexCopy, type FeedEntry } from '../../content/feed';
import { tagSlug } from '../../content/writing';

export async function getStaticPaths() {
  const entries = await getFeed();
  return feedTags(entries).map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, entries: entries.filter((entry) => entry.tags.some((topic) => tagSlug(topic) === tagSlug(tag))) },
  }));
}

interface Props { tag: string; entries: FeedEntry[] }
const { tag, entries } = Astro.props;
const copy = await getFeedIndexCopy();
---

<Base pageType="CollectionPage" topics={[tag]}
  collections={[{ id: 'entries', name: tag, entries: feedMetadataEntries(entries) }]} title={`${copy.navigationLabel}: ${tag}`} description={copy.seo.description}
  breadcrumbs={[
    { name: copy.navigationLabel, path: '/work' },
    { name: tag, path: `/tags/${tagSlug(tag)}` },
  ]}>
  <header class="tag-header">
    <a class="tag-header__back" href="/work">
      <IconText icon="arrow-left" position="start">{copy.navigationLabel}</IconText>
    </a>
    <h1>{tag}</h1>
    <p class="tag-header__count">{entries.length} {copy.resultsLabel}</p>
  </header>
  <FeedList entries={entries} copy={copy} />
</Base>

<style>
  .tag-header { padding-block: var(--hero-top-space) var(--spacing-10); }
  .tag-header__back {
    --icon-gap: var(--spacing-2);
    color: var(--color-text-secondary);
    display: inline-block;
    font-size: var(--type-body-small);
    margin-bottom: var(--spacing-8);
    text-decoration: none;
  }
  .tag-header__back:hover { color: var(--color-action); }
  .tag-header h1 {
    font-size: var(--type-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    margin: 0;
  }
  .tag-header__count {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    margin: var(--spacing-5) 0 0;
  }
</style>
