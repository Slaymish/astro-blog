---
import { NEW_TAB_NOTE_ID } from '../site/config';
import {
  DEFAULT_INPUTS,
  FX_DATE,
  FX_SOURCE,
  MODELS,
  PRESETS,
  RATE_RANGE,
  describe,
} from '../client/gpuCalculator';

// Built with the default inputs, so the figures are right before the script
// runs and stay right for a visitor whose script never does.
const initial = describe(DEFAULT_INPUTS);
---

<div class="calc not-prose" data-gpu-calculator>
  <h3>GPUShare cost calculator</h3>
  <p class="calc__lede">See what local inference actually costs on a 5070 Ti against cloud APIs.</p>

  <div class="calc__controls">
    <div class="field calc__control calc__control--wide">
      <label class="field__label" for="calc-model">Model</label>
      <span class="select">
        <select id="calc-model" class="input input--sm" data-input="model">
          {
            MODELS.map((model, index) => (
              <option value={index}>
                {model.name} - {model.vram}, ~{model.tokPerSec} tok/s - {model.quality}
              </option>
            ))
          }
        </select>
      </span>
    </div>

    <div class="field calc__control">
      <label class="field__label" for="calc-tokens">
        Tokens per response: <span class="calc__value" data-result="tokens">{initial['tokens']}</span>
      </label>
      <input
        id="calc-tokens"
        class="range"
        type="range"
        min="50"
        max="4000"
        step="50"
        value="500"
        aria-valuetext={`${initial.tokens} tokens`}
        data-input="tokens"
      />
      <div class="calc__scale"><span>50</span><span>4,000</span></div>
    </div>

    <div class="field calc__control">
      <label class="field__label" for="calc-responses">
        Responses per day: <span class="calc__value" data-result="responses">{initial['responses']}</span>
      </label>
      <input
        id="calc-responses"
        class="range"
        type="range"
        min="1"
        max="500"
        step="1"
        value="50"
        aria-valuetext={`${initial.responses} responses`}
        data-input="responses"
      />
      <div class="calc__scale"><span>1</span><span>500</span></div>
    </div>

    <div class="field calc__control calc__control--wide">
      <div class="calc__rate-head">
        <label class="field__label" id="calc-rate-label" for="calc-rate-field">
          Electricity rate: <span class="calc__value" data-result="rate">{initial['rate']}</span>
        </label>
        <div class="calc__presets">
          {
            Object.keys(PRESETS).map((label) => (
              <button type="button" class="chip" data-preset={label} aria-pressed={label === 'NZ'}>
                {label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="calc__rate-inputs">
        <div class="calc__rate-slider">
          <input
            id="calc-rate"
            class="range"
            type="range"
            min={RATE_RANGE.min}
            max={RATE_RANGE.max}
            step={RATE_RANGE.step}
            value={DEFAULT_INPUTS.electricityRate}
            aria-labelledby="calc-rate-label"
            aria-valuetext={initial.rate}
            data-input="rate"
          />
          <div class="calc__scale"><span data-result="rate-min">{initial['rate-min']}</span><span data-result="rate-max">{initial['rate-max']}</span></div>
        </div>
        <input
          id="calc-rate-field"
          class="input input--sm calc__rate-field"
          type="number"
          inputmode="decimal"
          min={RATE_RANGE.min}
          max={RATE_RANGE.max}
          step={RATE_RANGE.step}
          value={DEFAULT_INPUTS.electricityRate}
          data-input="rate-field"
        />
      </div>
    </div>
  </div>

  <div class="calc__results">
    <div class="calc__result">
      <p class="calc__result-label">Per response</p>
      <p class="calc__result-value" data-result="per-response">{initial['per-response']}</p>
    </div>
    <div class="calc__result">
      <p class="calc__result-label">Daily</p>
      <p class="calc__result-value" data-result="daily">{initial['daily']}</p>
    </div>
    <div class="calc__result">
      <p class="calc__result-label">Monthly</p>
      <p class="calc__result-value" data-result="monthly">{initial['monthly']}</p>
    </div>
    <div class="calc__result calc__result--accent">
      <p class="calc__result-label">vs cloud</p>
      <p class="calc__result-value" data-result="multiplier">{initial['multiplier']}</p>
    </div>
  </div>

  <div class="calc__comparison">
    <p>
      Cloud equivalent (<span data-result="cloud-provider">{initial['cloud-provider']}</span>):
      <strong data-result="cloud-monthly">{initial['cloud-monthly']}</strong>
    </p>
    <p>
      Local (<span data-result="local-model">{initial['local-model']}</span>):
      <strong class="calc__accent" data-result="local-monthly">{initial['local-monthly']}</strong>
    </p>
  </div>

  <p class="sr-only" role="status" data-calc-announce></p>
  <p class="calc__footnote" data-result="footnote">{initial['footnote']}</p>
  <p class="calc__footnote">
    <span data-result="exchange-rate">{initial['exchange-rate']}</span>
    · <a href={FX_SOURCE} target="_blank" aria-describedby={NEW_TAB_NOTE_ID} rel="noopener noreferrer">ECB reference rates</a>
    · {FX_DATE}
  </p>
</div>

<script>
  import { initGpuCalculator } from '../client/gpuCalculator';

  document.querySelectorAll<HTMLElement>('[data-gpu-calculator]').forEach(initGpuCalculator);
</script>

<style>
  .calc {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-stroke-subtle);
    border-radius: var(--radius-lg);
    margin-block: var(--spacing-10);
    padding: var(--spacing-5);
  }

  .calc h3 {
    font-size: var(--type-body);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-1);
  }

  .calc__lede {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    margin: 0 0 var(--spacing-6);
  }

  .calc__controls {
    display: grid;
    gap: var(--spacing-5);
  }

  .calc__value {
    color: var(--color-action);
    font-family: var(--font-mono);
  }

  .calc__rate-inputs {
    align-items: start;
    display: flex;
    gap: var(--spacing-3);
  }

  .calc__rate-slider {
    flex: 1 1 auto;
    min-width: 0;
  }

  .calc__rate-field {
    flex: none;
    inline-size: 6.5rem;
  }

  .calc__scale {
    color: var(--color-text-secondary);
    display: flex;
    font-size: var(--type-label);
    justify-content: space-between;
  }

  .calc__rate-head {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    justify-content: space-between;
  }

  .calc__presets {
    display: flex;
    gap: var(--spacing-3) var(--spacing-2);
  }

  .calc__results {
    display: grid;
    gap: var(--spacing-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--spacing-6);
  }

  .calc__result {
    background: var(--color-bg-canvas);
    border: 1px solid var(--color-stroke-subtle);
    border-radius: var(--radius-sm);
    padding: var(--spacing-3);
    text-align: center;
  }

  .calc__result--accent {
    border-color: var(--color-action);
  }

  .calc__result-label {
    color: var(--color-text-secondary);
    font-size: var(--type-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    margin: 0;
    text-transform: uppercase;
  }

  .calc__result-value {
    font-family: var(--font-mono);
    font-size: var(--type-body);
    font-weight: var(--font-weight-semibold);
    margin: var(--spacing-1) 0 0;
  }

  .calc__result--accent .calc__result-value {
    color: var(--color-action);
  }

  .calc__comparison {
    background: var(--color-bg-canvas);
    border: 1px solid var(--color-stroke-subtle);
    border-radius: var(--radius-sm);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2) var(--spacing-6);
    justify-content: space-between;
    margin-top: var(--spacing-4);
    padding: var(--spacing-3) var(--spacing-4);
  }

  .calc__comparison p {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    margin: 0;
  }

  .calc__comparison strong {
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-weight: var(--font-weight-medium);
  }

  .calc__accent {
    color: var(--color-action);
  }

  .calc__footnote {
    color: var(--color-text-secondary);
    font-size: var(--type-label);
    line-height: 1.6;
    margin: var(--spacing-3) 0 0;
  }

  @media (min-width: 40rem) {
    .calc {
      padding: var(--spacing-6);
    }

    .calc__controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .calc__control--wide {
      grid-column: 1 / -1;
    }

    .calc__results {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
