---
import Button from './Button.astro';
import ContactForm from './ContactForm.astro';
import { getSiteSettings } from '../content/queries';
import { BOOKING_URL, CONTACT_EMAIL } from '../site/config';

interface Props {
  heading?: string;
  /** Only the pages that are actually about engaging Hamish show the booking button. */
  booking?: boolean;
}

const { heading, booking = false } = Astro.props;

const { contactBand } = await getSiteSettings();
const bandHeading = heading ?? contactBand.defaultHeading;
---

<aside class="contact-band" aria-labelledby="contact-band-heading">
  <div>
    <h2 id="contact-band-heading">{bandHeading}</h2>
  </div>
  <div class="contact-band__actions">
    {contactBand.form && <ContactForm copy={contactBand.form} inline />}
    <div class="contact-band__alternatives">
      {
        booking ? (
          <Button href={BOOKING_URL} external variant="ghost">
            {contactBand.bookingLabel}
          </Button>
        ) : (
          <Button href="/contact" variant="ghost">{contactBand.contactLabel}</Button>
        )
      }
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </div>
</aside>

<style>
  .contact-band {
    display: grid;
    gap: var(--spacing-8);
    margin-block: clamp(4rem, 10vw, 9rem) 0;
    padding-block: var(--band-inset);
    max-width: 48rem;
  }

  .contact-band h2 {
    font-size: var(--type-heading-2);
    letter-spacing: var(--tracking-heading);
    margin: 0;
    max-width: 22ch;
  }

  .contact-band__actions {
    display: grid;
    gap: var(--spacing-6);
  }

  .contact-band__alternatives {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3) var(--spacing-8);
  }

  .contact-band__alternatives > a:last-child {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
  }
</style>
