---
/**
 * One answer, six ways of putting it on screen, with the layout cost of each
 * measured live rather than asserted.
 *
 * The paragraph is rendered here at build time, so a reader without JavaScript
 * gets the whole answer as ordinary prose. The script only takes it apart again.
 *
 * The numbers are real measurements of this page: a reflow is counted as a
 * change in the stage's height while the text is arriving, timed with
 * performance.now() from the first frame of a run to the last unit placed.
 */
interface Props {
  text?: string;
}

const {
  text = 'The library on the corner shut in 2019 and the building sat empty for three years, until a group of neighbours raised enough between them to reopen it as a tool library. You can borrow a drill or a ladder for a week instead of buying one, which is how most of them get used once or twice and then sit in a garage. The whole thing runs on two retired librarians and a rota they keep in a spreadsheet.',
} = Astro.props;

const baseTokenRate = Math.ceil(text.length / 4) / 4;

const MODES = [
  { id: 'stream', label: 'Characters' },
  { id: 'hybrid', label: 'Hybrid' },
  { id: 'words', label: 'Words' },
  { id: 'chunks', label: 'Chunks' },
  { id: 'sentences', label: 'Sentences' },
  { id: 'held', label: 'Held' },
];
---

<section class="reveal" data-reveal-demo aria-labelledby="reveal-title">
  <div class="reveal__head">
    <h2 id="reveal-title">How the answer gets drawn</h2>
    <p class="reveal__note">
      Measured in this page as you watch it. A reflow is a change in the height of the answer while
      it arrives, which is what moves a line out from under someone reading it. The seconds are the
      animation's own clock, not a model's.
    </p>
  </div>

  <div class="reveal__modes" role="group" aria-label="How the answer arrives">
    {
      MODES.map((mode, index) => (
        <button
          type="button"
          class="reveal__mode"
          data-mode={mode.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {mode.label}
        </button>
      ))
    }
  </div>

  <div class="reveal__run">
    <label class="reveal__speed">
      <span class="sr-only">Simulated tokens per second (four characters per token)</span>
      <span class="reveal__speed-shell">
        <input
          class="reveal__speed-input"
          type="range"
          min={baseTokenRate / 4}
          max={baseTokenRate * 2}
          step={baseTokenRate / 4}
          value={baseTokenRate}
          data-speed
        />
      </span>
      <span class="reveal__speed-value" data-speed-value aria-hidden="true" title="Simulated rate: four characters per token">{baseTokenRate} tok/s</span>
    </label>

    <div class="reveal__stage" data-stage>
      <p class="reveal__answer" data-answer>{text}</p>
    </div>
  </div>

  <p class="reveal__metrics" aria-live="polite">
    <span class="reveal__metric"><span data-metric="reflows">0</span> reflows</span>
    <span class="reveal__metric"><span data-metric="first">0.0</span> s to first text</span>
    <span class="reveal__metric"><span data-metric="time">0.0</span> s to full text</span>
    <span class="reveal__metric" data-metric="partial">nothing partial on screen</span>
  </p>
</section>

<style>
  .reveal {
    border-top: 1px solid var(--color-stroke-subtle);
    margin-block: var(--spacing-12);
    padding-top: var(--spacing-6);
  }

  .reveal__head {
    max-width: 46rem;
  }

  .reveal__head h2 {
    font-size: var(--type-heading-3);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-3);
  }

  .reveal__note {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    line-height: 1.6;
    margin: 0;
    max-width: 44rem;
  }

  .reveal__modes {
    display: grid;
    gap: var(--spacing-2);
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    margin-block: var(--spacing-6) var(--spacing-5);
  }

  @media (max-width: 34rem) {
    .reveal__modes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .reveal__mode {
    appearance: none;
    background: transparent;
    border: 1px solid var(--color-stroke-subtle);
    border-radius: 0;
    color: var(--color-text-secondary);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.02em;
    min-block-size: var(--control-height-sm, 2.25rem);
    padding-inline: var(--spacing-2);
    text-align: center;
    text-overflow: ellipsis;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
    white-space: nowrap;
  }

  /* Hover reads as "this is pressable", the pressed state as "this is the one
     showing", and the two never rely on colour alone: the border gains a second
     inset ring so it stays legible at the contrast the palette allows. */
  .reveal__mode:hover {
    background-color: var(--color-bg-raised);
    border-color: var(--color-stroke-strong);
    color: var(--color-text-primary);
  }

  .reveal__mode:focus-visible {
    border-color: var(--color-action);
    color: var(--color-text-primary);
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }

  .reveal__mode[aria-pressed='true'] {
    background-color: var(--color-bg-raised);
    border-color: var(--color-action);
    box-shadow: inset 0 0 0 1px var(--color-action);
    color: var(--color-text-primary);
  }

  .reveal__mode[aria-pressed='true']:hover {
    color: var(--color-text-primary);
  }

  .reveal__run {
    align-items: stretch;
    display: flex;
    gap: var(--spacing-3);
  }

  .reveal__speed {
    align-items: center;
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--spacing-2);
    justify-content: center;
    width: 1.75rem;
  }

  /* The control is laid out horizontally and turned upright. writing-mode on a
     range input is not honoured in every engine, and a rotation gives the same
     result everywhere: 0.25x at the bottom, 2x at the top. */
  .reveal__speed-shell {
    align-items: center;
    block-size: 6.5rem;
    display: flex;
    inline-size: 1.75rem;
    justify-content: center;
    overflow: hidden;
  }

  /* The hit area is the whole 28 by 104 box, so a thumb-sized target clears the
     24px minimum even though the track is drawn 2px wide. */
  .reveal__speed-input {
    appearance: none;
    background: transparent;
    block-size: 1.75rem;
    cursor: pointer;
    inline-size: 6.5rem;
    transform: rotate(-90deg);
  }

  .reveal__speed-input::-webkit-slider-runnable-track {
    background: var(--color-stroke-strong);
    block-size: 2px;
  }

  .reveal__speed-input::-webkit-slider-thumb {
    appearance: none;
    background: var(--color-action);
    block-size: 0.875rem;
    inline-size: 0.875rem;
    margin-block-start: -6px;
  }

  .reveal__speed-input::-moz-range-track {
    background: var(--color-stroke-strong);
    block-size: 2px;
  }

  .reveal__speed-input::-moz-range-thumb {
    background: var(--color-action);
    border: 0;
    block-size: 0.875rem;
    inline-size: 0.875rem;
  }

  .reveal__speed-input:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 4px;
  }

  .reveal__speed-value {
    text-align: center;
    line-height: 1.3;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-variant-numeric: tabular-nums;
  }

  .reveal__stage {
    border-left: 1px solid var(--color-stroke-subtle);
    flex: 1;
    min-block-size: 9.5rem;
    padding-left: var(--spacing-5);
  }

  .reveal__answer {
    color: var(--color-text-primary);
    font-size: var(--type-body);
    line-height: 1.75;
    margin: 0;
  }

  .reveal__metrics {
    color: var(--color-text-secondary);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    gap: var(--spacing-2) var(--spacing-5);
    margin-block: var(--spacing-5) 0;
  }

  .reveal__metric {
    font-variant-numeric: tabular-nums;
  }

  .reveal__metric [data-metric] {
    color: var(--color-text-primary);
  }

  .reveal__stage {
    position: relative;
  }

  .reveal :global(.reveal__wait) {
    display: block;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    left: var(--spacing-5);
    margin: 0;
    position: absolute;
    top: 0;
  }

  :global(.sr-lead) {
    font-size: var(--type-lead);
    line-height: 1.5;
    margin: 0 0 var(--spacing-3);
  }

  :global(.sr-rest) {
    margin: 0;
  }

  /* Reveal units are created by the script, so these rules cannot be scoped. */
  :global(.sr-unit) {
    display: inline-block;
    max-width: 100%;
    filter: blur(3px);
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity 260ms cubic-bezier(0.22, 0.68, 0.24, 1),
      transform 320ms cubic-bezier(0.22, 0.68, 0.24, 1),
      filter 280ms linear;
  }

  :global(.sr-unit--chunk) {
    transition:
      opacity 300ms ease-out,
      transform 340ms cubic-bezier(0.22, 0.68, 0.24, 1),
      filter 300ms linear;
  }

  :global(.sr-unit--sentence) {
    display: inline;
    transform: none;
    filter: blur(2px);
    transition:
      opacity 380ms ease,
      filter 420ms ease;
  }

  :global(.sr-unit.is-in) {
    filter: none;
    opacity: 1;
    transform: none;
  }

  :global(.sr-caret) {
    animation: sr-blink 1.05s steps(1, end) infinite;
    background: var(--color-action);
    display: inline-block;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.12em;
    width: 2px;
  }

  @keyframes sr-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.sr-unit) {
      filter: none;
      opacity: 1;
      transform: none;
      transition-duration: 1ms;
    }

    :global(.sr-caret) {
      animation: none;
    }
  }
</style>

<script>
  import { completionOffsets, hybridPhases, sentencesOf } from '../client/stream-arrival';
  let speed = 1;
  let current = 'stream';
  let started = false;

  // Words that start a new idea rather than continue one, so a chunk breaks
  // before them. A chunk is roughly what a reader takes in at a glance while
  // skimming, which is why it is not a fixed number of words and never ends on
  // "the" or "of".
  const OPENS = new Set([
    'and', 'but', 'so', 'or', 'until', 'which', 'where', 'when', 'because',
    'that', 'while', 'though', 'then', 'instead', 'as',
  ]);

  const HOLDS = new Set([
    'the', 'a', 'an', 'of', 'in', 'on', 'at', 'for', 'with', 'by', 'from',
    'between', 'to', 'you',
  ]);

  // Deterministic, so a replay chunks the answer the same way twice.
  const spread = (index: number) => (index * 2654435761) % 4294967296;

  function chunksOf(text: string): string[] {
    const words = text.split(/\s+/).filter(Boolean);
    const out: string[] = [];
    let current: string[] = [];

    words.forEach((word, index) => {
      current.push(word);
      const next = (words[index + 1] ?? '').replace(/[^a-z]/gi, '').toLowerCase();
      const endsClause = /[,;:.!?]$/.test(word);
      const target = 3 + (spread(index) % 4);
      const tooWide = current.length >= 7 || current.join(' ').length >= 30;

      if (!(endsClause || OPENS.has(next) || current.length >= target || tooWide)) return;

      const trails = HOLDS.has(word.replace(/[^a-z]/gi, '').toLowerCase());
      if (!endsClause && trails && current.length < 7 && next && !OPENS.has(next)) return;

      out.push(current.join(' '));
      current = [];
    });

    if (current.length) out.push(current.join(' '));

    // A chunk that is a single connective ("and", "or") reads as a stumble, so
    // it joins the chunk in front unless the one before it ended a sentence.
    return out.reduce<string[]>((merged, chunk) => {
      const previous = merged[merged.length - 1];
      if (previous && chunk.split(' ').length === 1 && !/[.!?]$/.test(previous)) {
        merged[merged.length - 1] = `${previous} ${chunk}`;
      } else {
        merged.push(chunk);
      }
      return merged;
    }, []);
  }

  function init(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const answer = root.querySelector<HTMLElement>('[data-answer]')!;
    const reflowOut = root.querySelector<HTMLElement>('[data-metric="reflows"]')!;
    const firstOut = root.querySelector<HTMLElement>('[data-metric="first"]')!;
    const timeOut = root.querySelector<HTMLElement>('[data-metric="time"]')!;
    const partialOut = root.querySelector<HTMLElement>('[data-metric="partial"]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];

    if (!stage || !answer || !reflowOut || !firstOut || !timeOut || !partialOut) return;

    const source = (answer.textContent ?? '').trim();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let timers: number[] = [];
    let observer: ResizeObserver | null = null;
    let reflows = 0;
    let lastHeight = 0;
    let startedAt = 0;
    let finished = false;
    let ticker: number | null = null;
    let touched = false;
    let firstMarked = false;

    // The moment the first glyph becomes visible. It is what a reader feels as
    // "the answer is there", and the number that separates a fast start from a
    // fast arrival: Characters wins it and the buffered views cannot.
    const markFirst = () => {
      if (firstMarked) return;
      firstMarked = true;
      firstOut.textContent = ((performance.now() - startedAt) / 1000).toFixed(1);
    };

    const clear = () => {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
      if (ticker !== null) window.clearInterval(ticker);
      ticker = null;
      observer?.disconnect();
      observer = null;
    };

    const cue = (fn: () => void, ms: number) => {
      timers.push(window.setTimeout(fn, Math.max(0, ms / speed)));
    };

    const startClock = () => {
      startedAt = performance.now();
      finished = false;
      reflows = 0;
      firstMarked = false;
      lastHeight = answer.getBoundingClientRect().height;
      reflowOut.textContent = '0';
      firstOut.textContent = '0.0';
      timeOut.textContent = '0.0';
      if (ticker !== null) window.clearInterval(ticker);
      ticker = window.setInterval(() => {
        if (finished) return;
        timeOut.textContent = ((performance.now() - startedAt) / 1000).toFixed(1);
      }, 100);

      observer = new ResizeObserver(() => {
        // The stage holds a fixed minimum height so the page does not jump, so
        // the thing that actually moves is the paragraph inside it.
        const height = answer.getBoundingClientRect().height;
        if (Math.abs(height - lastHeight) >= 1) {
          reflows += 1;
          lastHeight = height;
          reflowOut.textContent = String(reflows);
        }
      });
      observer.observe(answer);
    };

    const stopClock = () => {
      if (finished) return;
      finished = true;
      if (ticker !== null) window.clearInterval(ticker);
      ticker = null;
      observer?.disconnect();
      observer = null;
      timeOut.textContent = ((performance.now() - startedAt) / 1000).toFixed(1);
    };

    const unit = (word: string, cls = '') => {
      const span = document.createElement('span');
      span.className = `sr-unit${cls ? ` ${cls}` : ''}`;
      span.textContent = word;
      return span;
    };

    function reset(text: string) {
      clear();
      stage.querySelectorAll('.reveal__wait').forEach((node) => node.remove());
      answer.textContent = '';
      answer.style.opacity = '';
      answer.style.transition = '';
      partialOut.textContent = text;
    }

    // One simulated character stream for every view. Buffering waits for the
    // last character of a unit; sentences cannot appear at time zero.
    const TARGET = 4000;
    const baseTokenRate = Math.ceil(source.length / 4) / 4;
    const arrivalTime = (offset: number) => TARGET * offset / source.length;

    function runCharacters() {
      reset('partial words on screen');
      const text = document.createTextNode('');
      const caret = document.createElement('span');
      caret.className = 'sr-caret';
      answer.append(text, caret);
      startClock();
      Array.from({ length: source.length }, (_, index) => {
        cue(() => {
          text.data = source.slice(0, index + 1);
          if (index === 0) markFirst();
        }, arrivalTime(index + 1));
      });
      cue(() => { caret.remove(); stopClock(); }, TARGET);
    }

    function runBuffered(parts: string[], cls = '', separator = ' ') {
      reset('no partial words');
      const offsets = completionOffsets(source, parts);
      const spans = parts.map((part) => {
        const span = unit(part, cls);
        answer.append(span, document.createTextNode(separator));
        return span;
      });
      startClock();
      spans.forEach((span, index) => {
        cue(() => {
          span.classList.add('is-in');
          if (index === 0) markFirst();
        }, arrivalTime(offsets[index]!));
      });
      cue(stopClock, TARGET);
    }

    function runWords() {
      runBuffered(source.split(/\s+/).filter(Boolean));
    }

    // A hybrid run starts at character speed so the first words are there at
    // once, then coarsens: words for the rest of the first sentence, whole
    // sentences after that. Each phase ends where the next begins, so the
    // granularity follows the text rather than a second clock, and only the
    // typed lead can move the paragraph. Everything after it is in the DOM from
    // the first frame, waiting on opacity.
    function runHybrid() {
      const { lead, words, sentences } = hybridPhases(source);
      reset('partial words on screen');

      const text = document.createTextNode('');
      const caret = document.createElement('span');
      caret.className = 'sr-caret';
      answer.append(text, caret);

      const wordUnits: HTMLElement[] = [];
      const sentenceUnits: HTMLElement[] = [];
      const offsets = completionOffsets(source, [...words, ...sentences]);

      if (words.length) answer.append(document.createTextNode(' '));
      words.forEach((word) => {
        const span = unit(word);
        wordUnits.push(span);
        answer.append(span, document.createTextNode(' '));
      });
      if (!words.length && sentences.length) answer.append(document.createTextNode(' '));
      sentences.forEach((sentence, index) => {
        const span = unit(sentence, 'sr-unit--sentence');
        sentenceUnits.push(span);
        answer.append(span);
        if (index < sentences.length - 1) answer.append(document.createTextNode(' '));
      });

      startClock();

      for (let index = 1; index <= lead.length; index += 1) {
        cue(() => {
          text.data = lead.slice(0, index);
          if (index === 1) markFirst();
        }, arrivalTime(index));
      }

      cue(() => {
        caret.remove();
        partialOut.textContent = 'no partial words';
      }, arrivalTime(lead.length));

      wordUnits.forEach((span, index) => {
        cue(() => span.classList.add('is-in'), arrivalTime(offsets[index]!));
      });
      sentenceUnits.forEach((span, index) => {
        cue(() => span.classList.add('is-in'), arrivalTime(offsets[words.length + index]!));
      });

      cue(stopClock, TARGET);
    }

    function runChunks() {
      runBuffered(chunksOf(source), 'sr-unit--chunk');
    }

    function runSentences() {
      runBuffered(sentencesOf(source), 'sr-unit--sentence', '');
    }

    function runHeld() {
      // Keep exactly the same paragraph as the other modes. Only its paint is
      // held back; introducing nested blocks here changes wrapping and height.
      reset('nothing partial on screen');
      answer.textContent = source;
      answer.style.opacity = '0';

      const wait = document.createElement('span');
      wait.className = 'reveal__wait';
      stage.append(wait);

      startClock();
      const began = performance.now();
      const tick = () => {
        if (finished) return;
        wait.textContent = `working ${((performance.now() - began) / 1000).toFixed(1)} s`;
        cue(tick, 100);
      };
      tick();

      cue(() => {
        wait.remove();
        answer.style.opacity = '1';
        markFirst();
        stopClock();
      }, TARGET);
    }

    const runners: Record<string, () => void> = {
      stream: runCharacters,
      hybrid: runHybrid,
      words: runWords,
      chunks: runChunks,
      sentences: runSentences,
      held: runHeld,
    };

    function play(mode: string) {
      current = mode;
      started = true;
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
      });
      if (reduce) {
        reset('nothing to watch');
        answer.textContent = source;
        startClock();
        stopClock();
        return;
      }
      runners[mode]?.();
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        touched = true;
        play(button.dataset.mode ?? 'stream');
      });
    });

    // Speed is a playback multiplier on the animation's own clock. Changing it
    // mid-run restarts the run it is playing, so what the numbers show always
    // belongs to the setting on screen.
    const speedInput = root.querySelector<HTMLInputElement>('[data-speed]');
    const speedValue = root.querySelector<HTMLElement>('[data-speed-value]');
    speedInput?.addEventListener('input', () => {
      const next = Number(speedInput.value);
      if (!Number.isFinite(next) || next <= 0) return;
      speed = next / baseTokenRate;
      if (speedValue) speedValue.textContent = `${Number(next.toFixed(2))} tok/s`;
      if (started && !reduce) play(current);
    });

    // The building of the paragraph is the thing being described, so it does not
    // run until the reader has it in view. Characters is the default because it
    // is the thing every product already does.
    const first = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        first.disconnect();
        if (touched) return;
        play('stream');
      });
    }, { threshold: 0.4 });
    first.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-reveal-demo]').forEach(init);
</script>
