---
import { LOCALE } from '../site/config';
import type { RelatedEntry } from '../content/types';

interface Props {
  entries: RelatedEntry[];
}

const { entries } = Astro.props;

const TYPE_LABEL: Record<RelatedEntry['type'], string> = {
  post: 'Article',
  report: 'Report',
  workStory: 'Work',
};

const year = new Intl.DateTimeFormat(LOCALE, { year: 'numeric' });
const displayYear = (iso: string): string => (iso ? year.format(new Date(iso)) : '');
---

{
  entries.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related</h2>
      <ul>
        {entries.map((entry) => (
          <li>
            <a href={entry.href}>
              <span class="related__label">
                {TYPE_LABEL[entry.type]}
                {displayYear(entry.publishedAt) && ` · ${displayYear(entry.publishedAt)}`}
              </span>
              <span class="related__title">{entry.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    border-top: 1px solid var(--color-stroke-subtle);
    margin-top: var(--section-space);
    padding-top: var(--spacing-8);
  }

  .related h2 {
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0 0 var(--spacing-6);
    text-transform: uppercase;
  }

  .related ul {
    display: grid;
    gap: var(--spacing-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related a {
    color: var(--color-text-primary);
    display: grid;
    gap: var(--spacing-1);
    text-decoration: none;
  }

  .related a:hover .related__title {
    color: var(--color-action);
  }

  .related__label {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related__title {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: var(--tracking-heading);
    line-height: 1.3;
  }
</style>
