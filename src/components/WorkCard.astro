---
import IconText from './IconText.astro';
import WorkCover from './WorkCover.astro';
import { categoryLabel } from '../content/work';
import type { WorkStory } from '../content/types';

interface Props {
  story: WorkStory;
  variant?: 'featured' | 'row';
  reverse?: boolean;
}

const { story, variant = 'featured', reverse = false } = Astro.props;

const repo = story.links.find((link) => link.label === 'Source code');
const year = story.timeframe ?? String(new Date(story.date).getFullYear());
---

<article class:list={['work-card', `work-card--${variant}`, reverse && 'work-card--reverse']}>
  <div class="work-card__link">
    <div class="work-card__visual">
      <WorkCover cover={story.cover} compact={variant === 'row'} />
    </div>
    <div class="work-card__content">
      <div class="work-card__meta">
        <span>{categoryLabel(story.kind)} · {story.descriptor}</span>
        <span>{year}</span>
      </div>
      <h3>{story.title}</h3>
      <p class="work-card__summary">{story.introduction}</p>
      <div class="work-card__actions">
        {/* Stretched link: covers the whole card, so the card stays one big
            click target while the repo link below can sit above it. */}
        <a
          href={`/work/${story.slug}`}
          class="work-card__cover"
          aria-label={`Read the ${story.title} case study`}
        >
          <IconText class="work-card__action">View case study</IconText>
        </a>
        {
          repo && (
            <a
              href={repo.href}
              class="work-card__repo"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${story.title} source code on GitHub`}
            >
              <IconText class="work-card__action" icon="arrow-up-right">Source code</IconText>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .work-card {
    border-top: 1px solid var(--color-stroke-subtle);
    position: relative;
  }

  .work-card__link {
    color: inherit;
    display: grid;
    gap: var(--spacing-6);
    padding-block: clamp(2rem, 6vw, 5rem);
    text-decoration: none;
  }

  .work-card__actions {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4) var(--spacing-6);
  }

  .work-card__cover,
  .work-card__repo {
    color: inherit;
    text-decoration: none;
  }

  .work-card__cover::after {
    content: '';
    inset: 0;
    position: absolute;
  }

  /* Sits above the stretched link so it stays independently clickable. */
  .work-card__repo {
    position: relative;
    z-index: 1;
  }

  .work-card__visual {
    min-width: 0;
  }

  .work-card__content {
    align-self: center;
  }

  .work-card__meta {
    align-items: start;
    color: var(--color-text-secondary);
    display: flex;
    font-size: var(--type-label);
    font-weight: var(--font-weight-semibold);
    gap: var(--spacing-4);
    justify-content: space-between;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .work-card__meta span:last-child {
    flex-shrink: 0;
    text-align: right;
  }

  h3 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: var(--tracking-heading);
    margin: var(--spacing-5) 0 var(--spacing-4);
  }

  .work-card__summary {
    color: var(--color-text-primary);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.4;
    margin: 0;
    max-width: 32rem;
  }

  .work-card__action {
    --icon-gap: var(--spacing-2);
    color: var(--color-action);
    font-size: var(--type-body-small);
    font-weight: var(--font-weight-bold);
    margin-top: var(--spacing-6);
  }

  @media (min-width: 52rem) {
    .work-card--featured .work-card__link {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.85fr);
    }

    .work-card--row .work-card__link {
      grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
      padding-block: clamp(2rem, 4vw, 3.5rem);
    }

    .work-card--row h3 {
      font-size: clamp(2.1rem, 4vw, 3.8rem);
    }

    .work-card--reverse .work-card__visual {
      order: 2;
    }

    /* Mirror the tracks when reversed so the visual keeps the wide column. */
    .work-card--featured.work-card--reverse .work-card__link {
      grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.45fr);
    }
  }
</style>
