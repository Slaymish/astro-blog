---
import { NEW_TAB_NOTE_ID } from '../site/config';
import Button from './Button.astro';
import IconText from './IconText.astro';
import IntroductionText from './IntroductionText.astro';
import WorkCover from './WorkCover.astro';
import { getSiteSettings } from '../content/queries';
import type { WorkStory } from '../content/types';

interface Props {
  story: WorkStory;
  variant?: 'featured' | 'row';
  reverse?: boolean;
}

const { story, variant = 'featured', reverse = false } = Astro.props;

const { workCtaLabel, entryLabels } = await getSiteSettings();
const repo = story.links.find((link) => link.kind === 'source');
const href = `/work/${story.slug}`;
const titleId = `work-card-${story.slug}`;
const repoId = `work-card-${story.slug}-source`;
---

<article class:list={['work-card', `work-card--${variant}`, reverse && 'work-card--reverse']}>
  <div class="work-card__link">
    <div class="work-card__visual">
      {/* A mouse shortcut only: the title and the button already link here. */}
      <a class="work-card__visual-link" href={href} tabindex="-1" aria-hidden="true">
        <WorkCover cover={story.cover} compact={variant === 'row'} elevated />
      </a>
      <div class="work-card__actions">
        <Button class="work-card__cta" href={href} size="sm">
          {story.ctaLabel ?? workCtaLabel}
        </Button>
      </div>
    </div>
    <div class="work-card__content">
      <h3><a href={href} id={titleId}>{story.title}</a></h3>
      <p class="work-card__summary"><IntroductionText text={story.introduction} link={story.introductionLink} /></p>
      {
        repo && (
          <a
            href={repo.href}
            class="work-card__repo"
            id={repoId}
            target="_blank" aria-describedby={NEW_TAB_NOTE_ID}
            rel="noopener noreferrer"
            aria-labelledby={`${repoId} ${titleId}`}
          >
            <IconText class="work-card__action" icon="arrow-up-right">{entryLabels.sourceCodeLabel}</IconText>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .work-card {
    border-top: 1px solid var(--color-stroke-subtle);
    position: relative;
  }

  .work-card__link {
    color: inherit;
    display: grid;
    gap: var(--spacing-6);
    padding-block: clamp(2rem, 6vw, 5rem);
    text-decoration: none;
  }

  /* Straddles the cover's bottom edge, as on the home page. */
  .work-card__actions {
    align-items: center;
    display: flex;
    inset-block-end: calc(var(--control-height-sm) / 2);
    inset-inline-end: var(--spacing-6);
    position: absolute;
    transform: translateY(50%);
  }

  .work-card__repo {
    color: inherit;
    display: inline-block;
    margin-top: var(--spacing-3);
    padding-block: var(--spacing-3);
    text-decoration: none;
  }

  /* Reserves the half of the pill that hangs below the cover. */
  .work-card__visual {
    min-width: 0;
    padding-block-end: calc(var(--control-height-sm) / 2);
    position: relative;
  }

  .work-card__visual-link {
    display: block;
    text-decoration: none;
  }

  .work-card__content {
    align-self: center;
  }

  h3 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-4);
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-action);
  }

  .work-card__summary {
    color: var(--color-text-primary);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.4;
    margin: 0;
    max-width: 32rem;
  }

  .work-card__action {
    --icon-gap: var(--spacing-2);
    color: var(--color-action);
    display: inline-block;
    font-size: var(--type-body-small);
    font-weight: var(--font-weight-bold);
  }

  @media (min-width: 52rem) {
    .work-card--featured .work-card__link {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.85fr);
    }

    .work-card--row .work-card__link {
      grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
      padding-block: clamp(2rem, 4vw, 3.5rem);
    }

    .work-card--row h3 {
      font-size: clamp(2.1rem, 4vw, 3.8rem);
    }

    .work-card--reverse .work-card__visual {
      order: 2;
    }

    /* Mirror the tracks when reversed so the visual keeps the wide column. */
    .work-card--featured.work-card--reverse .work-card__link {
      grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.45fr);
    }
  }
</style>
