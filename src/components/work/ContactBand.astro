---
import ButtonLink from '../ui/ButtonLink.astro';
import IconText from '../ui/IconText.astro';
import { BOOKING_URL, CONTACT_EMAIL } from '../../lib/site';
import { getSiteSettings } from '../../lib/pageContent';

interface Props {
  heading?: string;
  /** Only the pages that are actually about engaging Hamish show the booking button. */
  booking?: boolean;
}

const { heading, booking = false } = Astro.props;

const { contactBand } = await getSiteSettings();
const bandHeading = heading ?? contactBand.defaultHeading;
---

<aside class="contact-band" aria-label="Get in touch" data-circuit="BUS_03">
  <div>
    <p>{contactBand.label}</p>
    <h2 data-circuit-source>{bandHeading}</h2>
  </div>
  <div class="contact-band__actions">
    {booking ? (
      <ButtonLink href={BOOKING_URL} external ariaLabel="Book a call on Cal.com" circuitNode="booking">
        {contactBand.bookingLabel}
      </ButtonLink>
    ) : (
      <a class="contact-band__primary" href="/contact" data-circuit-node="contact" data-circuit-flash="edge">
        <IconText>{contactBand.contactLabel}</IconText>
      </a>
    )}
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </div>
</aside>

<style>
  .contact-band { align-items: end; border-top: 1px solid var(--color-stroke-subtle); display: grid; gap: var(--spacing-8); margin-block: clamp(4rem, 10vw, 9rem) 0; padding-block: var(--band-inset); }
  .contact-band p { color: var(--color-action); font-size: var(--type-label); font-weight: 700; letter-spacing: .1em; margin: 0 0 var(--spacing-4); text-transform: uppercase; }
  .contact-band h2 { font-size: clamp(2.4rem, 7vw, 6rem); letter-spacing: var(--tracking-heading); margin: 0; max-width: 13ch; }
  .contact-band__actions { align-items: start; display: flex; flex-direction: column; gap: var(--spacing-3); }
  .contact-band__primary { color: var(--color-text-primary); font-size: var(--type-body-small); font-weight: 700; }
  .contact-band__primary:hover { color: var(--color-action); }
  .contact-band__actions > a:last-child { color: var(--color-text-secondary); font-size: var(--type-body-small); }
  @media (min-width: 48rem) { .contact-band { grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr); } }
</style>
