---
import { NEW_TAB_NOTE_ID } from '../site/config';

const links = [
  { href: '/contact', label: 'Contact' },
  { href: '/cv', label: 'CV' },
  { href: '/rss.xml', label: 'RSS' },
];
const legalLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__tagline">Hamish Burke · Wellington, New Zealand</p>
    <nav class="site-footer__nav" aria-label="Footer">
      <div class="site-footer__links">
        {links.map(({ href, label }) => <a href={href}>{label}</a>)}
      </div>
      <div class="site-footer__links site-footer__links--legal">
        {legalLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </div>
    </nav>
  </div>
  <span id={NEW_TAB_NOTE_ID} hidden>Opens in a new tab</span>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-stroke-subtle);
    margin-top: var(--section-space);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4) var(--spacing-8);
    justify-content: space-between;
    margin-inline: auto;
    max-width: calc(var(--content-max-width) + 2 * var(--page-gutter));
    padding-block: var(--spacing-8);
    padding-inline: var(--page-gutter);
  }

  .site-footer__tagline {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    margin: 0;
  }

  .site-footer__nav {
    display: grid;
    gap: var(--spacing-2);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--spacing-5);
  }

  .site-footer__nav a {
    align-items: center;
    color: var(--color-text-secondary);
    display: inline-flex;
    font-size: var(--type-body-small);
    min-block-size: var(--control-height-md);
    min-inline-size: var(--control-height-md);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__links--legal a {
    font-size: var(--font-size-sm);
  }

  .site-footer__nav a:hover {
    color: var(--color-action);
  }
</style>
