---
import { CONTACT_EMAIL, SOCIAL_PROFILES, NEW_TAB_NOTE_ID } from '../site/config';
import { getSiteSettings } from '../content/queries';

const { footer, header, newTabNote } = await getSiteSettings();

const links = [
  { href: `mailto:${CONTACT_EMAIL}`, label: footer.emailLabel },
  { href: SOCIAL_PROFILES.github, label: footer.githubLabel, external: true },
  { href: SOCIAL_PROFILES.linkedin, label: footer.linkedinLabel, external: true },
  { href: '/contact', label: header.contactLabel },
  { href: '/cv', label: footer.cvLabel },
  { href: '/rss.xml', label: footer.rssLabel },
  { href: '/privacy', label: footer.privacyLabel },
  { href: '/terms', label: footer.termsLabel },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__tagline">{footer.tagline}</p>
    <nav class="site-footer__nav" aria-label={footer.navigationLabel}>
      {
        links.map(({ href, label, external }) => (
          <a
            href={href}
            rel={external ? 'noopener noreferrer' : undefined}
            target={external ? '_blank' : undefined}
            aria-describedby={external ? NEW_TAB_NOTE_ID : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
  <span id={NEW_TAB_NOTE_ID} hidden>{newTabNote}</span>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-stroke-subtle);
    margin-top: var(--section-space);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4) var(--spacing-8);
    justify-content: space-between;
    margin-inline: auto;
    max-width: calc(var(--content-max-width) + 2 * var(--page-gutter));
    padding-block: var(--spacing-8);
    padding-inline: var(--page-gutter);
  }

  .site-footer__tagline {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    margin: 0;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--spacing-5);
  }

  .site-footer__nav a {
    align-items: center;
    color: var(--color-text-secondary);
    display: inline-flex;
    font-size: var(--type-body-small);
    min-block-size: var(--control-height-md);
    min-inline-size: var(--control-height-md);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--color-action);
  }
</style>
