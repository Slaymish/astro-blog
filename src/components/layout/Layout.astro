---
// Design System
import "../../design-system/fonts.css";
import "../../design-system/tokens.css";
import "../../design-system/base.css";
import "../../design-system/themes/dark.css";
import "../../design-system/themes/light.css";

import "../../styles/globals.css";
import "../../design-system/primitives.css";


// Layout Components
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { THEME_COLORS } from "../../lib/shell/theme";
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  SOCIAL_PROFILES,
  absoluteUrl,
  canonicalFromAstro
} from "../../lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  canonicalURL?: string;
  /** Use full-width layout (no max-width constraint on main) */
  fullWidth?: boolean;
  /** Robots directive. Private routes pass `noindex, nofollow`. */
  robots?: string;
}

const { 
  title, 
  description = SITE_DESCRIPTION,
  image = "/apple-touch-icon.png",
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
  author = SITE_AUTHOR,
  canonicalURL,
  fullWidth = false,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
} = Astro.props;

const siteTitle = SITE_NAME;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const siteURL = Astro.site?.toString() || SITE_URL;
const canonicalHref = canonicalFromAstro(Astro.url, Astro.site, canonicalURL);
const imageURL = absoluteUrl(image, siteURL);
const personId = absoluteUrl("/#person", siteURL);
const websiteId = absoluteUrl("/#website", siteURL);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      "name": SITE_AUTHOR,
      "alternateName": "Slaymish",
      "url": absoluteUrl("/", siteURL),
      "image": absoluteUrl("/apple-touch-icon.png", siteURL),
      "jobTitle": "Software developer",
      "sameAs": [...SOCIAL_PROFILES]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": absoluteUrl("/", siteURL),
      "name": siteTitle,
      "description": SITE_DESCRIPTION,
      "publisher": { "@id": personId },
      "inLanguage": "en-US"
    },
    article
      ? {
          "@type": "BlogPosting",
          "headline": title,
          "description": description,
          "url": canonicalHref,
          "author": { "@id": personId },
          "publisher": { "@id": personId },
          "image": [imageURL],
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": canonicalHref
          },
          ...(publishedTime ? { "datePublished": publishedTime } : {}),
          ...(modifiedTime ? { "dateModified": modifiedTime } : {}),
          ...(tags.length > 0 ? { "keywords": tags.join(", ") } : {})
        }
      : {
          "@type": "WebPage",
          "@id": canonicalHref,
          "url": canonicalHref,
          "name": fullTitle,
          "description": description,
          "isPartOf": { "@id": websiteId },
          "about": { "@id": personId },
          "inLanguage": "en-US"
        }
  ]
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Resolve the theme before first paint so there is no flash of the wrong
         theme. Stored choice wins; otherwise follow the system preference.
         data-cfasync="false" is required: Cloudflare Rocket Loader otherwise
         rewrites the type attribute and defers this until after first paint,
         which reintroduces the flash. -->
    <script is:inline data-cfasync="false" define:vars={{ themeColors: THEME_COLORS }}>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        var theme = stored === 'light' || stored === 'dark' ? stored : (prefersLight ? 'light' : 'dark');
        root.classList.remove('light', 'dark');
        root.classList.add(theme);
        root.dataset.themeSource = stored ? 'user' : 'system';
        // Set inline so the browser paints the right canvas even before the
        // theme stylesheet has parsed. themeColors is inlined at build time
        // from src/lib/shell/theme.ts: no stylesheet has parsed yet, so the
        // token cannot be read off computed style here.
        root.style.colorScheme = theme;
        root.style.backgroundColor = themeColors[theme];
      })();
    </script>
    
    <!-- Basic Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="en" href={canonicalHref} />
    <link rel="alternate" hreflang="x-default" href={canonicalHref} />
    
    <!-- Self-hosted fonts (src/design-system/fonts.css). Only Geist latin is preloaded:
         it sets every heading and every paragraph above the fold. The serif is emphasis
         only and the mono is meta text, so both can wait for the stylesheet. -->
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_NZ" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalHref} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:site" content="@Slaymishh" />
    <meta name="twitter:creator" content="@Slaymishh" />
    
    <!-- Article-specific meta tags -->
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {article && author && <meta property="article:author" content={author} />}
    {article && tags.map(tag => <meta property="article:tag" content={tag} />)}
    
    <!-- Structured Data for LLMs and Search Engines -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    
    <!-- Breadcrumb Schema for Homepage -->
    {!article && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": absoluteUrl("/", siteURL)
          }]
        })} />
    )}
    
    <!-- Additional meta for LLMs -->
    <meta name="robots" content={robots} />
    <meta name="googlebot" content="index, follow" />
    
    <!-- Performance and Security -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />
    <!-- Rendered dark; ThemeToggle's syncChrome() corrects theme-color to the
         resolved theme as soon as it runs. -->
    <meta name="theme-color" content={THEME_COLORS.dark} />
    <meta name="msapplication-TileColor" content={THEME_COLORS.dark} />
    
    <!-- Preconnect to external domains for faster loading -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    
    <!-- Favicon and Icons -->
    <link rel="icon" type="image/svg+xml" href="/HB_logo.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Hamish's Blog RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM guidance" href="/llms.txt" />
    
    <!-- Analytics — Umami (privacy-respecting, no cookies) -->
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="3b77a67f-19f6-4f3c-a7ab-8af0d58bfbc6"></script>

    <!-- KaTeX CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      .site-shell {
        padding-inline: var(--page-gutter);
        width: 100%;
      }

      /* The contact band owns the space between itself and the footer rule. */
      .site-shell main:has(> .contact-band) {
        padding-block-end: 0;
      }

      /* Shared canvas for the page and footer. */
      .page-body {
        background: var(--bg);
        display: flex;
        flex-direction: column;
        isolation: isolate;
        min-height: 100%;
        position: relative;
      }

      .page-body > .site-shell {
        position: relative;
        z-index: 1;
      }

      #main-content {
        position: relative;
      }
    </style>
  </head>
  <body class="antialiased" style="background-color: var(--bg); color: var(--text);">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <Header />

    <div class="page-body">
      <div class="site-shell">
        <main
          id="main-content"
          class={`grow w-full mx-auto pt-8 pb-8 sm:pt-10 sm:pb-12 md:pt-10 md:pb-16 ${fullWidth ? '' : 'max-w-[var(--content-max-width)]'}`}
          tabindex="-1"
        >
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <!-- The shell's own behaviour: the cal.com
         booking-ref rewriter, the analytics tracker and the code-copy buttons.
         Bundled rather than inline so it is type-checked and can share
         MAX_EVENTS with the server-side validator in src/lib/analytics.ts. -->
    <script>
      import { initShell } from "../../lib/shell";
      initShell();
    </script>
  </body>
</html>
