---
// Design System
import "../../design-system/fonts.css";
import "../../design-system/tokens.css";
import "../../design-system/base.css";
import "../../design-system/themes/dark.css";
import "../../design-system/themes/light.css";
import "../../design-system/circuit.css";
import "../../styles/globals.css";


// Layout Components
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { Bend } from "../canvasui/Bend";
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  SOCIAL_PROFILES,
  absoluteUrl,
  canonicalFromAstro
} from "../../lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  canonicalURL?: string;
  /** Use full-width layout (no max-width constraint on main) */
  fullWidth?: boolean;
}

const { 
  title, 
  description = SITE_DESCRIPTION,
  image = "/apple-touch-icon.png",
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
  author = SITE_AUTHOR,
  canonicalURL,
  fullWidth = false,
} = Astro.props;

const siteTitle = SITE_NAME;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const siteURL = Astro.site?.toString() || SITE_URL;
const canonicalHref = canonicalFromAstro(Astro.url, Astro.site, canonicalURL);
const imageURL = absoluteUrl(image, siteURL);
const personId = absoluteUrl("/#person", siteURL);
const websiteId = absoluteUrl("/#website", siteURL);
const showPageCircuit = Astro.url.pathname !== "/";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      "name": SITE_AUTHOR,
      "alternateName": "Slaymish",
      "url": absoluteUrl("/", siteURL),
      "image": absoluteUrl("/apple-touch-icon.png", siteURL),
      "jobTitle": "Software Engineer",
      "sameAs": [...SOCIAL_PROFILES]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": absoluteUrl("/", siteURL),
      "name": siteTitle,
      "description": SITE_DESCRIPTION,
      "publisher": { "@id": personId },
      "inLanguage": "en-US"
    },
    article
      ? {
          "@type": "BlogPosting",
          "headline": title,
          "description": description,
          "url": canonicalHref,
          "author": { "@id": personId },
          "publisher": { "@id": personId },
          "image": [imageURL],
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": canonicalHref
          },
          ...(publishedTime ? { "datePublished": publishedTime } : {}),
          ...(modifiedTime ? { "dateModified": modifiedTime } : {}),
          ...(tags.length > 0 ? { "keywords": tags.join(", ") } : {})
        }
      : {
          "@type": "WebPage",
          "@id": canonicalHref,
          "url": canonicalHref,
          "name": fullTitle,
          "description": description,
          "isPartOf": { "@id": websiteId },
          "about": { "@id": personId },
          "inLanguage": "en-US"
        }
  ]
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Resolve the theme before first paint so there is no flash of the wrong
         theme. Stored choice wins; otherwise follow the system preference.
         data-cfasync="false" is required: Cloudflare Rocket Loader otherwise
         rewrites the type attribute and defers this until after first paint,
         which reintroduces the flash. -->
    <script is:inline data-cfasync="false">
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        var theme = stored === 'light' || stored === 'dark' ? stored : (prefersLight ? 'light' : 'dark');
        root.classList.remove('light', 'dark');
        root.classList.add(theme);
        root.dataset.themeSource = stored ? 'user' : 'system';
        // Set inline so the browser paints the right canvas even before the
        // theme stylesheet has parsed.
        root.style.colorScheme = theme;
        root.style.backgroundColor = theme === 'light' ? '#f6f7f3' : '#0b0d0c';
      })();
    </script>
    
    <!-- Basic Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="en" href={canonicalHref} />
    <link rel="alternate" hreflang="x-default" href={canonicalHref} />
    
    <!-- Self-hosted fonts (src/design-system/fonts.css) - preload the above-the-fold weights -->
    <link rel="preload" href="/fonts/figtree-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/familjen-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalHref} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:site" content="@Slaymishh" />
    <meta name="twitter:creator" content="@Slaymishh" />
    
    <!-- Article-specific meta tags -->
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {article && author && <meta property="article:author" content={author} />}
    {article && tags.map(tag => <meta property="article:tag" content={tag} />)}
    
    <!-- Structured Data for LLMs and Search Engines -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    
    <!-- Breadcrumb Schema for Homepage -->
    {!article && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": absoluteUrl("/", siteURL)
          }]
        })} />
    )}
    
    <!-- Additional meta for LLMs -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    
    <!-- Performance and Security -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#0b0d0c" />
    <meta name="msapplication-TileColor" content="#0b0d0c" />
    
    <!-- Preconnect to external domains for faster loading -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    
    <!-- Favicon and Icons -->
    <link rel="icon" type="image/svg+xml" href="/HB_logo.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Hamish's Blog RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM guidance" href="/llms.txt" />
    
    <!-- Analytics — Umami (privacy-respecting, no cookies) -->
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="3b77a67f-19f6-4f3c-a7ab-8af0d58bfbc6"></script>

    <!-- KaTeX CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      .site-shell {
        padding-inline: var(--page-gutter);
        width: 100%;
      }

      /* The contact band owns the space between itself and the footer rule. */
      .site-shell main:has(> .contact-band) {
        padding-block-end: 0;
      }

      /* Containing block for Bend's canvases: astro-island is display:contents
         and so cannot be one itself. */
      .bend-shell {
        position: relative;
        width: 100%;
      }

      /* Default to an ordinary scrolling document. Bend is a desktop-only
         enhancement and sets data-bend-active once its canvas has taken over;
         only then does it own the scroll container and the document must not
         scroll. Touch browsers never get here, so they keep native scrolling. */
      html[data-bend-active],
      html[data-bend-active] body.bend-host {
        height: 100%;
        overflow: hidden;
      }

      html[data-bend-active] body.bend-host {
        display: flex;
        flex-direction: column;
      }

      /* The header sits outside Bend so it never folds; Bend takes the rest. */
      html[data-bend-active] .bend-shell {
        flex: 1;
        min-height: 0;
      }

      /* Sits inside Bend's scroller and restores the flex column the body used to provide. */
      .bend-page {
        display: flex;
        flex-direction: column;
        isolation: isolate;
        min-height: 100%;
        position: relative;
        background: var(--bg);
      }

      /* One oversized, fixed layer keeps the atmosphere continuous between
         sections. Scroll only transforms the composited layer; the broad,
         low-opacity gradients themselves never animate or pulse. */
      .ambient-background {
        background:
          radial-gradient(ellipse 44% 38% at 14% 18%, var(--ambient-accent), transparent 72%),
          radial-gradient(ellipse 38% 44% at 86% 46%, var(--ambient-neutral), transparent 74%),
          radial-gradient(ellipse 46% 36% at 48% 94%, var(--ambient-highlight), transparent 76%);
        inset: -18vmax;
        pointer-events: none;
        position: fixed;
        transform: translate3d(var(--ambient-shift-x, -1.5%), var(--ambient-shift-y, 1%), 0)
          rotate(var(--ambient-rotation, -1.2deg));
        transform-origin: center;
        will-change: transform;
        z-index: 0;
      }

      /* A nearly invisible monochrome grain breaks up 8-bit colour bands in
         shallow gradients. It is static and moves with the existing layer. */
      .ambient-background::after {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 180px 180px;
        content: "";
        inset: 0;
        mix-blend-mode: soft-light;
        opacity: var(--ambient-noise-opacity);
        position: absolute;
      }

      .bend-page > .site-shell {
        position: relative;
        z-index: 1;
      }

      #main-content {
        position: relative;
      }

      @media (prefers-reduced-motion: reduce) {
        .ambient-background {
          transform: none;
          will-change: auto;
        }
      }
    </style>
  </head>
  <body class="antialiased bend-host" style="background-color: var(--bg); color: var(--text);">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <Header />

    <!-- The page is ordinary server-rendered markup and stays that way. Bend
         renders no content of its own: it adopts .bend-page into its canvas
         only once it activates, so a client-side failure can never blank the
         page. It also hydrates on desktop pointers only, so phones never run
         the React or WebGL path. Keep the query in step with DESKTOP_QUERY in
         Bend.tsx. -->
    <div class="bend-shell">
      <div class="bend-page">
        <div class="ambient-background" aria-hidden="true"></div>
        <div class="site-shell">
          <main
            id="main-content"
            class={`grow w-full mx-auto pt-8 pb-8 sm:pt-10 sm:pb-12 md:pt-10 md:pb-16 ${fullWidth ? '' : 'max-w-[var(--content-max-width)]'}`}
            tabindex="-1"
          >
            {showPageCircuit && (
              <div class="page-circuit-motif" data-circuit="PAGE_BUS" data-circuit-tone="quiet" aria-hidden="true">
                <span class="page-circuit-motif__anchor page-circuit-motif__anchor--source" data-circuit-source></span>
                <span
                  class="page-circuit-motif__anchor page-circuit-motif__anchor--middle"
                  data-circuit-node="middle"
                  data-circuit-edge="left"
                ></span>
                <span
                  class="page-circuit-motif__anchor page-circuit-motif__anchor--end"
                  data-circuit-node="end"
                  data-circuit-edge="left"
                ></span>
              </div>
            )}
            <slot />
          </main>
          <Footer />
        </div>
      </div>

      <Bend
        client:media="(min-width: 1024px) and (hover: hover) and (pointer: fine)"
        target=".bend-page"
        zone={160}
        angle={16}
        rounding={480}
        perspective={1800}
        ease={90}
        smoothing={0.12}
        tumble={0.03}
        tilt={0}
        direction="out"
        top
        bottom
      />
    </div>
    <!-- Wires [data-circuit] regions into a bus overlay. Regions opt in through
         markup only; a page with none pays nothing but the module. -->
    <script>
      import { initCircuit } from "../../lib/circuit";
      initCircuit();
    </script>
    <script is:inline data-cfasync="false">
      (function () {
        var root = document.documentElement;
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        var frame = 0;
        var progress = 0;

        function paintAmbientPosition() {
          frame = 0;
          root.style.setProperty('--ambient-shift-x', (-1.5 + progress * 3).toFixed(2) + '%');
          root.style.setProperty('--ambient-shift-y', (1 - progress * 2).toFixed(2) + '%');
          root.style.setProperty('--ambient-rotation', (-1.2 + progress * 2.4).toFixed(2) + 'deg');
        }

        function ambientScroll(event) {
          if (reduceMotion.matches) return;

          var node = event && event.target;
          var isDocument = !event || node === document || node === document.documentElement;
          var isBendScroller = node instanceof HTMLElement && node.hasAttribute('data-canvasui-content');
          if (!isDocument && !isBendScroller) return;

          var scrollTop = isDocument ? window.scrollY : node.scrollTop;
          var viewport = isDocument ? window.innerHeight : node.clientHeight;
          var scrollHeight = isDocument ? document.documentElement.scrollHeight : node.scrollHeight;
          progress = Math.min(1, Math.max(0, scrollTop / Math.max(1, scrollHeight - viewport)));

          if (!frame) frame = requestAnimationFrame(paintAmbientPosition);
        }

        document.addEventListener('scroll', ambientScroll, { passive: true, capture: true });
        ambientScroll();
      })();
    </script>
    {article && (
      <script is:inline>
        function initCodeCopy() {
          // Copy-to-clipboard on code blocks
          document.querySelectorAll('.prose pre').forEach(function(pre) {
            if (pre.querySelector('.code-copy-btn')) return; // already added
            var btn = document.createElement('button');
            btn.className = 'code-copy-btn';
            btn.setAttribute('aria-label', 'Copy code');
            btn.textContent = 'Copy';
            btn.addEventListener('click', function() {
              var code = pre.querySelector('code');
              var text = code ? code.textContent : pre.textContent;
              navigator.clipboard.writeText(text || '').then(function() {
                btn.textContent = 'Copied!';
                setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
              });
            });
            pre.style.position = 'relative';
            pre.appendChild(btn);
          });
        }
        initCodeCopy();
      </script>
    )}
    <!-- Attribute completed bookings back to the page that produced them. The
         page is prerendered, so the ref is attached here rather than at build
         time. Cal.com returns metadata on its BOOKING_CREATED webhook, which
         /api/cal-webhook turns into a conversion event. -->
    <script is:inline data-cfasync="false">
      (function () {
        var NONCE_KEY = 'booking-nonce';
        var nonce;
        try {
          nonce = localStorage.getItem(NONCE_KEY);
          if (!nonce) {
            nonce = Math.random().toString(36).slice(2, 10);
            localStorage.setItem(NONCE_KEY, nonce);
          }
        } catch (e) {
          nonce = 'nostorage';
        }

        var ref = window.location.pathname + '|' + nonce;

        document.querySelectorAll('a[href*="cal.com/"]').forEach(function (link) {
          var href = link.getAttribute('href');
          if (!href || href.indexOf('metadata[ref]') !== -1) return;
          link.setAttribute(
            'href',
            href + (href.indexOf('?') === -1 ? '?' : '&') + 'metadata[ref]=' + encodeURIComponent(ref)
          );
        });
      })();
    </script>

    <!-- Custom analytics events for UX success metrics -->
    <script is:inline>
      function initAnalytics() {
        // Sequence buffer for the nightly synthesis. Umami Cloud keeps the
        // dashboards; its query API is paid, so the ordered sequence is
        // collected first-party and flushed once per session.
        var sessionStart = Date.now();
        var sequence = [{ t: 0, p: window.location.pathname }];

        function track(name, data) {
          if (typeof umami !== 'undefined' && umami.track) {
            umami.track(name, data);
          }
          if (sequence.length < 100) {
            sequence.push({ t: Date.now() - sessionStart, p: window.location.pathname, n: name });
          }
        }

        var sequenceSent = false;
        function flushSequence() {
          if (sequenceSent || sequence.length === 0) return;
          sequenceSent = true;
          var visitorId = '';
          try { visitorId = localStorage.getItem('booking-nonce') || ''; } catch (e) {}
          try {
            // sendBeacon survives the page being torn down; fetch often does not.
            // `s` is the same nonce attached to booking links, so a confirmed
            // booking can be joined back to the session that produced it.
            navigator.sendBeacon(
              '/api/collect',
              new Blob([JSON.stringify({ s: visitorId, e: sequence })], { type: 'application/json' })
            );
          } catch (e) {}
        }

        var maxScroll = 0;
        var scrollMilestones = [25, 50, 60, 75, 90, 100];
        var firedMilestones = {};
        var pathname = window.location.pathname;

        // Bend hosts the page in its own scroll container and swaps that element
        // when the canvas effect activates, so listen in the capture phase on the
        // document rather than binding to a node that may be replaced.
        if (window.__analyticsScrollHandler) {
          document.removeEventListener('scroll', window.__analyticsScrollHandler, true);
        }

        function analyticsScroll(event) {
          var node = event.target;
          var isDocument = node === document || node === document.documentElement;
          var scrollTop = isDocument ? window.scrollY : node.scrollTop;
          var viewport = isDocument ? window.innerHeight : node.clientHeight;
          var scrollHeight = isDocument ? document.documentElement.scrollHeight : node.scrollHeight;
          var docHeight = scrollHeight - viewport;
          if (docHeight <= 0) return;
          var pct = Math.round((scrollTop / docHeight) * 100);
          if (pct > maxScroll) maxScroll = pct;
          scrollMilestones.forEach(function(m) {
            if (pct >= m && !firedMilestones[m]) {
              firedMilestones[m] = true;
              track('scroll-depth', { depth: m, page: pathname });
            }
          });
        }
        window.__analyticsScrollHandler = analyticsScroll;
        document.addEventListener('scroll', analyticsScroll, { passive: true, capture: true });

        document.querySelectorAll('a[href*="/cv"], a[href*="cv.pdf"], a[href*="CV"]').forEach(function(el) {
          el.addEventListener('click', function() {
            var label = el.textContent.trim().toLowerCase();
            track(label.includes('download') ? 'cv-download' : 'cv-view', { page: pathname });
          });
        });

        document.querySelectorAll('a[href^="mailto:"]').forEach(function(el) {
          el.addEventListener('click', function() { track('email-click', { page: pathname }); });
        });

        document.querySelectorAll('.share-link, a[href*="twitter.com/intent"], a[href*="linkedin.com/share"]').forEach(function(el) {
          el.addEventListener('click', function() {
            var href = el.getAttribute('href') || '';
            var platform = href.includes('twitter.com') || href.includes('x.com') ? 'twitter' : href.includes('linkedin.com') ? 'linkedin' : 'unknown';
            track('social-share', { platform: platform, page: pathname });
          });
        });

        document.querySelectorAll('a[target="_blank"], a[rel*="noopener"]').forEach(function(el) {
          el.addEventListener('click', function() {
            var href = el.getAttribute('href') || '';
            if (href.includes('github.com')) track('outbound-click', { destination: 'github', page: pathname });
            else if (href.includes('linkedin.com')) track('outbound-click', { destination: 'linkedin', page: pathname });
          });
        });

        document.querySelectorAll('a[href*="cal.com/hamishburke"]').forEach(function(el) {
          el.addEventListener('click', function() {
            track('book-call', { page: pathname, placement: el.closest('header') ? 'header' : 'content' });
          });
        });

        document.querySelectorAll('a[href="/work"], a[href^="/work/"]').forEach(function(el) {
          el.addEventListener('click', function() {
            track('work-view', { page: pathname, destination: el.getAttribute('href') || '/work' });
          });
        });

        var pageStart = Date.now();
        document.addEventListener('visibilitychange', function onHide() {
          if (document.visibilityState === 'hidden') {
            track('scroll-depth-final', { depth: maxScroll, page: pathname });
            track('time-on-page', { seconds: Math.round((Date.now() - pageStart) / 1000), page: pathname });
            flushSequence();
          }
        });
        // pagehide covers the cases visibilitychange misses (bfcache, some iOS paths).
        window.addEventListener('pagehide', flushSequence);
      }

      initAnalytics();
    </script>
  </body>
</html>
