---
import PageHeader from './PageHeader.astro';
import FeedList from './FeedList.astro';
import StartHere from './StartHere.astro';
import type { FeedEntry } from '../content/feed';
import type { FeedIndexCopy, WorkStory } from '../content/types';
import type { FeedView } from '../client/feedFilter';

interface Props {
  entries: FeedEntry[];
  copy: FeedIndexCopy;
  defaultType?: FeedView;
  mode?: 'flat' | 'chronological';
  featured?: WorkStory[];
  featuredLabel?: string;
}
const { entries, copy, defaultType = 'all', mode = 'chronological', featured = [], featuredLabel } = Astro.props;
const views = [
  { type: 'all', label: copy.allLabel },
  { type: 'work', label: copy.workLabel },
  { type: 'writing', label: copy.writingLabel },
];
---

<div id="feed-index" data-default-type={defaultType}>
  <PageHeader headline={copy.hero.headlineLines} intro={copy.hero.intro} measure="regular" />
  {
    featured.length > 0 && (
      <div data-start-here>
        <StartHere stories={featured} label={featuredLabel} />
      </div>
    )
  }
  <div class="feed-controls" data-feed-controls hidden role="group" aria-label={copy.typeFilterLabel}>
    {views.map((view) => (
      <button class="chip" type="button" data-feed-view={view.type}
        aria-pressed={view.type === defaultType} aria-controls="feed-list">{view.label}</button>
    ))}
  </div>
  <FeedList entries={entries} copy={copy} id="feed-list" mode={mode} />
  <p class="feed-empty" data-feed-empty hidden={entries.length > 0} role="status">{copy.emptyMessage}</p>
</div>

<style>
  .feed-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    padding-block: var(--spacing-6);
  }
  .feed-empty { color: var(--color-text-secondary); padding-block: var(--spacing-16); text-align: center; }
</style>
