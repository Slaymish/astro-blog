---
import { tagSlug } from '../content/writing';
import { getSiteSettings } from '../content/queries';
import type { WritingEntry } from '../content/types';

interface Props {
  entries: WritingEntry[];
  typeLabel?: string;
  headingLevel?: 'h2' | 'h3';
}

const { entries, typeLabel, headingLevel = 'h2' } = Astro.props;
const Title = headingLevel;
const { entryLabels } = await getSiteSettings();
---

<ul class="writing-list">
  {
    entries.map((entry) => (
      <li class="writing-list__item" data-tags={entry.tags.map(tagSlug).join(' ')}>
        <a href={entry.href}>
          <span class="writing-list__meta">
            <time class="writing-list__date" datetime={entry.publishedAt}>{entry.displayDate}</time>
            {typeLabel && <span class="writing-list__type">{typeLabel}</span>}
            {entry.type === 'report' && <span class="writing-list__type">{entryLabels.reportLabel}</span>}
          </span>
          <div class="writing-list__body">
            <Title class="writing-list__title">{entry.title}</Title>
            {entry.excerpt && <span class="writing-list__excerpt">{entry.excerpt}</span>}
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .writing-list {
    border-top: 1px solid var(--color-stroke-subtle);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .writing-list__item {
    border-bottom: 1px solid var(--color-stroke-subtle);
  }

  .writing-list__item a {
    align-items: baseline;
    color: var(--color-text-primary);
    display: grid;
    gap: var(--spacing-2) var(--spacing-8);
    padding-block: clamp(1.5rem, 3.5vw, 2.5rem);
    text-decoration: none;
  }

  .writing-list__item a:hover .writing-list__title {
    color: var(--color-action);
  }

  .writing-list__meta {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
  }

  .writing-list__date {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
  }

  .writing-list__type {
    border: 1px solid var(--color-stroke-subtle);
    color: var(--color-text-secondary);
    font-size: var(--type-label);
    letter-spacing: 0.08em;
    padding: 0.1rem 0.4rem;
    text-transform: uppercase;
  }

  .writing-list__title {
    display: block;
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    font-weight: var(--font-weight-bold);
    margin: 0;
  }

  .writing-list__excerpt {
    color: var(--color-text-secondary);
    display: block;
    font-size: var(--type-body-small);
    line-height: 1.6;
    margin-top: var(--spacing-2);
    max-width: 54rem;
  }

  @media (min-width: 48rem) {
    .writing-list__item a {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }
</style>
