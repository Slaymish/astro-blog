---
/**
 * Deprecated: kept so older call sites compile. Use <Button href=…> directly;
 * `variant="text"` maps to the ghost variant.
 */
import Button from './Button.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const { href, variant = 'primary', external = false, class: className, ariaLabel } = Astro.props;
---

<Button href={href} variant={variant === 'text' ? 'ghost' : variant} external={external} class={className} ariaLabel={ariaLabel}>
  <slot />
</Button>
