---
/**
 * The one button. Renders an <a> when given `href`, otherwise a <button>, and
 * carries every variant, size and state the primitives stylesheet defines
 * (src/design-system/primitives.css), so a page never styles a control itself.
 *
 *   <Button href="/contact">Get in touch</Button>              primary link, arrow
 *   <Button variant="secondary" href={pdf} external>CV</Button> outlined, up-right arrow
 *   <Button variant="ghost" icon="arrow-left">Back</Button>     text button
 *   <Button variant="icon" ariaLabel="Close"><svg … /></Button> square, icon in the slot
 *   <Button type="submit" loading={busy}>Send</Button>          spinner over the label
 */
import Icon from './Icon.astro';
import IconText from './IconText.astro';
import type { IconName } from './icons';

interface Props {
  /** Render a link instead of a button. */
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'icon';
  size?: 'sm' | 'md' | 'lg';
  /**
   * Arrow beside the label. Links default to `arrow-right` (`arrow-up-right`
   * when external); buttons default to none. Pass `false` to drop it.
   */
  icon?: IconName | false;
  iconPosition?: 'start' | 'end';
  /** Opens in a new tab with the usual rel. */
  external?: boolean;
  /** Buttons only. */
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  /** Shows the spinner and blocks interaction. Keep the label; the width holds. */
  loading?: boolean;
  /** For toggles: sets aria-pressed. */
  pressed?: boolean;
  /** Stretch to the container. */
  block?: boolean;
  class?: string;
  ariaLabel?: string;
  id?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  external = false,
  type = 'button',
  disabled = false,
  loading = false,
  pressed,
  block = false,
  class: className,
  ariaLabel,
  id,
  ...rest
} = Astro.props as Props & Record<string, unknown>;

const isLink = typeof href === 'string';
const resolvedIcon: IconName | false =
  icon !== undefined ? icon : isLink && variant !== 'icon' ? (external ? 'arrow-up-right' : 'arrow-right') : false;

const classes = [
  'btn',
  `btn--${variant}`,
  size !== 'md' && `btn--${size}`,
  block && 'btn--block',
  className
];

const Tag = isLink ? 'a' : 'button';
const attributes = isLink ? {
  href: disabled || loading ? undefined : href,
  role: disabled || loading ? 'link' as const : undefined,
  'aria-disabled': disabled ? 'true' as const : undefined,
  tabindex: disabled ? -1 : undefined,
  target: external ? '_blank' : undefined,
  rel: external ? 'noopener noreferrer' : undefined,
} : { type, disabled: disabled || loading };
---

<Tag
  id={id}
  aria-label={ariaLabel}
  aria-busy={loading ? 'true' : undefined}
  aria-pressed={pressed}
  {...rest}
  {...attributes}
  class:list={classes}
>
  {variant === 'icon' ? (
    resolvedIcon ? <Icon name={resolvedIcon} motion="none" /> : <slot />
  ) : resolvedIcon ? (
    <IconText icon={resolvedIcon} position={iconPosition} class="btn__label"><slot /></IconText>
  ) : (
    <span class="btn__label"><slot /></span>
  )}
</Tag>

<style>
  /* Buttons want more air between label and icon than inline links do. */
  .btn__label { --icon-gap: var(--spacing-3); }
</style>
