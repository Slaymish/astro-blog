---
/**
 * GRID TILE COMPONENT
 *
 * Reusable tile component for the bento grid layout.
 * Supports different sizes and includes hover effects with arrow indicator.
 */

import Icon from './Icon.astro';

interface TileProps {
  title: string;
  description: string;
  href: string;
  size?: 'square' | 'wide';
  tags?: string[];
  date?: string;
  external?: boolean;
  type?: 'post' | 'report' | string;
  typeHref?: string;
  transitionName?: string;
}

const {
  title,
  description,
  href,
  size = 'square',
  tags = [],
  date = '',
  external = false,
  type,
  typeHref,
  transitionName
} = Astro.props as TileProps;

const containerClass =
  size === 'wide'
    ? 'aspect-square px-1 pb-2 sm:col-span-2 sm:aspect-[2/1]'
    : 'aspect-square px-1 pb-2';

const cursorClass = external ? 'cursor-alias' : 'cursor-pointer';

const baseTypeLabel =
  type === 'report' ? 'Report'
  : type === 'post' ? 'Writing'
  : type === 'project' ? 'Projects'
  : type === 'tool' ? 'Tools'
  : type;
const typeLabel = baseTypeLabel ?? 'Project';
const metaParts = [typeLabel, tags[0]].filter(Boolean);
const inferredTypeHref =
  type === 'report' || type === 'post' ? '/writing'
  : type === 'project' || type === 'tool' ? '/work'
  : undefined;
const resolvedTypeHref = typeHref ?? inferredTypeHref;

---

<article class={`grid-tile ${containerClass}`}>
  <div class="group relative h-full w-full overflow-hidden rounded-[var(--tile-radius)] bg-[var(--tile-bg)] transition-all duration-300" data-icon-hover>
    <div class="flex h-full w-full flex-col">

      <!-- Meta row -->
      <div class="flex items-center justify-between pl-4 pr-2 pt-2 text-sm tracking-tight text-[var(--text-muted)]">
        <span class="py-1.5">
          {resolvedTypeHref ? (
            <a
              href={resolvedTypeHref}
              class="rounded transition-colors no-underline border-b-0 hover:underline hover:text-[var(--text-muted)] focus-visible:ring-4 focus-visible:ring-[var(--focus)] focus-visible:text-[var(--text-muted)]"
            >
              {typeLabel}
            </a>
          ) : (
            <span>{typeLabel}</span>
          )}
          {metaParts[1] && (
            <>&nbsp;·&nbsp;{metaParts[1]}</>
          )}
        </span>

        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class={`flex h-8 w-8 items-center justify-center rounded-full transition-colors no-underline border-b-0 focus-visible:ring-4 focus-visible:ring-[var(--focus)] group-focus-within:bg-[var(--text)] group-focus-within:text-[var(--bg)] group-hover:bg-[var(--text)] group-hover:text-[var(--bg)] ${cursorClass}`}
          aria-label={external ? 'Open external link' : 'Open item'}
        >
          <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size="1rem" />
        </a>
      </div>

      <!-- Content -->
      <a
        href={href}
        class={`flex-1 px-5 pb-5 pt-3 no-underline border-b-0 text-inherit hover:text-inherit ${cursorClass}`}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        aria-label={title}
      >
        <h3
          class="font-serif text-4xl font-light tracking-tight text-[var(--text)]"
          transition:name={transitionName}
        >{title}</h3>

        {date && (
          <span class="mt-2 mb-4 block text-sm tracking-tight text-[var(--text-muted)]">{date}</span>
        )}

        {description && (
          <p class="leading-relaxed tracking-tight text-[var(--text-muted)] line-clamp-3 md:line-clamp-4">
            {description}
          </p>
        )}

        {tags && tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2 text-xs">
            {tags.map((tag: string) => (
              <span class="tile-filter-tag rounded px-2 py-0.5 bg-[var(--surface-2)] text-[var(--text-muted)]">{tag}</span>
            ))}
          </div>
        )}
      </a>

    </div>
  </div>
</article>
