---
/**
 * The curated three at the top of the work index, set as a contents list rather
 * than a card grid: a rule per row, a descriptor beneath each title, and titles
 * in display type. The page's own hierarchy (huge heading, hairlines, generous
 * leading) carries the design, so this is a typographic row and not a box.
 *
 * No cover in the row on purpose. Half these stories have a figure cover whose
 * panel is content rather than a picture, so a cover column makes the rows
 * different heights and looks broken; the covers are in the list below anyway.
 */
import type { WorkStory } from '../content/types';

interface Props {
  stories: WorkStory[];
  label?: string;
}

const { stories, label } = Astro.props;
---

{
  stories.length > 0 && (
    <section class="start-here" aria-label={label || 'Start here'}>
      {label && <p class="start-here__label">{label}</p>}
      <ol class="start-here__list">
        {stories.map((story) => {
          const href = `/work/${story.slug}`;
          return (
            <li>
              <a class="start-row" href={href}>
                <span class="start-row__text">
                  <span class="start-row__title">{story.title}</span>
                  <span class="start-row__descriptor">{story.descriptor}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<style>
  .start-here {
    margin-block-end: var(--spacing-12);
    padding-block-start: var(--spacing-6);
  }

  .start-here__label {
    color: var(--color-text-secondary);
    font-size: var(--type-label);
    margin: 0 0 var(--spacing-2);
  }

  .start-here__list {
    border-top: 1px solid var(--color-stroke-subtle);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .start-row {
    border-bottom: 1px solid var(--color-stroke-subtle);
    color: inherit;
    display: block;
    padding-block: var(--spacing-6);
    text-decoration: none;
  }

  .start-row__text {
    display: grid;
    gap: var(--spacing-2);
    min-width: 0;
  }

  .start-row__title {
    font-family: var(--font-heading);
    font-size: var(--type-heading-2);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .start-row__descriptor {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
  }

  .start-row:hover .start-row__title,
  .start-row:focus-visible .start-row__title {
    color: var(--color-action);
  }

  @media (min-width: 48rem) {
    .start-row {
      padding-block: var(--spacing-8);
    }
  }
</style>
