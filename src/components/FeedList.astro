---
import WorkCard from './WorkCard.astro';
import EntryList from './EntryList.astro';
import { groupFeedByYear, type FeedEntry } from '../content/feed';
import { formatFullDate } from '../content/writing';
import type { FeedIndexCopy } from '../content/types';

interface Props { entries: FeedEntry[]; copy: FeedIndexCopy; id?: string }
const { entries, copy, id } = Astro.props;
const groups = groupFeedByYear(entries);
---

<div class="feed-list" id={id}>
  {groups.map(({ year, entries }) => (
    <section class="feed-year" data-feed-year aria-labelledby={`year-${year}`}>
      <h2 class="feed-year__heading" id={`year-${year}`}>{year}</h2>
      <ul class="feed-year__entries">
        {entries.map((entry) => (
          <li class="feed-entry" data-feed-entry data-feed-type={entry.type}
            data-date={entry.publishedAt}>
            {entry.type === 'work' ? (
              <WorkCard story={entry.story} tags={entry.tags} />
            ) : (
              <EntryList entries={[{ ...entry.writing, tags: entry.tags, displayDate: formatFullDate(entry.publishedAt) }]}
                typeLabel={copy.writingLabel} headingLevel="h3" showTags />
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .feed-year { margin-block: var(--spacing-8) var(--spacing-16); }
  .feed-year__heading {
    font-family: var(--font-body);
    font-size: var(--type-heading-2);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin: 0;
    padding-block: var(--spacing-6);
  }
  @media (min-width: 48rem) {
    .feed-year { margin-block-start: var(--spacing-12); }
    .feed-year__heading { padding-block-end: var(--spacing-10); }
  }
  .feed-year__entries { list-style: none; margin: 0; padding: 0; }
  .feed-entry + .feed-entry { margin-top: var(--spacing-6); }
  .feed-entry :global(.work-card),
  .feed-entry :global(.writing-list),
  .feed-entry :global(.writing-list__item) { border: 0; }
</style>
