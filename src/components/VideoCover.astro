---
/**
 * A work story's cover as a silent looping clip. A sibling to WorkCover rather
 * than a third cover.kind, because the clip is chosen by the page and never
 * authored in Studio.
 *
 * Playback is started by src/client/videoTeaser.ts, not by an autoplay
 * attribute, so prefers-reduced-motion can be honoured before the first frame.
 *
 * The still is a real image in the frame, not only the video's poster
 * attribute. A video element that is between loads paints nothing, and a
 * transparent video over the page background reads as a white flash while
 * scrolling; the still underneath is what fills that gap, and the clip paints
 * over it once it has a frame.
 */
import { getImage } from 'astro:assets';

interface Props {
  /** Site-relative path to the mp4. */
  src: string;
  poster: ImageMetadata;
  /** Describes the footage. Carried by the .sr-only span, not an aria-label. */
  alt: string;
  /** The clip's intrinsic size, so the frame is reserved before it loads. */
  width?: number;
  height?: number;
  /** Home page treatment: no border, rounded, and lifted off the page. Mirrors WorkCover. */
  elevated?: boolean;
}

const { src, poster, alt, width = 1280, height = 720, elevated = false } = Astro.props;

const still = await getImage({ src: poster, width, format: 'webp', quality: 80 });
---

<div class:list={['work-cover', 'work-cover--video', elevated && 'is-elevated']}>
  <span class="sr-only">{alt}</span>
  {/* alt="" because the span above carries the description and the clip is
      decoration over it; a second description would repeat. */}
  <img
    class="work-cover__still"
    src={still.src}
    width={width}
    height={height}
    alt=""
    loading="eager"
    decoding="async"
  />
  <video
    data-video-teaser
    poster={still.src}
    width={width}
    height={height}
    muted
    loop
    playsinline
    preload="metadata"
  >
    <source src={src} type="video/mp4" />
  </video>
</div>

<style>
  .work-cover {
    border: 1px solid var(--color-stroke-subtle);
    min-width: 0;
  }

  .work-cover.is-elevated {
    border-color: transparent;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .work-cover--video {
    background-color: var(--color-bg-inset);
    line-height: 0;
    overflow: hidden;
    position: relative;
  }

  .work-cover__still {
    display: block;
    height: auto;
    width: 100%;
  }

  /* The still sets the frame's height, so the clip fills it rather than
     defining it; nothing moves when the video element is between loads. */
  .work-cover--video video {
    display: block;
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }
</style>
