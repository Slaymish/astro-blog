---
// A real button in the markup; initTheme in the client shell binds it. The
// pre-paint script has already resolved the theme, so there is nothing to do
// here but render. The label names the theme the button switches *to*, so
// both labels ride along as data and the script swaps them.
import Icon from './Icon.astro';

interface Props {
  toLightLabel: string;
  toDarkLabel: string;
}

const { toLightLabel, toDarkLabel } = Astro.props;
---

<button
  type="button"
  class="btn btn--icon theme-toggle"
  data-theme-toggle
  data-label-light={toLightLabel}
  data-label-dark={toDarkLabel}
  aria-label={toLightLabel}
>
  <Icon name="sun" motion="none" class="theme-toggle__sun" />
  <Icon name="moon" motion="none" class="theme-toggle__moon" />
</button>

<style>
  /* Show whichever icon represents the theme the button switches *to*. */
  .theme-toggle .theme-toggle__sun {
    display: none;
  }
  .theme-toggle .theme-toggle__moon {
    display: block;
  }
  :global(.dark) .theme-toggle .theme-toggle__sun {
    display: block;
  }
  :global(.dark) .theme-toggle .theme-toggle__moon {
    display: none;
  }
</style>
