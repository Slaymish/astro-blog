---
import { LOGO_PATHS, LOGO_VIEWBOX } from '../site/logo';

interface Props {
  class?: string;
  size?: number;
}

const { class: className, size = 36 } = Astro.props;
---

<svg
  class:list={['hb-logo', className]}
  width={size}
  height={size}
  viewBox={LOGO_VIEWBOX}
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {LOGO_PATHS.map((d) => <path d={d} />)}
</svg>

<style>
  .hb-logo {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hb-logo {
      animation: hb-logo-enter 450ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes hb-logo-enter {
    from {
      opacity: 0;
      transform: scale(0.8) rotate(-4deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }
</style>
