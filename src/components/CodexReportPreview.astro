---
import type { CodexUsageCopy } from '../content/codexUsage';
const { copy } = Astro.props as { copy: CodexUsageCopy };
const c = copy.contribution;
---
<section class="contribution-preview" data-report-preview>
  <h3>{c.generateHeading}</h3>
  <p>{c.generateIntro} <a href="https://github.com/Slaymish/codex-usage-benchmark/tree/main/skills/codex-usage-report">{c.skillLink}</a></p>
  <h3>{c.checkHeading}</h3>
  <p>{c.checkIntro}</p>
  <div class="field">
    <label class="field__label" for="codex-report-file">{c.fileLabel}</label>
    <input class="input" id="codex-report-file" type="file" accept=".json,application/json" data-report-file />
  </div>
  <p data-report-status role="status" aria-live="polite">{copy.messages.noFile}</p>
  <div data-report-results hidden>
    <dl>
      <div><dt>{c.sessions}</dt><dd data-report-sessions></dd></div>
      <div><dt>{c.buckets}</dt><dd data-report-buckets></dd></div>
      <div><dt>{c.input}</dt><dd data-report-input></dd></div>
      <div><dt>{c.output}</dt><dd data-report-output></dd></div>
    </dl>
    <p>{c.privacy}</p>
    <details><summary>{c.details}</summary><pre data-report-json></pre></details>
  </div>
  <h3>{c.shareHeading}</h3>
  <p data-sharing-closed>{c.closed}</p>
  <a class="btn btn--secondary" href="/api/codex/github/start" data-sign-in hidden>{c.signIn}</a>
  <div data-account hidden>
    <p>{c.signedIn} <strong data-login></strong></p>
    <p data-contribution-state role="status" aria-live="polite"></p>
    <label class="choice"><input type="checkbox" data-opt-in /> <span>{c.optIn}</span></label>
    <div data-submit-controls hidden>
      <label class="choice"><input type="checkbox" data-consent /> <span>{c.consent}</span></label>
      <button class="btn btn--primary" type="button" data-submit disabled>{c.submit}</button>
    </div>
    <div class="contribution-preview__actions">
      <button class="btn btn--secondary" type="button" data-attribution hidden>{c.saveAttribution}</button>
      <button class="btn btn--secondary" type="button" data-withdraw hidden>{c.withdraw}</button>
      <button class="btn btn--ghost" type="button" data-logout>{c.logout}</button>
    </div>
  </div>
  <noscript><p>{c.noScript}</p></noscript>
  <!-- Text only, parsed as JSON by the bundled module. No executable inline script. -->
  <div hidden data-contribution-copy>{JSON.stringify(copy)}</div>
</section>
<script>
  import { initContribution } from '../client/codexContribution';
  document.querySelectorAll<HTMLElement>('[data-report-preview]').forEach(initContribution);
</script>
<style>
  .contribution-preview { max-width: 46rem; }
  .contribution-preview dl div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--spacing-3); padding-block: var(--spacing-2); border-bottom: 1px solid var(--color-stroke-subtle); }
  .contribution-preview dd { margin: 0; font-variant-numeric: tabular-nums; }
  .contribution-preview pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 24rem; overflow: auto; font-size: var(--type-body-small); }
  .contribution-preview details { margin-block: var(--spacing-4); }
  .contribution-preview__actions { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin-block: var(--spacing-4); }
</style>
