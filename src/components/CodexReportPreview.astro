---
---
<section class="contribution-preview" data-report-preview>
  <h3>1. Generate your report</h3>
  <p>Use the <a href="https://github.com/Slaymish/codex-usage-benchmark/tree/main/skills/codex-usage-report">Codex usage skill</a> to create a private JSON report on your computer.</p>
  <h3>2. Check your report</h3>
  <p>Select the file below to see what it contains. It stays on your device.</p>
  <label for="codex-report-file">Select your JSON report</label>
  <input id="codex-report-file" type="file" accept=".json,application/json" data-report-file />
  <p data-report-status role="status" aria-live="polite">No file selected.</p>
  <div data-report-results hidden>
    <dl>
      <div><dt>Usable sessions</dt><dd data-report-sessions></dd></div>
      <div><dt>Monthly/model buckets</dt><dd data-report-buckets></dd></div>
      <div><dt>Total input tokens</dt><dd data-report-input></dd></div>
      <div><dt>Total output tokens</dt><dd data-report-output></dd></div>
    </dl>
    <p>Token counts are not subscription limits or coding hours. Aggregates may still identify you.</p>
    <details><summary>See exactly what would be shared</summary><pre data-report-json></pre></details>
    <h3>3. Share, if you want to</h3>
    <p>Submissions aren't open yet. You can keep this report and come back later. GitHub attribution will be optional.</p>
  </div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-report-preview]');
  const fileInput = root?.querySelector<HTMLInputElement>('[data-report-file]');
  const status = root?.querySelector<HTMLElement>('[data-report-status]');
  const results = root?.querySelector<HTMLElement>('[data-report-results]');
  const fmt = new Intl.NumberFormat('en-NZ');
  function fail(message: string): void {
    if (status) status.textContent = message;
    if (results) results.hidden = true;
  }
  function integer(value: unknown): value is number {
    return Number.isSafeInteger(value) && typeof value === 'number' && value >= 0;
  }
  function exactKeys(value: unknown, keys: string[]): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null && !Array.isArray(value)
      && Object.keys(value).length === keys.length && keys.every(key => Object.hasOwn(value, key));
  }
  function parseReport(value: unknown) {
    const rootKeys = ['schemaVersion', 'collectorVersion', 'dataType', 'privacy', 'summary', 'buckets'];
    const summaryKeys = ['filesInspected', 'usableSessions', 'snapshotsFound', 'skippedFiles'];
    const bucketKeys = ['month', 'model', 'sessions', 'input_tokens', 'cached_input_tokens', 'output_tokens', 'reasoning_output_tokens', 'total_tokens'];
    if (!exactKeys(value, rootKeys) || value.schemaVersion !== 1 ||
      typeof value.collectorVersion !== 'string' || !/^\d+\.\d+\.\d+$/.test(value.collectorVersion) ||
      value.dataType !== 'aggregate_token_usage' || value.privacy !== 'monthly-model-aggregates' ||
      !exactKeys(value.summary, summaryKeys) || !summaryKeys.every(key => integer((value.summary as Record<string, unknown>)[key])) ||
      !Array.isArray(value.buckets) || value.buckets.length < 1 || value.buckets.length > 240)
      throw new Error('Not a supported v1 aggregate usage report.');
    // Runtime validation above establishes the numeric summary shape.
    const summary = value.summary as Record<string, number>;
    let sessions = 0, input = 0, output = 0;
    const seen = new Set<string>();
    for (const bucket of value.buckets) {
      if (!exactKeys(bucket, bucketKeys) || typeof bucket.month !== 'string' ||
        !/^\d{4}-(0[1-9]|1[0-2])$/.test(bucket.month) ||
        typeof bucket.model !== 'string' || !/^[A-Za-z0-9._-]{1,80}$/.test(bucket.model) ||
        !bucketKeys.slice(2).every(key => integer(bucket[key])) ||
        !integer(bucket.sessions) || bucket.sessions === 0 ||
        !integer(bucket.cached_input_tokens) || !integer(bucket.input_tokens) ||
        !integer(bucket.reasoning_output_tokens) || !integer(bucket.output_tokens) ||
        !integer(bucket.total_tokens))
        throw new Error('The report contains invalid aggregate values.');
      // Narrow the validated unknown JSON values before arithmetic.
      const numericBucket = bucket as Record<string, string | number>;
      const n = (key: string): number => numericBucket[key] as number;
      if (n('cached_input_tokens') > n('input_tokens') ||
        n('reasoning_output_tokens') > n('output_tokens') ||
        (n('total_tokens') > 0 && n('total_tokens') < n('input_tokens') + n('output_tokens')))
        throw new Error('The report contains inconsistent token totals.');
      const key = bucket.month + ':' + bucket.model;
      if (seen.has(key)) throw new Error('Duplicate month/model bucket.');
      seen.add(key);
      sessions += n('sessions');
      input += n('input_tokens');
      output += n('output_tokens');
    }
    if (sessions !== summary.usableSessions || summary.filesInspected < sessions ||
      summary.skippedFiles > summary.filesInspected) throw new Error('Report summary does not match its buckets.');
    return { sessions, input, output, buckets: value.buckets.length };
  }
  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) { fail('No file selected.'); return; }
    if (file.size > 256000) { fail('File exceeds the 256 KB limit.'); return; }
    try {
      const raw = await file.text();
      const report = JSON.parse(raw);
      const totals = parseReport(report);
      const set = (selector: string, value: string) => {
        const node = root?.querySelector<HTMLElement>(selector);
        if (node) node.textContent = value;
      };
      set('[data-report-sessions]', fmt.format(totals.sessions));
      set('[data-report-buckets]', fmt.format(totals.buckets));
      set('[data-report-input]', fmt.format(totals.input));
      set('[data-report-output]', fmt.format(totals.output));
      set('[data-report-json]', JSON.stringify(report, null, 2));
      if (results) results.hidden = false;
      if (status) status.textContent = 'Valid report loaded locally. No data has been sent.';
    } catch (error) {
      fail(error instanceof Error ? error.message : 'Unable to read this report.');
    }
  });
</script>
<style>
  .contribution-preview { max-width: 46rem; }
  .contribution-preview label { display: block; margin-block: 1rem .5rem; font-weight: 600; }
  .contribution-preview input { max-width: 100%; }
  .contribution-preview dl div { display: flex; justify-content: space-between; gap: 1rem; padding-block: .5rem; border-bottom: 1px solid var(--color-stroke-subtle); }
  .contribution-preview dd { margin: 0; font-variant-numeric: tabular-nums; }
  .contribution-preview pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 24rem; overflow: auto; font-size: .75rem; }
  .contribution-preview details { margin-block: 1rem; }
</style>
