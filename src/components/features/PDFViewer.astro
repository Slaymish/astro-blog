---
interface Props {
  pdfPath: string;
  title: string;
}

const { pdfPath, title } = Astro.props;
const proxiedPdfPath = pdfPath?.startsWith('http')
  ? `/api/pdf?url=${encodeURIComponent(pdfPath)}`
  : pdfPath;
interface ToolbarControl { id?: string; title: string; label: string; icon: string; download?: boolean }
const toolbar: Array<{ name: string; controls: ToolbarControl[] }> = [
  { name: 'left', controls: [
    {"id": "prev-page", "title": "Previous page (←)", "label": "Previous page", "icon": "<polyline points=\"15 18 9 12 15 6\"></polyline>"},
    {"id": "next-page", "title": "Next page (→)", "label": "Next page", "icon": "<polyline points=\"9 18 15 12 9 6\"></polyline>"},
  ] },
  { name: 'center', controls: [
    {"id": "zoom-out", "title": "Zoom out", "label": "Zoom out", "icon": "<circle cx=\"11\" cy=\"11\" r=\"8\"></circle> <line x1=\"8\" y1=\"11\" x2=\"14\" y2=\"11\"></line> <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>"},
    {"id": "zoom-in", "title": "Zoom in", "label": "Zoom in", "icon": "<circle cx=\"11\" cy=\"11\" r=\"8\"></circle> <line x1=\"11\" y1=\"8\" x2=\"11\" y2=\"14\"></line> <line x1=\"8\" y1=\"11\" x2=\"14\" y2=\"11\"></line> <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>"},
    {"id": "zoom-reset", "title": "Reset zoom", "label": "Reset zoom", "icon": "<path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"></path> <path d=\"M21 3v5h-5\"></path> <path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"></path> <path d=\"M3 21v-5h5\"></path>"},
  ] },
  { name: 'right', controls: [
    {"id": "fullscreen-btn", "title": "Fullscreen", "label": "Toggle fullscreen", "icon": "<path d=\"M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3\"></path>"},
    {"title": "Download PDF", "label": "Download PDF", "icon": "<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path> <polyline points=\"7 10 12 15 17 10\"></polyline> <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"></line>", "download": true},
  ] },
];

---

<div class="pdf-viewer-wrapper">
  <div class="pdf-toolbar">
    {toolbar.map(group => <div class={`toolbar-${group.name}`}>
      {group.controls.map((control, index) => {
        const Tag = control.download ? 'a' : 'button';
        return <>
          <Tag id={control.id} href={control.download ? proxiedPdfPath : undefined}
            download={control.download} class="btn btn--icon btn--sm toolbar-btn"
            title={control.title} aria-label={control.label}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={control.icon} />
          </Tag>
          {index === 0 && group.name === 'left' && <div class="page-info">
            <span id="page-num">1</span><span>/</span><span id="page-count">--</span>
          </div>}
          {index === 0 && group.name === 'center' && <span id="zoom-level" class="zoom-display">100%</span>}
        </>;
      })}
    </div>)}
  </div>

  <!-- PDF Canvas Container -->
  <div class="pdf-container">
    <div id="pdf-loading" class="pdf-loading">
      <div class="spinner"></div>
      <p>Loading PDF...</p>
    </div>
    
    <div id="pdf-error" class="pdf-error" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <p>Failed to load PDF</p>
      <a href={proxiedPdfPath} download class="btn btn--primary">
        Download PDF instead
      </a>
    </div>
    
    <canvas id="pdf-canvas" aria-label={title}></canvas>
  </div>
</div>

<!-- Blocking scripts preserve PDF.js-before-viewer ordering, including on Cloudflare. -->
<script src="/vendor/pdfjs/3.11.174/pdf.min.js" is:inline data-cfasync="false"></script>
<script is:inline data-cfasync="false" define:vars={{ pdfPath: proxiedPdfPath }}>
  (() => {
    const get = id => document.getElementById(id);
    const canvas = get('pdf-canvas');
    const loading = get('pdf-loading');
    const error = get('pdf-error');
    const wrapper = document.querySelector('.pdf-viewer-wrapper');
    const container = wrapper.querySelector('.pdf-container');
    const showError = reason => {
      console.error('PDF viewer:', reason);
      loading.style.display = 'none';
      error.style.display = 'flex';
    };
    const pdfjs = window.pdfjsLib;
    if (!pdfjs) return showError('PDF.js runtime did not load');
    pdfjs.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/3.11.174/pdf.worker.min.js';

    let pdfDoc;
    let pageNum = 1;
    let scale = 1;
    let rendering = false;
    let pending = false;

    // One canvas render at a time. Changes during a render coalesce into the
    // latest requested page/zoom, then the loop paints that state next.
    async function renderPage() {
      pending = true;
      if (rendering || !pdfDoc) return;
      rendering = true;
      try {
        while (pending) {
          pending = false;
          const num = pageNum;
          const requestedScale = scale;
          const page = await pdfDoc.getPage(num);
          const fit = (container.clientWidth - 32) / page.getViewport({ scale: 1 }).width;
          const viewport = page.getViewport({ scale: Math.min(requestedScale, fit * 1.5) });
          canvas.height = viewport.height;
          canvas.width = viewport.width;
          get('page-num').textContent = num;
          await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
          loading.style.display = 'none';
          error.style.display = 'none';
          canvas.style.display = 'block';
        }
      } catch (reason) {
        showError(reason);
      } finally {
        rendering = false;
      }
    }

    function navigate(delta) {
      if (!pdfDoc) return;
      const next = Math.max(1, Math.min(pdfDoc.numPages, pageNum + delta));
      if (next === pageNum) return;
      pageNum = next;
      renderPage();
    }

    function zoom(value) {
      scale = Math.max(0.5, Math.min(3, value));
      get('zoom-level').textContent = Math.round(scale * 100) + '%';
      renderPage();
    }

    const actions = {
      'prev-page': () => navigate(-1),
      'next-page': () => navigate(1),
      'zoom-in': () => zoom(scale + 0.25),
      'zoom-out': () => zoom(scale - 0.25),
      'zoom-reset': () => zoom(1),
      'fullscreen-btn': () => (document.fullscreenElement
        ? document.exitFullscreen()
        : wrapper.requestFullscreen()).catch(reason => console.error('PDF fullscreen:', reason)),
    };
    for (const [id, action] of Object.entries(actions)) get(id).addEventListener('click', action);

    const shortcuts = { ArrowLeft: 'prev-page', ArrowRight: 'next-page', '+': 'zoom-in', '=': 'zoom-in', '-': 'zoom-out', '0': 'zoom-reset' };
    document.addEventListener('keydown', event => {
      if (event.target.closest('input, textarea, select, [contenteditable]')) return;
      const action = actions[shortcuts[event.key]];
      if (action) { event.preventDefault(); action(); }
    });

    pdfjs.getDocument(pdfPath).promise.then(pdf => {
      pdfDoc = pdf;
      get('page-count').textContent = pdf.numPages;
      renderPage();
    }).catch(showError);

    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(renderPage, 250);
    });
  })();
</script>
<style>
  .pdf-viewer-wrapper {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }

  .pdf-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .toolbar-left,
  .toolbar-center,
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .page-info {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    background: var(--surface);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--text-muted);
    font-family: ui-monospace, monospace;
  }

  .zoom-display {
    min-width: 3.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-family: ui-monospace, monospace;
  }

  .pdf-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 600px;
    max-height: 80vh;
    overflow: auto;
    padding: 1rem;
    background: var(--surface-2);
  }

  #pdf-canvas {
    display: none;
    max-width: 100%;
    height: auto;
    box-shadow: var(--shadow-md);
  }

  .pdf-loading,
  .pdf-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--text-muted);
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .pdf-error svg {
    color: #ef4444;
  }

  /* Fullscreen styles — match the inline container rather than forcing black,
     which was jarring against a light theme. */
  .pdf-viewer-wrapper:fullscreen {
    background: var(--bg);
  }

  .pdf-viewer-wrapper:fullscreen .pdf-container {
    max-height: calc(100vh - 60px);
    background: var(--surface-2);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .pdf-toolbar {
      padding: 0.5rem;
      gap: 0.5rem;
    }

    .toolbar-left,
    .toolbar-center,
    .toolbar-right {
      gap: 0.25rem;
    }

    .page-info,
    .zoom-display {
      font-size: 0.75rem;
    }

    .pdf-container {
      min-height: 400px;
      padding: 0.5rem;
    }

    /* Stack toolbar on very small screens */
    @media (max-width: 480px) {
      .pdf-toolbar {
        flex-direction: column;
      }

      .toolbar-left,
      .toolbar-center,
      .toolbar-right {
        width: 100%;
        justify-content: center;
      }
    }
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation: none;
      border-top-color: var(--border);
    }
  }
</style>
