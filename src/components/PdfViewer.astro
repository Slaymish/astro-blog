---
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { NEW_TAB_NOTE_ID } from '../site/config';
import { getSiteSettings } from '../content/queries';

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const { pdfViewer: copy, entryLabels } = await getSiteSettings();

interface Control {
  name: string;
  label: string;
  /** The keyboard shortcut, appended to the tooltip. */
  key?: string;
  icon: IconName;
}

const controls: Control[] = [
  { name: 'prev-page', label: copy.previousPage, key: '←', icon: 'chevron-left' },
  { name: 'next-page', label: copy.nextPage, key: '→', icon: 'chevron-right' },
];

const zoomControls: Control[] = [
  { name: 'zoom-out', label: copy.zoomOut, icon: 'zoom-out' },
  { name: 'zoom-in', label: copy.zoomIn, icon: 'zoom-in' },
  { name: 'zoom-reset', label: copy.resetZoom, icon: 'zoom-reset' },
];

const hint = (control: Control) => (control.key ? `${control.label} (${control.key})` : control.label);
---

<div class="pdf-viewer" data-pdf-viewer data-pdf-url={url}>
  <div class="pdf-viewer__toolbar">
    <div class="pdf-viewer__group">
      {
        controls.map((control) => (
          <button
            type="button"
            class="btn btn--icon btn--sm"
            data-pdf={control.name}
            title={hint(control)}
            aria-label={control.label}
          >
            <Icon name={control.icon} motion="none" />
          </button>
        ))
      }
      <p class="pdf-viewer__pages" aria-live="polite" aria-atomic="true">
        <span data-pdf="page-num">1</span><span>/</span><span data-pdf="page-count">--</span>
      </p>
    </div>

    <div class="pdf-viewer__group">
      {
        zoomControls.map((control) => (
          <button
            type="button"
            class="btn btn--icon btn--sm"
            data-pdf={control.name}
            title={hint(control)}
            aria-label={control.label}
          >
            <Icon name={control.icon} motion="none" />
          </button>
        ))
      }
      <span class="pdf-viewer__zoom" data-pdf="zoom-level">100%</span>
    </div>

    <div class="pdf-viewer__group">
      <button type="button" class="btn btn--icon btn--sm" data-pdf="fullscreen" title={copy.fullscreen} aria-label={copy.fullscreen}>
        <Icon name="fullscreen" motion="none" />
      </button>
      <a class="btn btn--icon btn--sm" href={url} target="_blank" aria-describedby={NEW_TAB_NOTE_ID} rel="noopener noreferrer" title={entryLabels.openPdfLabel} aria-label={entryLabels.openPdfLabel}>
        <Icon name="arrow-up-right" motion="none" />
      </a>
    </div>
  </div>

  <div class="pdf-viewer__container" data-pdf="container" role="region" aria-label={title} tabindex="0">
    <div class="pdf-viewer__state" data-pdf="loading">
      <p>{copy.loading}</p>
    </div>

    <div class="pdf-viewer__state" data-pdf="error" hidden>
      <p>{copy.error}</p>
      <a class="btn btn--primary btn--sm" href={url} target="_blank" aria-describedby={NEW_TAB_NOTE_ID} rel="noopener noreferrer">{copy.openDirectly}</a>
    </div>

    <canvas class="pdf-viewer__canvas" data-pdf="canvas" aria-label={title} hidden></canvas>
  </div>
</div>

<script>
  import { initPdfViewer } from '../client/pdfViewer';

  document.querySelectorAll<HTMLElement>('[data-pdf-viewer]').forEach((root) => {
    void initPdfViewer(root);
  });
</script>

<style>
  .pdf-viewer {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-stroke-subtle);
    border-radius: var(--radius-sm);
    margin-top: var(--spacing-8);
    overflow: hidden;
  }

  .pdf-viewer__toolbar {
    align-items: center;
    background: var(--color-bg-canvas);
    border-bottom: 1px solid var(--color-stroke-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    justify-content: space-between;
    padding: var(--spacing-3) var(--spacing-4);
  }

  .pdf-viewer__group {
    align-items: center;
    display: flex;
    gap: var(--spacing-2);
  }

  .pdf-viewer__pages,
  .pdf-viewer__zoom {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    margin: 0;
  }

  .pdf-viewer__pages {
    display: flex;
    gap: var(--spacing-1);
  }

  .pdf-viewer__container {
    max-height: max(24rem, 75vh);
    min-height: 24rem;
    overflow: auto;
    padding: var(--spacing-4);
    position: relative;
  }

  .pdf-viewer__state {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    justify-content: center;
    padding-block: var(--spacing-16);
  }

  .pdf-viewer__state p {
    color: var(--color-text-secondary);
    font-size: var(--type-body-small);
    margin: 0;
  }

  .pdf-viewer__canvas {
    border-radius: 0;
    display: block;
    height: auto;
    margin-inline: auto;
  }

  .pdf-viewer:fullscreen {
    background: var(--color-bg-canvas);
    display: flex;
    flex-direction: column;
  }

  .pdf-viewer:fullscreen .pdf-viewer__container {
    flex: 1;
    max-height: none;
    min-height: 0;
  }
</style>
